[{"q": "The Traffic Book is maintained at the:", "options": {"A": "Station booking office", "B": "Traffic Accounts Office", "C": "Divisional cash office", "D": "Railway Board"}, "answer": "B", "i": "qgidpn67rl"}, {"q": "Postings in the Traffic Book are made from:", "options": {"A": "Cash remittance memos only", "B": "Ticket stock registers", "C": "Audit inspection notes", "D": "Station periodical returns"}, "answer": "D", "i": "qcroztkcmxr"}, {"q": "The Traffic Book is written up:", "options": {"A": "Daily", "B": "Weekly", "C": "Yearly", "D": "Monthly"}, "answer": "D", "i": "q10v39fl3pne"}, {"q": "In the Traffic Book, earnings are broadly classified as:", "options": {"A": "Plan and non-plan", "B": "Capital and revenue", "C": "Cash and credit", "D": "Coaching and goods"}, "answer": "D", "i": "q1z6qibwt36q"}, {"q": "The main purpose of the Traffic Book is to:", "options": {"A": "Provide a consolidated account of traffic earnings", "B": "Record cash received daily", "C": "Control ticket stock", "D": "Track staff attendance"}, "answer": "A", "i": "q21jc8ddn35k"}, {"q": "Traffic Book figures are exhibited:", "options": {"A": "Only railway-wise", "B": "Train-wise", "C": "Wagon-wise", "D": "Division-wise with railway totals"}, "answer": "D", "i": "q14zsdzr4ihf"}, {"q": "Before posting, station returns received at the Traffic Accounts Office are:", "options": {"A": "Filed without check", "B": "Checked for completeness and accuracy", "C": "Sent back to stations", "D": "Destroyed after a week"}, "answer": "B", "i": "qpm4aky9t5a"}, {"q": "An error noticed after posting in the Traffic Book is corrected by:", "options": {"A": "A dated correcting entry", "B": "Erasing the entry", "C": "Rewriting the page", "D": "Ignoring it"}, "answer": "A", "i": "q1soku3li6q1"}, {"q": "The Traffic Book forms the basis for:", "options": {"A": "Staff salary bills", "B": "Monthly compilation of traffic earnings", "C": "Stores purchases", "D": "Works estimates"}, "answer": "B", "i": "qnn3c2nd36i"}, {"q": "Besides gross earnings, the Traffic Book distinguishes:", "options": {"A": "Only staff numbers", "B": "Refunds, adjustments and outstanding", "C": "Only wagon counts", "D": "Nothing else"}, "answer": "B", "i": "q1qjyv9lep74"}, {"q": "Passenger, luggage and parcel earnings appear in the Traffic Book under:", "options": {"A": "Goods", "B": "Sundry", "C": "Miscellaneous works", "D": "Coaching"}, "answer": "D", "i": "q1pk82jar53r"}, {"q": "Supervision of Traffic Book maintenance rests with:", "options": {"A": "The Traffic Accounts Office", "B": "Station masters", "C": "Commercial inspectors", "D": "The audit office"}, "answer": "A", "i": "q1rho69xhjyn"}, {"q": "The Traffic Book is treated as a:", "options": {"A": "Rough memorandum", "B": "Temporary worksheet", "C": "Personal diary", "D": "Permanent record of traffic earnings"}, "answer": "D", "i": "q7jx5wdurug"}, {"q": "Earnings from demurrage and wharfage are posted under:", "options": {"A": "Goods", "B": "Coaching", "C": "Passenger", "D": "Parcel"}, "answer": "A", "i": "q16pdyi663o4"}, {"q": "Totals of the Traffic Book must agree with:", "options": {"A": "Station balance sheets in aggregate", "B": "Ticket printing orders", "C": "Train time tables", "D": "Staff muster rolls"}, "answer": "A", "i": "qxvgupfaf4t"}, {"q": "The Traffic Book differs from a cash book because it records:", "options": {"A": "Cash in hand", "B": "Earnings compiled from returns, not cash receipts", "C": "Cheques issued", "D": "Imprest balances"}, "answer": "B", "i": "q23gfmrxnn7v"}, {"q": "Station returns serve as _______ for Traffic Book postings:", "options": {"A": "Rough notes", "B": "Optional references", "C": "Audit objections", "D": "Primary vouchers"}, "answer": "D", "i": "q1666cxj4wt"}, {"q": "Outstanding traffic earnings in the Traffic Book are:", "options": {"A": "Carried forward and watched till realised", "B": "Written off at once", "C": "Ignored", "D": "Transferred to stores"}, "answer": "A", "i": "qzt4rnr0xn9"}, {"q": "The Traffic Book is closed:", "options": {"A": "Only at year-end", "B": "Every week", "C": "Never", "D": "At the end of each month"}, "answer": "D", "i": "q21vslefhcl0"}, {"q": "Traffic Book pages are kept:", "options": {"A": "In bound volumes with consecutive pages", "B": "Loose and unnumbered", "C": "As single slips", "D": "In personal custody of clerks"}, "answer": "A", "i": "q1f1818bgiaz"}, {"q": "Review of the Traffic Book by the accounts office ensures:", "options": {"A": "Trains run on time", "B": "Tickets are printed", "C": "Staff are posted", "D": "All earnings are completely brought to account"}, "answer": "D", "i": "q43gibg2p8c"}, {"q": "Earnings from 'to-pay' goods traffic appear in the Traffic Book:", "options": {"A": "Only after realisation", "B": "Never", "C": "Under coaching", "D": "When invoiced, as outstanding until realised"}, "answer": "D", "i": "q1kh7fm5tuur"}, {"q": "Interchange earnings with other railways are:", "options": {"A": "Recorded through adjustments in traffic accounts", "B": "Excluded", "C": "Paid in cash daily", "D": "Written off"}, "answer": "A", "i": "q9nj7p1sldn"}, {"q": "The Traffic Book supports preparation of:", "options": {"A": "Loco maintenance schedules", "B": "Traffic earnings statistics", "C": "Signal plans", "D": "Catering menus"}, "answer": "B", "i": "q1s5lkuqmdg4"}, {"q": "Posting to the Traffic Book is done:", "options": {"A": "After returns are checked and accepted", "B": "Before checking returns", "C": "Directly from trains", "D": "Once a year"}, "answer": "A", "i": "q1f2ntwfzlq8"}, {"q": "Stations render returns of earnings to the accounts office:", "options": {"A": "Once a year", "B": "Only on demand", "C": "Never", "D": "Periodically"}, "answer": "D", "i": "q19lbo29uw01"}, {"q": "The Station Balance Sheet shows:", "options": {"A": "Only tickets sold", "B": "Earnings, remittances and the outstanding balance", "C": "Staff strength", "D": "Wagon positions"}, "answer": "B", "i": "q2bcyh7tgh6e"}, {"q": "The Station Balance Sheet is prepared:", "options": {"A": "Daily", "B": "Quarterly", "C": "Yearly", "D": "Monthly"}, "answer": "D", "i": "q1wu4z7mvmrv"}, {"q": "Station returns are rendered separately for:", "options": {"A": "Coaching and goods traffic", "B": "Each train", "C": "Each clerk", "D": "Each platform"}, "answer": "A", "i": "q2bhuht065ay"}, {"q": "Station returns must reach the accounts office:", "options": {"A": "Within the prescribed time after the month closes", "B": "Whenever convenient", "C": "After audit", "D": "Next year"}, "answer": "A", "i": "q9to53kg5mt"}, {"q": "Responsibility for the correctness of station returns lies with:", "options": {"A": "The station master", "B": "The booking clerk's assistant", "C": "The guard", "D": "The porter"}, "answer": "A", "i": "q1nhfn2j8xj6"}, {"q": "Station returns are accompanied by:", "options": {"A": "Nothing", "B": "Personal letters", "C": "Train diagrams", "D": "Supporting vouchers and statements"}, "answer": "D", "i": "qyxmvj454vd"}, {"q": "At the accounts office, station returns are checked against:", "options": {"A": "Time tables", "B": "Guard's journals", "C": "Remittance records of the cash office", "D": "Signal registers"}, "answer": "C", "i": "q2eiljbimmtn"}, {"q": "Differences found in station returns are settled by:", "options": {"A": "Advising the station to adjust", "B": "Ignoring them", "C": "Writing them off", "D": "Keeping them in suspense forever"}, "answer": "A", "i": "qbb0gjw09ca"}, {"q": "Delayed station returns are:", "options": {"A": "Followed up with reminders until received", "B": "Accepted silently", "C": "Rejected", "D": "Destroyed"}, "answer": "A", "i": "q1yexb30d5pm"}, {"q": "Station returns form the basis of:", "options": {"A": "Train working time tables", "B": "Loco links", "C": "Monthly traffic earnings compilation", "D": "Crew rosters"}, "answer": "C", "i": "q1ozrl2k4oqv"}, {"q": "Station returns are preserved as:", "options": {"A": "Waste paper", "B": "Audit vouchers", "C": "Personal files", "D": "Public notices"}, "answer": "B", "i": "qds0a7ll2bq"}, {"q": "Cash remitted by stations is brought to account through:", "options": {"A": "The cash office records", "B": "The traffic book direct", "C": "The station diary", "D": "Verbal advice"}, "answer": "A", "i": "q1escn1hn74d"}, {"q": "Earnings of out-agencies are included in returns through:", "options": {"A": "Separate railway accounts", "B": "Cash in hand", "C": "The serving station's returns", "D": "They are excluded"}, "answer": "C", "i": "q6xegg0cwpw"}, {"q": "Corrections to returns already submitted are made by:", "options": {"A": "Telephone only", "B": "Pencil notes", "C": "Revised returns or adjustment advices", "D": "New books"}, "answer": "C", "i": "q7s0x635ux9"}, {"q": "Late receipt of station returns affects:", "options": {"A": "Timely closing of monthly accounts", "B": "Nothing", "C": "Train punctuality", "D": "Ticket printing"}, "answer": "A", "i": "qrohl4wziud"}, {"q": "Arithmetical check of station returns covers:", "options": {"A": "Handwriting", "B": "Paper quality", "C": "Totals and balances", "D": "Ink colour"}, "answer": "C", "i": "q22jddyvcugo"}, {"q": "Outstanding balances shown in station returns are:", "options": {"A": "Watched till cleared", "B": "Written off", "C": "Ignored", "D": "Doubled"}, "answer": "A", "i": "qjl09qohwyh"}, {"q": "Aggregate of station balance sheets should agree with:", "options": {"A": "Budget estimates", "B": "Census figures", "C": "Traffic Book totals", "D": "Fuel consumption"}, "answer": "C", "i": "q159pipvb0pm"}, {"q": "Station returns classify earnings as:", "options": {"A": "One lump sum", "B": "By caste", "C": "Coaching, goods and other earnings", "D": "By train colour"}, "answer": "C", "i": "q1nzsg10jp4h"}, {"q": "Short remittance by a station is:", "options": {"A": "Reported for recovery from the station staff", "B": "Ignored", "C": "Paid by audit", "D": "Adjusted in stores"}, "answer": "A", "i": "qsy18i0gtf4"}, {"q": "The periodical returns system ensures:", "options": {"A": "Complete and timely accounting of traffic earnings", "B": "Faster trains", "C": "Cheaper tickets", "D": "More staff"}, "answer": "A", "i": "q23y2t175qm"}, {"q": "Returns from small wayside stations are:", "options": {"A": "Rendered like other stations", "B": "Exempt", "C": "Rendered yearly", "D": "Rendered verbally"}, "answer": "A", "i": "q2hj4kucsn0"}, {"q": "Earnings realised through credit notes appear in returns as:", "options": {"A": "Cash", "B": "Outstanding", "C": "Realised through adjustment", "D": "Not shown"}, "answer": "C", "i": "qkaxqvclopd"}, {"q": "The accounts office reconciles station earnings with:", "options": {"A": "Cash office credits", "B": "Public complaints", "C": "Newspaper reports", "D": "Ticket designs"}, "answer": "A", "i": "q1sv6te1143j"}, {"q": "Coaching earnings comprise:", "options": {"A": "Only freight", "B": "Passenger, luggage and parcel earnings", "C": "Only demurrage", "D": "Only catering"}, "answer": "B", "i": "q14m4g4y2q48"}, {"q": "Coaching returns are compiled from:", "options": {"A": "Ticket issues, parcel way bills and allied documents", "B": "Wagon labels", "C": "Fuel bills", "D": "Salary sheets"}, "answer": "A", "i": "qz9ufstbt5d"}, {"q": "The coaching balance sheet is prepared:", "options": {"A": "Train-wise daily", "B": "Yearly only", "C": "Station-wise monthly", "D": "Never"}, "answer": "C", "i": "qzyod75wedf"}, {"q": "Passenger earnings include earnings from:", "options": {"A": "Freight", "B": "Tickets, excess fares and platform tickets", "C": "Demurrage", "D": "Wharfage"}, "answer": "B", "i": "q2bdvdsqfwu5"}, {"q": "Luggage and parcel earnings are accounted through:", "options": {"A": "Goods invoices", "B": "Parcel way bills", "C": "Salary bills", "D": "Cash memos"}, "answer": "B", "i": "q1i4fzkii0xx"}, {"q": "Season ticket earnings are:", "options": {"A": "Excluded", "B": "Included in coaching earnings", "C": "Goods earnings", "D": "Sundry earnings"}, "answer": "B", "i": "qqy1yh8vo11"}, {"q": "Refunds of passenger fares are:", "options": {"A": "Added to goods earnings", "B": "Ignored", "C": "Deducted from coaching earnings", "D": "Paid from stores"}, "answer": "C", "i": "q274zitsg2jn"}, {"q": "Coaching returns show separately:", "options": {"A": "Each passenger's name", "B": "Each class of coaching traffic", "C": "Each train's speed", "D": "Each coach's colour"}, "answer": "B", "i": "qoj6zj1po51"}, {"q": "Excess fare tickets are accounted in:", "options": {"A": "Goods returns", "B": "Coaching returns", "C": "Works accounts", "D": "Suspense"}, "answer": "B", "i": "q2dz1di1elui"}, {"q": "Unpaid coaching amounts at destination appear as:", "options": {"A": "Written off", "B": "Outstanding in coaching returns", "C": "Goods earnings", "D": "Cash"}, "answer": "B", "i": "q1farmzogt0x"}, {"q": "Coaching earnings are remitted to the cash office:", "options": {"A": "Yearly", "B": "Never", "C": "Daily", "D": "On retirement"}, "answer": "C", "i": "q21nzx54nddz"}, {"q": "Reservation charges form part of:", "options": {"A": "Goods earnings", "B": "Sundry earnings", "C": "Coaching earnings", "D": "Capital"}, "answer": "C", "i": "q24ho9g9d5ub"}, {"q": "Cloak room earnings are classified as:", "options": {"A": "Goods", "B": "Works", "C": "Coaching other earnings", "D": "Stores"}, "answer": "C", "i": "q1ocbz01ja1j"}, {"q": "Coaching returns are checked in the Traffic Accounts Office with:", "options": {"A": "Loco logs", "B": "Ticket and parcel records", "C": "Signal diagrams", "D": "Track charts"}, "answer": "B", "i": "qushnizwgee"}, {"q": "Errors in coaching returns are corrected through:", "options": {"A": "Erasures", "B": "Adjustment advices to the station", "C": "New tickets", "D": "Court orders"}, "answer": "B", "i": "q1lkexikxhnc"}, {"q": "Passenger traffic between stations of the same railway is:", "options": {"A": "Foreign traffic", "B": "Interchange traffic", "C": "Local traffic", "D": "Transhipment"}, "answer": "C", "i": "q10tre606ly7"}, {"q": "Traffic carried over two or more railways involves:", "options": {"A": "No accounting", "B": "Cash settlement only", "C": "Interchange accounting", "D": "Barter"}, "answer": "C", "i": "q2cbjk6flx4w"}, {"q": "Coaching abstracts compiled from station returns show:", "options": {"A": "Train delays", "B": "Division-wise coaching earnings", "C": "Coach maintenance", "D": "Crew duty"}, "answer": "B", "i": "qyq5u3ursf4"}, {"q": "Miscellaneous coaching earnings include:", "options": {"A": "Freight", "B": "Demurrage", "C": "Cloak room and reservation charges", "D": "Wharfage"}, "answer": "C", "i": "q1w0uekgsbu0"}, {"q": "Coaching returns ultimately feed into:", "options": {"A": "The stores ledger", "B": "The Traffic Book", "C": "The works register", "D": "The pension roll"}, "answer": "B", "i": "q75wcp8o3by"}, {"q": "Goods earnings arise mainly from:", "options": {"A": "Freight on goods carried", "B": "Passenger tickets", "C": "Platform tickets", "D": "Cloak rooms"}, "answer": "A", "i": "q3s0fij2tkp"}, {"q": "The basic document for goods traffic is the:", "options": {"A": "Passenger ticket", "B": "Parcel way bill", "C": "Railway receipt with the goods invoice", "D": "Salary slip"}, "answer": "C", "i": "qgw3l3b0dul"}, {"q": "Goods returns are rendered:", "options": {"A": "Wagon-wise daily only", "B": "Station-wise periodically", "C": "Never", "D": "Yearly"}, "answer": "B", "i": "qg44hpk84yj"}, {"q": "The goods balance sheet shows:", "options": {"A": "Passenger counts", "B": "Freight earned, remitted and outstanding", "C": "Coach numbers", "D": "Loco hours"}, "answer": "B", "i": "q2a9ofhsfcyv"}, {"q": "'Paid' freight is:", "options": {"A": "Collected at the destination", "B": "Collected at the forwarding station", "C": "Never collected", "D": "Paid by the railway"}, "answer": "B", "i": "q1x3vg21giop"}, {"q": "'To-pay' freight is:", "options": {"A": "Collected at the forwarding station", "B": "Written off", "C": "Collected at the destination station", "D": "Paid in advance always"}, "answer": "C", "i": "q1qcft9tu3er"}, {"q": "Demurrage is charged for:", "options": {"A": "Late trains", "B": "Dirty coaches", "C": "Lost tickets", "D": "Detention of wagons beyond free time"}, "answer": "D", "i": "qpxkm1bvfte"}, {"q": "Wharfage is charged for:", "options": {"A": "Platform tickets", "B": "Cloak rooms", "C": "Waiting rooms", "D": "Use of goods sheds beyond free time"}, "answer": "D", "i": "qp2cpyx50s8"}, {"q": "Demurrage and wharfage appear in:", "options": {"A": "Coaching returns", "B": "Works accounts", "C": "Pension accounts", "D": "Goods returns"}, "answer": "D", "i": "qfiklt55era"}, {"q": "Siding charges are levied for:", "options": {"A": "Passenger halts", "B": "Foot overbridges", "C": "Retiring rooms", "D": "Use of private sidings"}, "answer": "D", "i": "q1f5do5g5y88"}, {"q": "Goods invoices are prepared in:", "options": {"A": "Single copy", "B": "No copy", "C": "Verbal form", "D": "Multiple foils for stations and accounts"}, "answer": "D", "i": "q2y9f4ebm57"}, {"q": "Unconnected invoices are:", "options": {"A": "Ignored", "B": "Destroyed", "C": "Taken up with the forwarding station", "D": "Paid twice"}, "answer": "C", "i": "q1a22l6zc697"}, {"q": "Undercharges detected in goods returns are:", "options": {"A": "Ignored", "B": "Paid by staff personally always", "C": "Written off", "D": "Recovered through undercharge statements"}, "answer": "D", "i": "q21r8wmxnxv0"}, {"q": "Overcharges claimed by consignors are:", "options": {"A": "Never refunded", "B": "Doubled", "C": "Ignored", "D": "Refunded after verification"}, "answer": "D", "i": "q1eogijnh2ha"}, {"q": "Goods abstracts compiled from station returns show:", "options": {"A": "Passenger numbers", "B": "Train speeds", "C": "Ticket designs", "D": "Division-wise goods earnings"}, "answer": "D", "i": "qxcglucmz22"}, {"q": "Transhipment earnings involve:", "options": {"A": "Passenger transfers", "B": "Staff transfers", "C": "Cash transfers", "D": "Goods transferred between gauges"}, "answer": "D", "i": "q47lswo89be"}, {"q": "Compensation claims paid affect:", "options": {"A": "Coaching only", "B": "Nothing", "C": "Capital", "D": "Net goods earnings"}, "answer": "D", "i": "qzdzu3xk4dw"}, {"q": "Wagon labels support:", "options": {"A": "Passenger tickets", "B": "Salary bills", "C": "Audit notes", "D": "Identification and accounting of loaded wagons"}, "answer": "D", "i": "q10rv8m0axkw"}, {"q": "Goods returns are checked against:", "options": {"A": "Time tables", "B": "Guard vans", "C": "Station gardens", "D": "Invoice foils and delivery records"}, "answer": "D", "i": "q1hnqv7agvfo"}, {"q": "Goods earnings ultimately feed into:", "options": {"A": "The ticket stock register", "B": "The leave account", "C": "The provident fund", "D": "The Traffic Book"}, "answer": "D", "i": "qr5svgnq2wl"}, {"q": "Compilation of traffic earnings is done:", "options": {"A": "Monthly from station returns", "B": "Yearly from memory", "C": "Daily from trains", "D": "Never"}, "answer": "A", "i": "q28l74a55ip1"}, {"q": "Coaching and goods abstracts are compiled:", "options": {"A": "Train-wise", "B": "Clerk-wise", "C": "Division-wise", "D": "Village-wise"}, "answer": "C", "i": "q1vxzseqx4f"}, {"q": "Abstracts are totalled to give:", "options": {"A": "World earnings", "B": "Nothing", "C": "Railway-wise earnings", "D": "Staff numbers"}, "answer": "C", "i": "qzotp4u7r6b"}, {"q": "Interchange earnings are adjusted:", "options": {"A": "In cash daily", "B": "Never", "C": "By barter", "D": "Between railways through accounts"}, "answer": "D", "i": "q17dtwrumtc4"}, {"q": "Compilation separates:", "options": {"A": "Gross earnings, refunds and net earnings", "B": "Nothing", "C": "Only cash", "D": "Only credit"}, "answer": "A", "i": "q1j7cwlwoaox"}, {"q": "Traffic earnings compiled for the month enter:", "options": {"A": "The history books", "B": "The museum", "C": "The monthly accounts of the railway", "D": "The canteen"}, "answer": "C", "i": "qcyo6x995xe"}, {"q": "The compilation is checked with:", "options": {"A": "Newspaper reports", "B": "Rumours", "C": "Traffic Book totals", "D": "Dreams"}, "answer": "C", "i": "q12mqsleqra5"}, {"q": "Outstanding earnings are shown:", "options": {"A": "Mixed with cash", "B": "Hidden", "C": "Separately in compilation", "D": "Doubled"}, "answer": "C", "i": "q1hay70i3axo"}, {"q": "Adjustments relating to prior months appear as:", "options": {"A": "Erasures", "B": "Ignored items", "C": "New railways", "D": "Plus or minus adjustments in the current compilation"}, "answer": "D", "i": "qtipv5kpdw1"}, {"q": "Compilation of earnings supports:", "options": {"A": "Train driving", "B": "Ticket printing", "C": "Catering", "D": "Budget and statistical reporting"}, "answer": "D", "i": "q1burc4zn4rc"}]