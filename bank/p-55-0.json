[{"q":"Railway Budget is an instrument of ___________ and _________","options":{"A":"Financial control and management tool","B":"Control over expenditure and management tool","C":"Parliamentary financial control and auditing tool","D":"Parliamentary financial control and management tool"},"answer":"B"},{"q":"Appropriation account presented to parliament through _________","options":{"A":"RCC","B":"Estimates committee","C":"C&AG","D":"None of the above"},"answer":"D"},{"q":"Appropriation accounts are signed by _________ and ________","options":{"A":"Minister for railways and CRB","B":"CRB and Member/Finance","C":"CRB and C&AG","D":"Member/Finance and C&AG"},"answer":"D"},{"q":"F-403 \"O\" Stands for _________","options":{"A":"Original grant/Appropriation","B":"Opening grant/Appropriation","C":"Over grant/Appropriation","D":"None of the above"},"answer":"B"},{"q":"F-403 \"S\" Stands for _________","options":{"A":"Supporting grant/Appropriation","B":"Supplementary grant/Appropriation","C":"Surrender grant/Appropriation","D":"Summary of grant/Appropriation"},"answer":"C"},{"q":"F-403 \"R' Stands for ________","options":{"A":"Revenue Modification","B":"Retaining Modification","C":"Residual Modification","D":"Revised Modification"},"answer":"C"},{"q":"Grant 83 (Ministry of Railways) is divided into ____ parts","options":{"A":"2","B":"3","C":"4","D":"5"},"answer":"A"},{"q":"Appropriation Accounts prepared in _________","options":{"A":"in Lakhs of Rupees","B":"in Thousands of Rupees","C":"in Units of Rupees","D":"in Crores of Rupees"},"answer":"B"},{"q":"Total enclosures of Appropriation Accounts are _____","options":{"A":"40","B":"42","C":"44","D":"43"},"answer":"C"},{"q":"Total number of Annexure of Appropriation Accounts are _______","options":{"A":"10","B":"8","C":"12","D":"9"},"answer":"A"},{"q":"Annexure J of Appropriation Accounts represents","options":{"A":"Defects in Budgeting","B":"Important Misclassifications","C":"Unsanctioned Expenditure","D":"Irregular Reappropriations"},"answer":"B"}]