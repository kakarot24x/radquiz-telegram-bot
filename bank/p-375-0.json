[{"q": "Cost control primarily aims at:", "options": {"A": "Eliminating all overheads", "B": "Increasing production at any cost", "C": "Reducing costs below standards", "D": "Keeping costs within established standards"}, "answer": "D", "i": "q1vn60v18yoz"}, {"q": "Cost reduction differs from cost control because it:", "options": {"A": "Is a one-time exercise", "B": "Seeks permanent lowering of the cost standard itself", "C": "Applies only to labour", "D": "Needs no management approval"}, "answer": "B", "i": "q17jyx3jyigo"}, {"q": "Which technique compares actual cost with standard cost?", "options": {"A": "Variance analysis", "B": "Value engineering", "C": "Target costing", "D": "Benchmarking"}, "answer": "A", "i": "q2840098c1o5"}, {"q": "A favourable material price variance means:", "options": {"A": "More material was wasted", "B": "Standard price was revised", "C": "Actual price was below standard price", "D": "Less material was used"}, "answer": "C", "i": "q1sgwwmfu0nb"}, {"q": "Labour efficiency variance is caused by:", "options": {"A": "Difference between actual and standard hours worked", "B": "Change in wage rates", "C": "Overtime premium paid", "D": "Idle time of machines"}, "answer": "A", "i": "q19u5yddhrdf"}, {"q": "Which is an economy measure in workshops?", "options": {"A": "Expanding floor area", "B": "Reducing consumption of consumable stores", "C": "Increasing overtime working", "D": "Hiring more supervisors"}, "answer": "B", "i": "q4ihqhwvjpb"}, {"q": "Benchmarking in cost control means:", "options": {"A": "Measuring floor area", "B": "Counting machines", "C": "Comparing performance with best practices", "D": "Fixing budgets annually"}, "answer": "C", "i": "q1euyjdph9ep"}, {"q": "Target costing starts from:", "options": {"A": "Standard labour rates", "B": "Historical cost data", "C": "Market price minus desired margin", "D": "Estimated production cost"}, "answer": "C", "i": "qks625jlstq"}, {"q": "Productivity in a workshop is best measured as:", "options": {"A": "Output per unit of input", "B": "Total wages paid", "C": "Floor space utilized", "D": "Number of employees"}, "answer": "A", "i": "q1jvtvdlrxce"}, {"q": "Which variance is controllable by the purchase department?", "options": {"A": "Labour efficiency variance", "B": "Overhead volume variance", "C": "Material price variance", "D": "Idle time variance"}, "answer": "C", "i": "q1vkswe2fhbh"}, {"q": "Value engineering in workshops focuses on:", "options": {"A": "Reducing cost without reducing function", "B": "Increasing selling price", "C": "Cutting inspection", "D": "Hiring cheaper labour"}, "answer": "A", "i": "q10redzbs9ww"}, {"q": "An adverse overhead variance suggests:", "options": {"A": "Overheads exceeded the standard", "B": "Labour was fully efficient", "C": "Production was exactly as planned", "D": "Overheads were lower than budgeted"}, "answer": "A", "i": "q1fvh9lfjj4e"}, {"q": "Which is a cost reduction technique rather than control?", "options": {"A": "Work study and method improvement", "B": "Variance reporting", "C": "Budgetary control", "D": "Standard costing"}, "answer": "A", "i": "q1d6frsdm405"}, {"q": "Idle time in workshops should be controlled because it:", "options": {"A": "Improves quality", "B": "Increases direct labour cost", "C": "Inflates on-cost without output", "D": "Reduces material price"}, "answer": "C", "i": "q1bcyrityvla"}, {"q": "The first step in budgetary control is:", "options": {"A": "Revising standards", "B": "Taking corrective action", "C": "Comparing actuals with budget", "D": "Preparing budgets for each cost centre"}, "answer": "D", "i": "qv0ad7hkwr3"}, {"q": "Which ratio indicates labour productivity?", "options": {"A": "Standard hours produced per actual hour worked", "B": "Absenteeism percentage", "C": "Wages per employee", "D": "Overtime per month"}, "answer": "A", "i": "q1f5rs4p9vjg"}, {"q": "Cost control is most effective when applied:", "options": {"A": "After the year ends", "B": "Only during audits", "C": "Once in five years", "D": "Concurrently with operations"}, "answer": "D", "i": "q1i0y112p3cg"}, {"q": "A cost centre in a workshop is:", "options": {"A": "The stores depot only", "B": "A unit where costs are collected and controlled", "C": "The cash office", "D": "A profit-earning division"}, "answer": "B", "i": "q1zlsix5owbi"}, {"q": "Which measure reduces material cost without affecting quality?", "options": {"A": "Skipping inspection", "B": "Buying inferior material", "C": "Reducing safety stock to zero", "D": "Standardization of components"}, "answer": "D", "i": "q2214duwdgrz"}, {"q": "Overhead cost can be controlled mainly by:", "options": {"A": "Budgeting and monitoring indirect expenses", "B": "Increasing material prices", "C": "Cutting production", "D": "Reducing direct wages"}, "answer": "A", "i": "q1speddz419t"}, {"q": "The 'standard hour' concept is used to:", "options": {"A": "Measure output for productivity and costing", "B": "Calculate depreciation", "C": "Schedule leave", "D": "Fix wages"}, "answer": "A", "i": "q1e1nize4qls"}, {"q": "Which is NOT a valid cost reduction avenue?", "options": {"A": "Energy conservation", "B": "Preventive maintenance", "C": "Improved plant layout", "D": "Arbitrary cut in inspection"}, "answer": "D", "i": "q24vkf64dkj7"}, {"q": "Variance analysis is a tool of:", "options": {"A": "Financial accounting", "B": "Cost reduction", "C": "Cost control", "D": "Tax planning"}, "answer": "C", "i": "qw3cjq0fr6d"}, {"q": "A favourable labour rate variance combined with adverse efficiency variance may indicate:", "options": {"A": "Machine breakdown", "B": "Overtime by skilled staff", "C": "Perfect supervision", "D": "Use of cheaper but less skilled labour"}, "answer": "D", "i": "q1bm2con4dtf"}, {"q": "Preventive maintenance helps cost control by:", "options": {"A": "Increasing repair staff", "B": "Increasing spares stock", "C": "Reducing breakdowns and idle time", "D": "Raising depreciation"}, "answer": "C", "i": "qyysqj8gs8o"}, {"q": "Which cost is most directly reduced by better production planning?", "options": {"A": "Material purchase price", "B": "Audit fees", "C": "Depreciation", "D": "Overtime and idle time cost"}, "answer": "D", "i": "qrvy3gtzewu"}, {"q": "Benchmarking partner for a railway workshop should ideally be:", "options": {"A": "A retail shop", "B": "A superior-performing similar workshop", "C": "Its own canteen", "D": "Any government office"}, "answer": "B", "i": "qxso0mj7y4q"}, {"q": "Cost reduction is described as:", "options": {"A": "A one-time budget cut", "B": "A punishment tool", "C": "A continuous improvement process", "D": "An annual ritual"}, "answer": "C", "i": "q1a2dx92yvxn"}, {"q": "Which variance helps judge shop supervision quality?", "options": {"A": "Tax variance", "B": "Material price variance", "C": "Sales volume variance", "D": "Labour efficiency variance"}, "answer": "D", "i": "qpfi92uq9jj"}, {"q": "Energy audit in a workshop primarily targets:", "options": {"A": "Higher voltage supply", "B": "Increase in connected load", "C": "More lighting points", "D": "Reduction of power cost per unit"}, "answer": "D", "i": "q1xt9qvmpe5q"}, {"q": "The main limitation of standard costing is that:", "options": {"A": "It needs no records", "B": "It eliminates all variances", "C": "Standards need regular revision to stay realistic", "D": "It works without budgets"}, "answer": "C", "i": "qrgjoeks5ao"}, {"q": "Which action best controls consumable stores cost?", "options": {"A": "No recording of issues", "B": "Issue against norms per job", "C": "Free issue to all shops", "D": "Bulk issue monthly"}, "answer": "B", "i": "q1b1q835uyoo"}, {"q": "Rework and rejection costs are reduced most effectively by:", "options": {"A": "More inspectors at the end", "B": "Quality control at each stage", "C": "Cheaper material", "D": "Faster working"}, "answer": "B", "i": "q8omrdp7007"}, {"q": "A cost-conscious supervisor primarily monitors:", "options": {"A": "Visitors' register", "B": "Employees' personal matters", "C": "Canteen menu", "D": "Actual vs budgeted shop expenses"}, "answer": "D", "i": "qgu2bt7z158"}, {"q": "Which is an example of economy in workshop administration?", "options": {"A": "New furniture every year", "B": "Daily courier for routine mail", "C": "Hiring more clerks", "D": "Duplex printing and paper reuse"}, "answer": "D", "i": "q22724qbf9oj"}, {"q": "Target costing is most relevant when:", "options": {"A": "Prices are set by competition", "B": "Costs are fully under control", "C": "Monopoly pricing exists", "D": "No market exists"}, "answer": "A", "i": "qhaakbux7gn"}, {"q": "The efficiency of material utilization is measured by:", "options": {"A": "Material price variance", "B": "Purchase quantity", "C": "Material usage variance", "D": "Stores ledger balance"}, "answer": "C", "i": "q1tdhjx25vg"}, {"q": "Which committee typically reviews cost performance in workshops?", "options": {"A": "Canteen committee", "B": "Cultural committee", "C": "Sports committee", "D": "Works committee or cost review meeting"}, "answer": "D", "i": "q1909op7ctg4"}, {"q": "Reducing setup time on machines contributes to:", "options": {"A": "Higher productivity and lower unit cost", "B": "Higher depreciation", "C": "More idle time", "D": "Lower quality"}, "answer": "A", "i": "q1namp5mmpo7"}, {"q": "A consistently adverse variance calls for:", "options": {"A": "Increasing the budget blindly", "B": "Ignoring it as normal", "C": "Investigating and correcting the root cause", "D": "Hiding it in suspense"}, "answer": "C", "i": "qb3ze4uec5o"}, {"q": "Which is a leading indicator of rising workshop costs?", "options": {"A": "Falling absenteeism", "B": "Punctual attendance", "C": "Stable material prices", "D": "Increasing rework and overtime trends"}, "answer": "D", "i": "q2fh5kjr604p"}, {"q": "Multi-skilling of workers helps cost control by:", "options": {"A": "Reducing idle time during uneven workloads", "B": "Eliminating training", "C": "Reducing supervision needs to zero", "D": "Increasing wage bills"}, "answer": "A", "i": "qkcidvu3w2o"}, {"q": "The break-even concept helps a workshop decide:", "options": {"A": "Minimum output to cover fixed costs", "B": "Leave schedules", "C": "Best supplier", "D": "Maximum staff strength"}, "answer": "A", "i": "qy59qsucf1o"}, {"q": "Which cost should NOT be cut in a cost reduction drive?", "options": {"A": "Wasteful consumables", "B": "Safety-related expenditure", "C": "Avoidable rework", "D": "Excessive overtime"}, "answer": "B", "i": "q22kirecnmq2"}, {"q": "Standard material price is fixed considering:", "options": {"A": "Supplier's quoted maximum", "B": "Expected purchase price plus normal handling charges", "C": "Current spot price only", "D": "The lowest ever paid"}, "answer": "B", "i": "q2a6mawnryfi"}, {"q": "Cost control reports should be:", "options": {"A": "Annual and voluminous", "B": "Timely, exception-based and responsibility-linked", "C": "Verbal only", "D": "Prepared after two years"}, "answer": "B", "i": "q1884w4zpux2"}, {"q": "Which productivity measure suits a POH shop?", "options": {"A": "Rupees of salary paid", "B": "Number of meetings held", "C": "Litres of paint used", "D": "Coaches turned out per man-day"}, "answer": "D", "i": "q1tkv4u7lze2"}, {"q": "Zero-based budgeting helps cost control because:", "options": {"A": "Every expense must be justified afresh", "B": "It adds 10% automatically", "C": "It copies last year's budget", "D": "It needs no review"}, "answer": "A", "i": "q1ngitdifonc"}, {"q": "The ultimate test of cost reduction is:", "options": {"A": "Sustained lower cost per unit without quality loss", "B": "Fewer employees", "C": "Smaller budget document", "D": "Lower total spend in one month"}, "answer": "A", "i": "q2c2cvtq5tt3"}, {"q": "Cost audit of a workshop primarily verifies:", "options": {"A": "Passenger complaints", "B": "Cash in hand", "C": "Ticket sales", "D": "Accuracy of cost records and pricing"}, "answer": "D", "i": "q1wbyrcm6w2j"}]