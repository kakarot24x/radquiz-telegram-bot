[{"q": "JCM stands for:", "options": {"A": "Judicial Council for Mediation", "B": "Joint Commercial Mission", "C": "Joint Consultative Machinery", "D": "Joint Committee on Management"}, "answer": "C", "i": "q1zvudjl5ixg"}, {"q": "The Joint Consultative Machinery scheme was introduced in:", "options": {"A": "1991", "B": "1951", "C": "1966", "D": "1977"}, "answer": "C", "i": "q1tk6z7675uq"}, {"q": "JCM applies to:", "options": {"A": "Central Government employees", "B": "State police", "C": "Bank staff", "D": "Private sector"}, "answer": "A", "i": "q28ifv4na3cd"}, {"q": "How many tiers does the JCM have?", "options": {"A": "Three", "B": "Five", "C": "One", "D": "Two"}, "answer": "A", "i": "q1hd2zsng7fk"}, {"q": "The apex tier of JCM is the:", "options": {"A": "Divisional Council", "B": "Branch Council", "C": "Office Council", "D": "National Council"}, "answer": "D", "i": "q2arpw7oe0er"}, {"q": "The National Council of JCM is chaired by the:", "options": {"A": "CAG", "B": "Prime Minister", "C": "Cabinet Secretary", "D": "Railway Minister"}, "answer": "C", "i": "qrisa2c6zo"}, {"q": "At ministry level, the JCM forum is called the:", "options": {"A": "Village Council", "B": "Works Committee", "C": "National Council", "D": "Departmental Council"}, "answer": "D", "i": "qksx3wt0ojw"}, {"q": "JCM councils are composed of:", "options": {"A": "Three sides", "B": "Judges and lawyers", "C": "One side only", "D": "Official side and staff side"}, "answer": "D", "i": "q8d82n7gnqr"}, {"q": "The staff side in JCM is represented through members:", "options": {"A": "Self-nominated", "B": "Elected by Parliament", "C": "Nominated by recognised associations and federations", "D": "Appointed by courts"}, "answer": "C", "i": "qlaa936t6w3"}, {"q": "JCM's scope covers:", "options": {"A": "Pay scales", "B": "Conditions of service, welfare and efficiency", "C": "Election manifestos", "D": "Foreign treaties"}, "answer": "B", "i": "qzhsq5llta9"}, {"q": "Which subject is OUTSIDE the purview of JCM?", "options": {"A": "Welfare schemes", "B": "Canteen facilities", "C": "Pay scales and allowances", "D": "Work environment"}, "answer": "C", "i": "ql8japbdjb7"}, {"q": "JCM does NOT deal with:", "options": {"A": "Staff amenities", "B": "Safety at work", "C": "General service conditions", "D": "Individual cases and matters under adjudication"}, "answer": "D", "i": "q2er82wrx1m"}, {"q": "Disputes unresolved in JCM may be referred to:", "options": {"A": "Strike ballot", "B": "Compulsory arbitration", "C": "Media trial", "D": "Hunger strike"}, "answer": "B", "i": "q205belm49e2"}, {"q": "Arbitration under the JCM scheme is conducted by the:", "options": {"A": "Board of Arbitration", "B": "Consumer Forum", "C": "Election Commission", "D": "Labour Court"}, "answer": "A", "i": "qc7z1z7cqfx"}, {"q": "Awards of the JCM Board of Arbitration are:", "options": {"A": "Merely advisory", "B": "Binding, subject to prescribed procedure", "C": "Valid for a week", "D": "Applicable only to officers"}, "answer": "B", "i": "q19al9ilvzu6"}, {"q": "The objective of JCM is:", "options": {"A": "Litigation", "B": "Confrontation", "C": "Joint consultation and harmonious relations", "D": "Privatisation"}, "answer": "C", "i": "q1dzcs7vtgz9"}, {"q": "A Departmental Council under JCM deals with:", "options": {"A": "Department-specific staff matters", "B": "State subjects", "C": "International affairs", "D": "National policies"}, "answer": "A", "i": "q1dkc1hcegii"}, {"q": "At the field-office level, the JCM forum is the:", "options": {"A": "Departmental Council", "B": "Cabinet", "C": "National Council", "D": "Office/Regional Council"}, "answer": "D", "i": "q1efylau81u"}, {"q": "A Departmental Council is chaired by the:", "options": {"A": "Mayor", "B": "Minister", "C": "Secretary of the department", "D": "Chief Justice"}, "answer": "C", "i": "qxtyydzi289"}, {"q": "Unlike PNM, JCM is primarily:", "options": {"A": "Consultative", "B": "Adjudicatory", "C": "Legislative", "D": "Negotiating like PNM"}, "answer": "A", "i": "q3eto342qky"}, {"q": "JCM councils meet:", "options": {"A": "Only during emergencies", "B": "Periodically", "C": "Once in a decade", "D": "Never"}, "answer": "B", "i": "qjsqxo7tmyu"}, {"q": "Representation of the staff side in JCM is determined by:", "options": {"A": "Decided by lottery", "B": "Fixed at two", "C": "Based on recognised associations' representation", "D": "Equal to MPs"}, "answer": "C", "i": "qsu64uaf4bx"}, {"q": "Conclusions of JCM meetings are:", "options": {"A": "Verbal promises", "B": "Recorded minutes with follow-up", "C": "Newspaper ads", "D": "Secret notes"}, "answer": "B", "i": "q1wlt6msjwxl"}, {"q": "Which is NOT a JCM subject?", "options": {"A": "Welfare of staff", "B": "Recruitment policy", "C": "Work environment", "D": "Grievance procedures"}, "answer": "B", "i": "qhn17j0q4ik"}, {"q": "Which subject lies outside JCM's purview?", "options": {"A": "Leave procedures", "B": "Staff canteens", "C": "Pension rules", "D": "Duty hours"}, "answer": "C", "i": "qlaamengah7"}, {"q": "Railway employees are covered by JCM through the:", "options": {"A": "National Council directly", "B": "Departmental Council for Railways", "C": "Office Council only", "D": "They are excluded"}, "answer": "B", "i": "q1i1k3r2bkf6"}, {"q": "On railways, JCM:", "options": {"A": "Handles train operations", "B": "Replaces PNM", "C": "Complements PNM as a consultative forum", "D": "Abolishes unions"}, "answer": "C", "i": "qsqyp1ftaab"}, {"q": "The staff side of a JCM council is coordinated by:", "options": {"A": "The staff side secretary", "B": "The CAG", "C": "The PMO", "D": "The Cabinet Secretary"}, "answer": "A", "i": "q28jzsc8rv68"}, {"q": "JCM discussion items are:", "options": {"A": "Sent to courts", "B": "Published in press", "C": "Raised on the spot", "D": "Submitted as agenda in advance"}, "answer": "D", "i": "q2mps9erof9"}, {"q": "JCM also concerns itself with:", "options": {"A": "Only discipline", "B": "Only transfers", "C": "Only welfare", "D": "Efficiency and welfare of administration"}, "answer": "D", "i": "q1bh54hlzedc"}, {"q": "The JCM scheme covers:", "options": {"A": "Only armed forces", "B": "Only judiciary", "C": "Only railways", "D": "Central Government civilian employees"}, "answer": "D", "i": "q1takal3t01o"}, {"q": "The underlying principle of JCM is:", "options": {"A": "Centralisation", "B": "Outsourcing", "C": "Secrecy", "D": "Association of staff with management decisions"}, "answer": "D", "i": "qar00k1fp4h"}, {"q": "The National Council deals with matters affecting:", "options": {"A": "Central Government employees generally", "B": "One state", "C": "One office", "D": "One department"}, "answer": "A", "i": "q19otrw61r53"}, {"q": "Reference to JCM arbitration is limited to:", "options": {"A": "Matters within JCM scope", "B": "Pay commission awards", "C": "Election disputes", "D": "Any demand"}, "answer": "A", "i": "q1lve4w062au"}, {"q": "Compulsory arbitration under JCM covers:", "options": {"A": "Criminal cases", "B": "Property disputes", "C": "All service matters", "D": "Defined arbitrable matters within scope"}, "answer": "D", "i": "q214gv0k6up5"}, {"q": "Historically, JCM represents:", "options": {"A": "A post-independence staff consultation innovation", "B": "A private enterprise", "C": "A court of law", "D": "A colonial relic"}, "answer": "A", "i": "qse50344zle"}, {"q": "The working method of JCM is:", "options": {"A": "Strikes", "B": "Lockouts", "C": "Unilateral orders", "D": "Structured dialogue"}, "answer": "D", "i": "q15nb2dcxpv9"}, {"q": "Decisions recorded in JCM minutes are:", "options": {"A": "Acted upon by government", "B": "Filed away", "C": "Burnt", "D": "Ignored"}, "answer": "A", "i": "q1d04ssjb29x"}, {"q": "JCM and PNM are:", "options": {"A": "Complementary forums", "B": "Identical bodies", "C": "Defunct bodies", "D": "Rivals"}, "answer": "A", "i": "q16lfcgm9xiu"}, {"q": "JCM seeks to promote:", "options": {"A": "Suspicion", "B": "Apathy", "C": "Confrontation", "D": "Willing cooperation and harmony"}, "answer": "D", "i": "q2b800gl9lfb"}, {"q": "In JCM, the staff side functions through:", "options": {"A": "Anonymous letters", "B": "Fragmented demands", "C": "United staff representation", "D": "Individual petitions"}, "answer": "C", "i": "q1ug1cyh5i7c"}, {"q": "The official side in JCM comprises:", "options": {"A": "Senior government officers", "B": "Retired staff", "C": "Journalists", "D": "Union leaders"}, "answer": "A", "i": "q17x6r4mdgv4"}, {"q": "The key difference between JCM and PNM is:", "options": {"A": "They are identical", "B": "JCM consults while PNM negotiates", "C": "JCM negotiates while PNM consults", "D": "Both are courts"}, "answer": "B", "i": "ql2pc30scrv"}, {"q": "A valid JCM agenda item is:", "options": {"A": "Monetary policy", "B": "Election schedule", "C": "Defence policy", "D": "Staff welfare measures"}, "answer": "D", "i": "q88j6129o7c"}, {"q": "Today, JCM is:", "options": {"A": "A sports body", "B": "A bank", "C": "Abolished", "D": "An active consultation channel"}, "answer": "D", "i": "q2aa0uns4f4j"}, {"q": "Departmental Councils exist to:", "options": {"A": "Run elections", "B": "Bypass staff", "C": "Address departmental staff matters", "D": "Fix taxes"}, "answer": "C", "i": "q6nick4n66r"}, {"q": "Office Councils under JCM handle:", "options": {"A": "Foreign affairs", "B": "Defence", "C": "National policy", "D": "Office-level staff matters"}, "answer": "D", "i": "q13wnengi1gg"}, {"q": "JCM strikes a balance between:", "options": {"A": "Participation with government authority retained", "B": "No staff role", "C": "Judicial review", "D": "Staff veto power"}, "answer": "A", "i": "q1peog2s0imx"}, {"q": "The arbitration clause in the JCM scheme:", "options": {"A": "Privatises it", "B": "Weakens it", "C": "Strengthens it", "D": "Abolishes it"}, "answer": "C", "i": "q11iekrn2ax6"}, {"q": "The core purpose of JCM is:", "options": {"A": "Franchising", "B": "Profit sharing", "C": "Joint consultation on service matters", "D": "Shareholding"}, "answer": "C", "i": "q1qzk0oy644s"}]