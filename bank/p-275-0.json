[{"q":"JCM stands for:","options":{"A":"Judicial Council for Mediation","B":"Joint Commercial Mission","C":"Joint Consultative Machinery","D":"Joint Committee on Management"},"answer":"C"},{"q":"The Joint Consultative Machinery scheme was introduced in:","options":{"A":"1991","B":"1951","C":"1966","D":"1977"},"answer":"C"},{"q":"JCM applies to:","options":{"A":"Central Government employees","B":"State police","C":"Bank staff","D":"Private sector"},"answer":"A"},{"q":"How many tiers does the JCM have?","options":{"A":"Three","B":"Five","C":"One","D":"Two"},"answer":"A"},{"q":"The apex tier of JCM is the:","options":{"A":"Divisional Council","B":"Branch Council","C":"Office Council","D":"National Council"},"answer":"D"},{"q":"The National Council of JCM is chaired by the:","options":{"A":"CAG","B":"Prime Minister","C":"Cabinet Secretary","D":"Railway Minister"},"answer":"C"},{"q":"At ministry level, the JCM forum is called the:","options":{"A":"Village Council","B":"Works Committee","C":"National Council","D":"Departmental Council"},"answer":"D"},{"q":"JCM councils are composed of:","options":{"A":"Three sides","B":"Judges and lawyers","C":"One side only","D":"Official side and staff side"},"answer":"D"},{"q":"The staff side in JCM is represented through members:","options":{"A":"Self-nominated","B":"Elected by Parliament","C":"Nominated by recognised associations and federations","D":"Appointed by courts"},"answer":"C"},{"q":"JCM's scope covers:","options":{"A":"Pay scales","B":"Conditions of service, welfare and efficiency","C":"Election manifestos","D":"Foreign treaties"},"answer":"B"},{"q":"Which subject is OUTSIDE the purview of JCM?","options":{"A":"Welfare schemes","B":"Canteen facilities","C":"Pay scales and allowances","D":"Work environment"},"answer":"C"},{"q":"JCM does NOT deal with:","options":{"A":"Staff amenities","B":"Safety at work","C":"General service conditions","D":"Individual cases and matters under adjudication"},"answer":"D"},{"q":"Disputes unre