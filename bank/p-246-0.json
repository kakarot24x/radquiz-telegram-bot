[{"q": "The Railway Budget is constitutionally known as", "options": {"A": "an audit report", "B": "the Annual Financial Statement", "C": "a loan agreement", "D": "a balance sheet"}, "answer": "B", "i": "qey3vpj6kem"}, {"q": "The Annual Financial Statement is laid under", "options": {"A": "Article 120", "B": "Article 110", "C": "Article 112", "D": "Article 115"}, "answer": "C", "i": "q1lloyzvwfb7"}, {"q": "A separate Railway Budget was presented from the year", "options": {"A": "1947", "B": "1950", "C": "1905", "D": "1924"}, "answer": "D", "i": "qdcc8whnce9"}, {"q": "The Railway Budget was merged with the General Budget from", "options": {"A": "2017-18", "B": "2019-20", "C": "2021-22", "D": "2015-16"}, "answer": "A", "i": "q20w1cz3omhs"}, {"q": "Budget estimates relate to", "options": {"A": "past year", "B": "ensuing financial year", "C": "current month", "D": "five years"}, "answer": "B", "i": "qlhcw19sv4x"}, {"q": "Revised Estimates show", "options": {"A": "five-year plan", "B": "next year's budget", "C": "current year's revised figures", "D": "last year's actuals"}, "answer": "C", "i": "qmgtu1kkg7s"}, {"q": "Actuals in budget documents mean", "options": {"A": "proposals", "B": "sanctions", "C": "estimates", "D": "final accounts figures"}, "answer": "D", "i": "q1diey0ft4ov"}, {"q": "Budget orders issued after the budget convey", "options": {"A": "sanctioned budget allotments", "B": "tender notices", "C": "transfer orders", "D": "audit reports"}, "answer": "A", "i": "q1qndnv9te8j"}, {"q": "Railway budget compilation is coordinated by", "options": {"A": "Traffic department", "B": "Budget Branch of Railway Board", "C": "CAG office", "D": "Zonal stores"}, "answer": "B", "i": "q15xsdlw9qji"}, {"q": "Budget estimates are compiled in the order", "options": {"A": "Ministry to Zone", "B": "Board to Division", "C": "Division to Zone to Board", "D": "CAG to Board"}, "answer": "C", "i": "q11swbyj47p1"}, {"q": "The Indian financial year is", "options": {"A": "1st July to 30th June", "B": "Diwali to Diwali", "C": "1st January to 31st December", "D": "1st April to 31st March"}, "answer": "D", "i": "q13ds211h85n"}, {"q": "Demands for Grants contain", "options": {"A": "expenditure proposals for voting", "B": "loan agreements", "C": "audit paras", "D": "tax proposals"}, "answer": "A", "i": "q1trp5z9xmkn"}, {"q": "The number of Railway Demands for Grants is", "options": {"A": "10", "B": "16", "C": "20", "D": "25"}, "answer": "B", "i": "q21qfyz3eg8m"}, {"q": "Voted and charged expenditure differ because", "options": {"A": "neither needs approval", "B": "both are voted", "C": "voted needs approval, charged does not", "D": "charged needs approval"}, "answer": "C", "i": "q1hopvvbeb6i"}, {"q": "Supplementary Demands for Grants are presented for", "options": {"A": "audit objections", "B": "staff promotions", "C": "next year's budget", "D": "extra funds needed during the year"}, "answer": "D", "i": "q49rh7y6pzc"}, {"q": "A token demand is for a nominal sum of", "options": {"A": "Rs. 100", "B": "Rs. 1", "C": "Rs. 1 lakh", "D": "Rs. 1000"}, "answer": "A", "i": "q1rt4nfn10qy"}, {"q": "Vote on Account provides", "options": {"A": "final budget", "B": "advance grant for part of next year", "C": "audit report", "D": "loan sanction"}, "answer": "B", "i": "qa0g7w4h1bp"}, {"q": "Excess Grants relate to", "options": {"A": "refunds", "B": "savings", "C": "expenditure incurred in excess of grants", "D": "new taxes"}, "answer": "C", "i": "q2eyomgzhu7d"}, {"q": "In budget procedure, 'guillotine' means", "options": {"A": "an audit tool", "B": "a fund", "C": "a tax", "D": "closure of debate on demands"}, "answer": "D", "i": "q13rzxzdsjc7"}, {"q": "Cut motions in Parliament are of three types:", "options": {"A": "policy, economy and token cuts", "B": "only token cuts", "C": "only economy cuts", "D": "all reduce by Re 1"}, "answer": "A", "i": "qfzljoh7y0x"}, {"q": "A policy cut motion seeks to reduce the demand by", "options": {"A": "Rs 100", "B": "Re 1", "C": "Rs 1000", "D": "Rs 1 lakh"}, "answer": "B", "i": "qy40ail0kt4"}, {"q": "Expenditure voted by Parliament is authorised through", "options": {"A": "Ordinary Bill", "B": "Finance Bill", "C": "Appropriation Bill", "D": "Money Bill"}, "answer": "C", "i": "q83uj91k63f"}, {"q": "Withdrawal from the Consolidated Fund needs authority of", "options": {"A": "CAG", "B": "Zonal Manager", "C": "Railway Board", "D": "Parliament through Appropriation Act"}, "answer": "D", "i": "q1xiy5qjzy2t"}, {"q": "Final shaping of Railway budget estimates is done by", "options": {"A": "Railway Board's Budget Branch", "B": "Station masters", "C": "Trade unions", "D": "Divisional offices"}, "answer": "A", "i": "q274od5qqvt"}, {"q": "Budget estimates should be based on", "options": {"A": "guesswork", "B": "past actuals and realistic assessment", "C": "last year's budget", "D": "audit paras"}, "answer": "B", "i": "q11ichccz83n"}, {"q": "Budget estimates are required to be", "options": {"A": "always high", "B": "inflated", "C": "as accurate and realistic as possible", "D": "always low"}, "answer": "C", "i": "q1dofxdojh9t"}, {"q": "Expenditure on a new service requires", "options": {"A": "suspense", "B": "deposit", "C": "re-appropriation", "D": "token provision with Parliament approval"}, "answer": "D", "i": "q1xdk3t6f2ey"}, {"q": "The object of budgetary control is", "options": {"A": "keeping expenditure within sanctioned grants", "B": "avoiding audit", "C": "raising fares", "D": "increasing expenditure"}, "answer": "A", "i": "ql6bn7d3m4l"}, {"q": "Expenditure against budget is reviewed", "options": {"A": "yearly", "B": "monthly", "C": "weekly", "D": "once in five years"}, "answer": "B", "i": "q1ieokpyurl4"}, {"q": "Anticipated savings in grants should be", "options": {"A": "kept secret", "B": "spent hastily", "C": "surrendered as soon as foreseen", "D": "carried forward"}, "answer": "C", "i": "quvlk0uo5h4"}, {"q": "Rush of expenditure in March is", "options": {"A": "ignored", "B": "rewarded", "C": "encouraged", "D": "prohibited"}, "answer": "D", "i": "qmmkwtvcn3j"}, {"q": "Re-appropriation means", "options": {"A": "transfer of savings between heads within a grant", "B": "external loan", "C": "audit objection", "D": "new taxation"}, "answer": "A", "e": "Option A (Transfer within a grant) is the correct choice. This is the fact laid down for the situation described in the question. A useful way to verify this in the exam hall is to ask what would break if the opposite were true — the logic of the underlying system points straight to this option. The remaining options describe different situations or commonly confused alternatives — none of them fits the specific facts asked here. Make a one-line note of this — it is the kind of direct question that rewards quick, confident recall.", "i": "q1hc1m9ztir8"}, {"q": "Re-appropriation cannot be used for", "options": {"A": "creating new services", "B": "increasing the total of the grant", "C": "meeting excess under a head", "D": "using savings"}, "answer": "B", "i": "qmo2h4thktv"}, {"q": "Unspent budget grants at year-end", "options": {"A": "transferred to next year", "B": "carried forward", "C": "lapse on 31st March", "D": "kept in deposit"}, "answer": "C", "i": "qm5i2y7aedd"}, {"q": "Allotment of budget means", "options": {"A": "tax collection", "B": "tendering", "C": "audit", "D": "distribution of grants to disbursing officers"}, "answer": "D", "i": "q1zusjhz59xz"}, {"q": "Expenditure against budget allotment", "options": {"A": "must not exceed without authority", "B": "can exceed in March", "C": "needs no check", "D": "may exceed freely"}, "answer": "A", "i": "qqy0q8s8qua"}, {"q": "Railway budget procedure is laid down in", "options": {"A": "Indian Penal Code", "B": "Finance Code Volume I", "C": "Stores Code", "D": "Establishment Code"}, "answer": "B", "i": "q1gonjqrqeo8"}, {"q": "The Pink Book contains", "options": {"A": "fare tables", "B": "staff list", "C": "works programme with financial outlays", "D": "train timings"}, "answer": "C", "i": "q1v7pvd48ber"}, {"q": "Railway budget estimates originate", "options": {"A": "by CAG", "B": "by Parliament", "C": "at Board level only", "D": "department-wise from units upward"}, "answer": "D", "i": "qx4iqkevlri"}, {"q": "Ways and means estimates relate to", "options": {"A": "cash flow requirements", "B": "track length", "C": "train punctuality", "D": "staff strength"}, "answer": "A", "i": "q1i0mtxddt0q"}, {"q": "The Railway Budget speech presents", "options": {"A": "audit findings", "B": "policy and financial proposals", "C": "staff grievances", "D": "tender results"}, "answer": "B", "i": "q1d6i0v8barh"}, {"q": "Outcome budget emphasises", "options": {"A": "staff numbers", "B": "only money figures", "C": "expenditure linked to physical outcomes", "D": "audit paras"}, "answer": "C", "i": "q1mpagk324i6"}, {"q": "Which is NOT a standard Railway budget document?", "options": {"A": "Explanatory Memorandum", "B": "Pink Book", "C": "Demands for Grants", "D": "Gender Budget statement"}, "answer": "D", "i": "q1wldaovk4r8"}, {"q": "Notes explaining budget provisions appear in", "options": {"A": "Explanatory Memorandum", "B": "Time Table", "C": "Whistle manual", "D": "Pink Book"}, "answer": "A", "i": "qn15y4atoot"}, {"q": "The budget serves as", "options": {"A": "only a legal formality", "B": "a financial plan and control tool", "C": "an audit report", "D": "a loan document"}, "answer": "B", "i": "qymp8f3bbkc"}, {"q": "Ultimate control over railway finance rests with", "options": {"A": "Zonal offices", "B": "Railway Board", "C": "Parliament", "D": "CAG"}, "answer": "C", "i": "q1jhv4wo7ch"}, {"q": "Appropriation Accounts are examined by", "options": {"A": "Staff Council", "B": "Tender Committee", "C": "Estimates Committee", "D": "Public Accounts Committee"}, "answer": "D", "i": "q29u9eku6pmv"}, {"q": "The Estimates Committee deals with", "options": {"A": "suggesting economies", "B": "fixing fares", "C": "recruiting staff", "D": "sanctioning works"}, "answer": "A", "i": "q1hoy13574wx"}, {"q": "The budget should be passed", "options": {"A": "after the year ends", "B": "before the financial year begins", "C": "mid-year", "D": "any time"}, "answer": "B", "i": "q175jbzftj6"}, {"q": "Budget estimates of Zonal Railways are scrutinised at", "options": {"A": "Parliament", "B": "Divisional office", "C": "Railway Board", "D": "CAG"}, "answer": "C", "i": "qwz1vajxk78"}]