[{"q":"The Railway Budget is constitutionally known as","options":{"A":"an audit report","B":"the Annual Financial Statement","C":"a loan agreement","D":"a balance sheet"},"answer":"B"},{"q":"The Annual Financial Statement is laid under","options":{"A":"Article 120","B":"Article 110","C":"Article 112","D":"Article 115"},"answer":"C"},{"q":"A separate Railway Budget was presented from the year","options":{"A":"1947","B":"1950","C":"1905","D":"1924"},"answer":"D"},{"q":"The Railway Budget was merged with the General Budget from","options":{"A":"2017-18","B":"2019-20","C":"2021-22","D":"2015-16"},"answer":"A"},{"q":"Budget estimates relate to","options":{"A":"past year","B":"ensuing financial year","C":"current month","D":"five years"},"answer":"B"},{"q":"Revised Estimates show","options":{"A":"five-year plan","B":"next year's budget","C":"current year's revised figures","D":"last year's actuals"},"answer":"C"},{"q":"Actuals in budget documents mean","options":{"A":"proposals","B":"sanctions","C":"estimates","D":"final accounts figures"},"answer":"D"},{"q":"Budget orders issued after the budget convey","options":{"A":"sanctioned budget allotments","B":"tender notices","C":"transfer orders","D":"audit reports"},"answer":"A"},{"q":"Railway budget compilation is coordinated by","options":{"A":"Traffic department","B":"Budget Branch of Railway Board","C":"CAG office","D":"Zonal stores"},"answer":"B"},{"q":"Budget estimates are compiled in the order","options":{"A":"Ministry to Zone","B":"Board to Division","C":"Division to Zone to Board","D":"CAG to Board"},"answer":"C"},{"q":"The Indian financial year is","options":{"A":"1st July to 30th June","B":"Diwali to Diwali","C":"1st January to 31st December","D":"1st April to 31st March"},"answer":"D"},{"q":"Demands for Grants contain","options":{"A":"expenditure proposals for voting","B":"loan agreements","C":"audit paras","D":"tax proposals"},"answer":"A"},{"q":"The number of Railway Demands for Grants is","options":{"A":"10","