[{"q":"PREM stands for:","options":{"A":"Productivity Review and Evaluation Method","B":"Public Relations and Employee Morale","C":"Participation of Railway Employees in Management","D":"Permanent Railway Employees Mission"},"answer":"C"},{"q":"PREM was introduced on Indian Railways:","options":{"A":"In the 1970s","B":"1966","C":"1991","D":"1951"},"answer":"A"},{"q":"The basic objective of PREM is:","options":{"A":"Retrenchment","B":"Profit sharing","C":"Workers' participation in management","D":"Privatisation"},"answer":"C"},{"q":"PREM operates at how many levels?","options":{"A":"Three","B":"Four","C":"One","D":"Two"},"answer":"A"},{"q":"The apex-level PREM body functions at the:","options":{"A":"Divisional office","B":"Railway Board","C":"Station","D":"Depot"},"answer":"B"},{"q":"Zonal PREM groups comprise:","options":{"A":"Vendors","B":"Only officers","C":"Management and labour representatives","D":"Passengers"},"answer":"C"},{"q":"Divisional-level PREM groups comprise:","options":{"A":"Board members","B":"Divisional management and staff representatives","C":"MPs","D":"Contractors"},"answer":"B"},{"q":"PREM forums discuss:","options":{"A":"Production, productivity and working conditions","B":"Court cases","C":"Elections","D":"Individual grievances"},"answer":"A"},{"q":"PREM is intended to promote:","options":{"A":"Strikes","B":"Lockouts","C":"Confrontation","D":"Industrial peace and joint responsibility"},"answer":"D"},{"q":"Through PREM, employees get:","options":{"A":"Ownership of railways","B":"A voice in management decisions","C":"Higher pensions","D":"Free passes"},"answer":"B"},{"q":"The character of PREM is:","options":{"A":"Adversarial","B":"Participative and joint","C":"Secretive","D":"Judicial"},"answer":"B"},{"q":"The relationship between PREM and PNM is that PREM:","options":{"A":"Replaces PNM","B":"Complements PNM","C":"Abolishes unions","D":"Handles fares"},"answer":"B"},{"q":"A key goal of PREM is to:","options":{"A":"Reduce staff","B":"Improve productivity through involvement","C":"Close workshops","D":"Cut wages"},"answer":"B"},{"q":"PREM bodies are known as:","options":{"A":"Sports clubs","B":"Strike committees","C":"Corporate Enterprise Groups","D":"Canteen committees"},"answer":"C"},{"q":"Membership of PREM groups includes:","options":{"A":"Management and recognised union representatives","B":"Only retirees","C":"Outsiders","D":"Only management"},"answer":"A"},{"q":"PREM seeks to build among employees a sense of:","options":{"A":"Apathy","B":"Rivalry","C":"Fear","D":"Belonging and shared purpose"},"answer":"D"},{"q":"Under PREM, working conditions are:","options":{"A":"Ignore them","B":"Review them jointly","C":"Worsen them","D":"Outsource them"},"answer":"B"},{"q":"PREM is:","options":{"A":"A railway-specific participation scheme","B":"A court","C":"A bank","D":"A copy of PNM"},"answer":"A"},{"q":"Joint councils under PREM discuss:","options":{"A":"Wage strikes","B":"Enterprise efficiency and welfare","C":"Political campaigns","D":"Film production"},"answer":"B"},{"q":"The philosophy behind PREM is:","options":{"A":"Nepotism","B":"Authoritarian control","C":"Democratic participation","D":"Secrecy"},"answer":"C"},{"q":"PREM meetings are held:","options":{"A":"Only during strikes","B":"Once in a decade","C":"Periodically at each level","D":"Never"},"answer":"C"},{"q":"Decisions of PREM groups are:","options":{"A":"Forgotten","B":"Recorded with follow-up action","C":"Burnt","D":"Hidden"},"answer":"B"},{"q":"A valid PREM subject is:","options":{"A":"Fare policy","B":"Safety and work environment","C":"Cricket","D":"Cinema"},"answer":"B"},{"q":"Which subject is NOT for PREM?","options":{"A":"Individual disciplinary cases","B":"Welfare schemes","C":"Work methods","D":"Productivity measures"},"answer":"A"},{"q":"PREM treats employee suggestions as input that:","options":{"A":"Ignores them","B":"Punishes them","C":"Suppresses them","D":"Channels them into decisions"},"answer":"D"},{"q":"PREM aims to build between labour and management:","options":{"A":"Distrust","B":"Mutual trust","C":"Fear","D":"Indifference"},"answer":"B"},{"q":"In Indian labour history, railway PREM was:","options":{"A":"A routine audit","B":"A pioneering participation experiment","C":"A tax reform","D":"A census"},"answer":"B"},{"q":"PREM groups also look at:","options":{"A":"Review welfare measures","B":"Cut welfare","C":"Sell hospitals","D":"Ignore welfare"},"answer":"A"},{"q":"PREM views the railway enterprise as a:","options":{"A":"Adversarial","B":"Indifferent","C":"Master-servant","D":"Joint endeavour"},"answer":"D"},{"q":"To raise efficiency, PREM forums may suggest:","options":{"A":"Lower wages","B":"Longer hours","C":"Better work methods","D":"Fewer holidays"},"answer":"C"},{"q":"PREM promotes:","options":{"A":"Silence","B":"Secrecy","C":"Open communication","D":"Rumours"},"answer":"C"},{"q":"The core of PREM is:","options":{"A":"Participation","B":"Arbitration","C":"Adjudication","D":"Bargaining"},"answer":"A"},{"q":"Board-level PREM associates:","options":{"A":"Only clerks","B":"Top management and federation representatives","C":"Passengers","D":"Vendors"},"answer":"B"},{"q":"Zonal PREM deals with:","options":{"A":"National budgets","B":"Zone-level enterprise matters","C":"Court verdicts","D":"Elections"},"answer":"B"},{"q":"Divisional PREM handles:","options":{"A":"International treaties","B":"Parliamentary debates","C":"Film awards","D":"Division-level working and welfare"},"answer":"D"},{"q":"PREM succeeds when there is:","options":{"A":"Press coverage","B":"Postponement","C":"Token meetings","D":"Sincere implementation"},"answer":"D"},{"q":"PREM is an expression of:","options":{"A":"Autocracy","B":"Industrial democracy","C":"Anarchy","D":"Bureaucratic secrecy"},"answer":"B"},{"q":"Effective PREM tends to:","options":{"A":"Reduce disputes","B":"Stop trains","C":"Raise fares","D":"Increase disputes"},"answer":"A"},{"q":"PREM groups approach local problems by:","options":{"A":"Recommend joint solutions","B":"Avoid problems","C":"Blame workers","D":"Impose solutions"},"answer":"A"},{"q":"Worker education under PREM is:","options":{"A":"Wasteful","B":"Banned","C":"Unnecessary","D":"Support meaningful participation"},"answer":"D"},{"q":"The coverage of PREM extends to:","options":{"A":"Only officers","B":"All employees through representatives","C":"Only retirees","D":"Outsiders"},"answer":"B"},{"q":"The tone of PREM discussions is:","options":{"A":"Destructive","B":"Constructive","C":"Aimless","D":"Secretive"},"answer":"B"},{"q":"PREM differs from JCM in that:","options":{"A":"JCM is superior","B":"Both are courts","C":"They are identical","D":"PREM is enterprise participation; JCM is service-conditions consultation"},"answer":"D"},{"q":"Records of PREM meetings are:","options":{"A":"Kept secret","B":"Destroyed","C":"Not kept","D":"Kept as joint record"},"answer":"D"},{"q":"Today, PREM is:","options":{"A":"A distinctive railway feature","B":"A private firm","C":"A foreign concept","D":"Abolished long ago"},"answer":"A"},{"q":"A legitimate PREM agenda item is:","options":{"A":"Share prices","B":"Election funding","C":"Military strategy","D":"Staff amenities"},"answer":"D"},{"q":"PREM does NOT handle:","options":{"A":"Individual grievances","B":"Productivity","C":"Welfare","D":"Enterprise matters"},"answer":"A"},{"q":"PREM aligns employee interests with:","options":{"A":"Opposes them","B":"Aligns them","C":"Ignores them","D":"Replaces them"},"answer":"B"},{"q":"The PREM experiment influenced:","options":{"A":"Court cases","B":"No influence","C":"Later participation initiatives","D":"Strike waves"},"answer":"C"},{"q":"The ultimate aim of PREM is:","options":{"A":"More secrecy","B":"More disputes","C":"Better working through cooperation","D":"Less dialogue"},"answer":"C"}]