[{"q": "PREM stands for:", "options": {"A": "Productivity Review and Evaluation Method", "B": "Public Relations and Employee Morale", "C": "Participation of Railway Employees in Management", "D": "Permanent Railway Employees Mission"}, "answer": "C", "i": "q24s4ucm9gbj"}, {"q": "PREM was introduced on Indian Railways:", "options": {"A": "In the 1970s", "B": "1966", "C": "1991", "D": "1951"}, "answer": "A", "i": "q37q8fww56q"}, {"q": "The basic objective of PREM is:", "options": {"A": "Retrenchment", "B": "Profit sharing", "C": "Workers' participation in management", "D": "Privatisation"}, "answer": "C", "i": "q433kse1lzb"}, {"q": "PREM operates at how many levels?", "options": {"A": "Three", "B": "Four", "C": "One", "D": "Two"}, "answer": "A", "i": "qzr2w8vu2u6"}, {"q": "The apex-level PREM body functions at the:", "options": {"A": "Divisional office", "B": "Railway Board", "C": "Station", "D": "Depot"}, "answer": "B", "i": "q13lmdb6di9h"}, {"q": "Zonal PREM groups comprise:", "options": {"A": "Vendors", "B": "Only officers", "C": "Management and labour representatives", "D": "Passengers"}, "answer": "C", "i": "q2fuq28msnyd"}, {"q": "Divisional-level PREM groups comprise:", "options": {"A": "Board members", "B": "Divisional management and staff representatives", "C": "MPs", "D": "Contractors"}, "answer": "B", "i": "q20si92osyhj"}, {"q": "PREM forums discuss:", "options": {"A": "Production, productivity and working conditions", "B": "Court cases", "C": "Elections", "D": "Individual grievances"}, "answer": "A", "i": "q21l5y00tqo2"}, {"q": "PREM is intended to promote:", "options": {"A": "Strikes", "B": "Lockouts", "C": "Confrontation", "D": "Industrial peace and joint responsibility"}, "answer": "D", "i": "q19ksx8ucxu5"}, {"q": "Through PREM, employees get:", "options": {"A": "Ownership of railways", "B": "A voice in management decisions", "C": "Higher pensions", "D": "Free passes"}, "answer": "B", "i": "qlvz9116cnm"}, {"q": "The character of PREM is:", "options": {"A