[{"q": "Expenditure on manufacture of rolling stock is first booked to which head?", "options": {"A": "Capital - Rolling Stock", "B": "Workshop Manufacture Suspense", "C": "Revenue - Repairs", "D": "Stores Suspense"}, "answer": "B", "i": "q24n53oxwa4e"}, {"q": "The abbreviation WMS stands for?", "options": {"A": "Works Management System", "B": "Workshop Material Stock", "C": "Workshop Manufacture Suspense", "D": "Wagon Maintenance Schedule"}, "answer": "C", "i": "qc0aa9p982o"}, {"q": "Which production unit manufactures electric locomotives?", "options": {"A": "CLW", "B": "ICF", "C": "RCF", "D": "RWF"}, "answer": "A", "i": "q25tfcs3iqqr"}, {"q": "Diesel locomotives are manufactured at which production unit?", "options": {"A": "ICF", "B": "RCF", "C": "MCF", "D": "BLW"}, "answer": "D", "i": "q1yslhn1e4rq"}, {"q": "Integral coaches are manufactured at which production unit?", "options": {"A": "CLW", "B": "BLW", "C": "ICF", "D": "RWF"}, "answer": "C", "i": "q22dua1n7k16"}, {"q": "The Rail Coach Factory (RCF) is located at?", "options": {"A": "Chennai", "B": "Kapurthala", "C": "Raebareli", "D": "Varanasi"}, "answer": "B", "i": "qwixnr0zqvh"}, {"q": "Wheels and axles are manufactured at which production unit?", "options": {"A": "CLW", "B": "ICF", "C": "MCF", "D": "RWF"}, "answer": "D", "i": "qtkd0izbqde"}, {"q": "The Modern Coach Factory (MCF) is situated at?", "options": {"A": "Raebareli", "B": "Kapurthala", "C": "Perambur", "D": "Chittaranjan"}, "answer": "A", "i": "ql6x5j6y94t"}, {"q": "The cost of manufacture of a locomotive comprises?", "options": {"A": "Only material", "B": "Only wages", "C": "Material, labour and overhead", "D": "Freight and taxes only"}, "answer": "C", "i": "q2mwm8rl499"}, {"q": "On completion of manufacture, WMS is cleared by?", "options": {"A": "Writing it off", "B": "Transfer at transfer price", "C": "Cash receipt", "D": "Budget lapse"}, "answer": "B", "i": "q1mv4s57oo6n"}, {"q": "The statement showing completed manufacture and its cost is calle