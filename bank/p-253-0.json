[{"q": "Group A railway officers are recruited through", "options": {"A": "UPSC examinations", "B": "RRB examinations", "C": "RRC notifications", "D": "campus placement only"}, "answer": "A", "i": "q17uz4ac2b0q"}, {"q": "IRMS stands for", "options": {"A": "Indian Railway Medical Service", "B": "Indian Railway Management Service", "C": "Indian Railway Mail Service", "D": "Indian Railway Mechanical Society"}, "answer": "B", "i": "q22wkpyuy8wk"}, {"q": "RRB stands for", "options": {"A": "Railway Reservation Board", "B": "Railway Revenue Board", "C": "Railway Recruitment Board", "D": "Railway Running Board"}, "answer": "C", "i": "qhom986oth1"}, {"q": "RRC stands for", "options": {"A": "Railway Reservation Centre", "B": "Railway Running Cell", "C": "Railway Revenue Cell", "D": "Railway Recruitment Cell"}, "answer": "D", "i": "qbstior6p7s"}, {"q": "RRCs recruit mainly for", "options": {"A": "Level-1 (erstwhile Group D) posts", "B": "Board members", "C": "consultants", "D": "Group A posts"}, "answer": "A", "i": "q1r097ttifyr"}, {"q": "Group B posts are generally filled by", "options": {"A": "lateral entry only", "B": "promotion or LDCE from Group C", "C": "nomination", "D": "direct UPSC examination"}, "answer": "B", "i": "q1hzmzr6ujyn"}, {"q": "LDCE stands for", "options": {"A": "Long Distance Corridor Examination", "B": "Local Development Committee Examination", "C": "Limited Departmental Competitive Examination", "D": "Lower Division Clerical Examination"}, "answer": "C", "i": "q2fw1gemx80"}, {"q": "In railways, NTPC stands for", "options": {"A": "New Train Planning Committee", "B": "Non-Transferable Pass Category", "C": "National Thermal Power Corporation", "D": "Non-Technical Popular Categories"}, "answer": "D", "i": "q1n65ehx7pk4"}, {"q": "ALP stands for", "options": {"A": "Assistant Loco Pilot", "B": "Advanced Learning Programme", "C": "Additional Leave Pass", "D": "All India Level Post"}, "answer": "A", "i": "q11xnd9wp0qb"}, {"q": "The general minimum age for railway recruitment is", "options": {"A": "25 years", "B": "18 years", "C": "16 years", "D": "21 years"}, "answer": "B", "i": "q1dy3eymsrib"}, {"q": "Reservation for SC in direct recruitment is", "options": {"A": "50%", "B": "5%", "C": "15%", "D": "27%"}, "answer": "C", "i": "q109sjrh5e1c"}, {"q": "Reservation for ST in direct recruitment is", "options": {"A": "27%", "B": "15%", "C": "10%", "D": "7.5%"}, "answer": "D", "i": "q136okt2szy5"}, {"q": "Reservation for OBC in direct recruitment is", "options": {"A": "27%", "B": "15%", "C": "10%", "D": "50%"}, "answer": "A", "i": "qghdtoqoat1"}, {"q": "EWS reservation in direct recruitment is", "options": {"A": "5%", "B": "10%", "C": "15%", "D": "27%"}, "answer": "B", "i": "qsb5pc8mkq8"}, {"q": "Age relaxation is admissible to", "options": {"A": "no one", "B": "only general candidates", "C": "reserved categories and ex-servicemen as per rules", "D": "only officers"}, "answer": "C", "i": "q2wxz5c4za7"}, {"q": "Medical standards for safety categories are", "options": {"A": "the most lenient", "B": "not required", "C": "the same for all", "D": "the most stringent"}, "answer": "D", "i": "q28nmefdzh4e"}, {"q": "Compassionate appointment is considered when", "options": {"A": "the breadwinner dies in harness or is medically invalidated", "B": "a post falls vacant", "C": "an employee retires normally", "D": "an employee seeks transfer"}, "answer": "A", "i": "q23u21hjlvlc"}, {"q": "Compassionate appointment is normally offered to", "options": {"A": "friends", "B": "the spouse, son or unmarried daughter", "C": "neighbours", "D": "distant relatives"}, "answer": "B", "i": "q1qxkqrhuj1s"}, {"q": "Sports quota recruitment requires", "options": {"A": "a recommendation letter", "B": "no achievement at all", "C": "outstanding performance at recognized championships", "D": "merely playing at school"}, "answer": "C", "i": "q1qtent3x0jh"}, {"q": "Cultural quota is meant for", "options": {"A": "retired artists", "B": "foreign artists", "C": "all employees", "D": "outstanding artists in notified disciplines"}, "answer": "D", "i": "q2f20vlto4uw"}, {"q": "Scouts and Guides quota recognizes", "options": {"A": "distinguished scouting or guiding service", "B": "sports achievements", "C": "NCC service alone", "D": "school attendance"}, "answer": "A", "i": "q6gj1oy5vp6"}, {"q": "Direct recruitment and promotion quotas are", "options": {"A": "decided by unions", "B": "prescribed separately for each category", "C": "always equal", "D": "never fixed"}, "answer": "B", "i": "q19yl0xa9m6h"}, {"q": "Apprentices completing training", "options": {"A": "get double stipend", "B": "must be absorbed", "C": "have no automatic right to appointment", "D": "become officers"}, "answer": "C", "i": "q270eaijxsb6"}, {"q": "Verification of certificates is done", "options": {"A": "after ten years", "B": "never", "C": "only at retirement", "D": "at the time of appointment"}, "answer": "D", "i": "q2fifmx2ovze"}, {"q": "For appointment, a candidate must generally be", "options": {"A": "a citizen of India", "B": "necessarily a graduate", "C": "necessarily married", "D": "a local resident only"}, "answer": "A", "i": "qb7xwofiw56"}, {"q": "The select list for recruitment is prepared", "options": {"A": "alphabetically", "B": "in order of merit", "C": "by age", "D": "randomly"}, "answer": "B", "i": "q594uja4qe8"}, {"q": "A reserve or waiting list is operated", "options": {"A": "never", "B": "for promotions", "C": "when selected candidates do not join", "D": "for transfers"}, "answer": "C", "i": "q2et3d7q8rbi"}, {"q": "Deputation to other organizations requires", "options": {"A": "only seniority", "B": "court orders", "C": "union demand", "D": "willingness and approval of the competent authority"}, "answer": "D", "i": "q192aqtfdxwg"}, {"q": "Re-employment after retirement is", "options": {"A": "exceptional and needs specific sanction", "B": "automatic", "C": "open to all", "D": "a right"}, "answer": "A", "i": "quiegdul31p"}, {"q": "Contract appointment is", "options": {"A": "without any agreement", "B": "for a fixed term on agreed terms", "C": "always pensionable", "D": "permanent"}, "answer": "B", "i": "q137s8h0y6kl"}, {"q": "Substitutes are engaged for", "options": {"A": "officer ranks", "B": "foreign service", "C": "short-term working needs", "D": "permanent posts"}, "answer": "C", "i": "q218pn8py8tv"}, {"q": "Casual labour attaining temporary status gets", "options": {"A": "no benefits", "B": "immediate pension", "C": "gazetted rank", "D": "benefits like regular scales of pay"}, "answer": "D", "i": "quoxch056l9"}, {"q": "Screening of casual labour is done by", "options": {"A": "a screening committee", "B": "seniority alone", "C": "a single clerk", "D": "lottery"}, "answer": "A", "i": "q2djwd98nllk"}, {"q": "Absorption of quasi-permanent staff is", "options": {"A": "by court order only", "B": "against permanent vacancies as per rules", "C": "automatic everywhere", "D": "never done"}, "answer": "B", "i": "q1g13xb0shat"}, {"q": "The training period of a direct recruit", "options": {"A": "is always unpaid", "B": "never counts", "C": "counts towards probation", "D": "counts double"}, "answer": "C", "i": "qi1k99y71uw"}, {"q": "Stipend during training is", "options": {"A": "decided by the trainee", "B": "never paid", "C": "equal to full pay always", "D": "admissible at prescribed rates"}, "answer": "D", "i": "q2a0n6u1bmr8"}, {"q": "Departmental examinations are held for", "options": {"A": "promotion and confirmation", "B": "entertainment", "C": "transfers", "D": "passes"}, "answer": "A", "i": "q1c2ee8roqym"}, {"q": "Passing prescribed departmental examinations is", "options": {"A": "optional always", "B": "mandatory for confirmation in some categories", "C": "never required", "D": "only for officers"}, "answer": "B", "i": "qt42awb3kqy"}, {"q": "Seniority on direct recruitment is fixed by", "options": {"A": "date of joining only", "B": "age", "C": "merit in the selection", "D": "height"}, "answer": "C", "i": "q25asupv6xzk"}, {"q": "Inter-se seniority of direct recruits and promotees follows", "options": {"A": "a coin toss", "B": "alphabetical order", "C": "personal choice", "D": "quota-based rotation rules"}, "answer": "D", "i": "q7deyfanr3j"}, {"q": "A selected candidate must join within", "options": {"A": "the stipulated joining time", "B": "ten years", "C": "no limit", "D": "any time in life"}, "answer": "A", "i": "q1w42lx7s5uz"}, {"q": "Extension of joining time needs", "options": {"A": "union approval", "B": "approval of the competent authority", "C": "a court order", "D": "no approval"}, "answer": "B", "i": "qnw3s6kwyaz"}, {"q": "Failure to join in time may lead to", "options": {"A": "promotion", "B": "no consequence", "C": "cancellation of the offer of appointment", "D": "double salary"}, "answer": "C", "i": "q1d8bmjgs38x"}, {"q": "Railway servants owe allegiance to", "options": {"A": "contractors", "B": "no one", "C": "the trade union", "D": "the Constitution of India"}, "answer": "D", "i": "q1amzddlis2r"}, {"q": "Declaration of marital status is required", "options": {"A": "at the time of appointment", "B": "every month", "C": "never", "D": "at retirement"}, "answer": "A", "i": "q1gxysex4lpf"}, {"q": "Contracting a second marriage during the spouse's lifetime is", "options": {"A": "irrelevant", "B": "misconduct under the Conduct Rules", "C": "permitted", "D": "encouraged"}, "answer": "B", "i": "q50nns24rgl"}, {"q": "Employment of close relatives in subordinate posts needs", "options": {"A": "a court order", "B": "no permission ever", "C": "prior permission in certain cases", "D": "is totally banned"}, "answer": "C", "i": "q235i5n4uop7"}, {"q": "A candidate selected through RRB is allotted", "options": {"A": "always to his home town", "B": "only to Delhi", "C": "anywhere at random", "D": "to a railway or unit by merit-cum-preference"}, "answer": "D", "i": "q22c1ieyso1m"}, {"q": "Document verification precedes", "options": {"A": "the issue of the appointment letter", "B": "retirement", "C": "promotion", "D": "transfer"}, "answer": "A", "i": "q1o9v6cu1ax2"}, {"q": "The appointing authority for Group C posts is", "options": {"A": "always the President", "B": "as prescribed in the Schedule of Powers", "C": "the Supreme Court", "D": "the trade union"}, "answer": "B", "i": "qx0a1wjudn5"}]