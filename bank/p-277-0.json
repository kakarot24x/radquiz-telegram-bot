[{"q":"The purpose of staff grievance redressal machinery is to:","options":{"A":"Run trains","B":"Punish workers","C":"Resolve employee complaints speedily","D":"Fix fares"},"answer":"C"},{"q":"An employee's grievance is first raised with:","options":{"A":"The Railway Minister","B":"The immediate supervisor","C":"The press","D":"The court"},"answer":"B"},{"q":"If a grievance is not settled at the first stage, it is:","options":{"A":"Published","B":"Forgotten","C":"Dropped","D":"Escalated to higher stages"},"answer":"D"},{"q":"Staff grievance machinery deals with:","options":{"A":"Work-related issues","B":"Family disputes","C":"Criminal cases","D":"National politics"},"answer":"A"},{"q":"Effective grievance handling requires:","options":{"A":"Secrecy","B":"Punishment","C":"Delay","D":"Speedy redressal"},"answer":"D"},{"q":"Staff councils serve to:","options":{"A":"Fix train fares","B":"Discuss staff matters at unit level","C":"Run elections","D":"Collect taxes"},"answer":"B"},{"q":"On railways, union recognition is decided through:","options":{"A":"Secret ballot among employees","B":"Seniority","C":"Lottery","D":"Nomination by management"},"answer":"A"},{"q":"Negotiating rights with railway administration belong to:","options":{"A":"Any union","B":"Recognised unions","C":"Political parties","D":"NGOs"},"answer":"B"},{"q":"Secret ballot for union recognition on railways was:","options":{"A":"Banned","B":"Only for officers","C":"A colonial practice","D":"Introduced on railways in the 2000s"},"answer":"D"},{"q":"The historic all-India railway strike took place in:","options":{"A":"2020","B":"1947","C":"1974","D":"1991"},"answer":"C"},{"q":"The 1974 railway strike was led by:","options":{"A":"A judge","B":"A station master","C":"George Fernandes","D":"A minister"},"answer":"C"},{"q":"Under the Industrial Disputes Act, railways are:","options":{"A":"A public utility service under the ID Act","B":"A private firm","C":"A foreign company","D":"An industry exempt from law"},