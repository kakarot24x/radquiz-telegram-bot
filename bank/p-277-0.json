[{"q": "The purpose of staff grievance redressal machinery is to:", "options": {"A": "Run trains", "B": "Punish workers", "C": "Resolve employee complaints speedily", "D": "Fix fares"}, "answer": "C", "i": "qkudb43warg"}, {"q": "An employee's grievance is first raised with:", "options": {"A": "The Railway Minister", "B": "The immediate supervisor", "C": "The press", "D": "The court"}, "answer": "B", "i": "qgpfkpghhux"}, {"q": "If a grievance is not settled at the first stage, it is:", "options": {"A": "Published", "B": "Forgotten", "C": "Dropped", "D": "Escalated to higher stages"}, "answer": "D", "i": "q1dgd0iz8xgi"}, {"q": "Staff grievance machinery deals with:", "options": {"A": "Work-related issues", "B": "Family disputes", "C": "Criminal cases", "D": "National politics"}, "answer": "A", "i": "q1ul1p0jrlff"}, {"q": "Effective grievance handling requires:", "options": {"A": "Secrecy", "B": "Punishment", "C": "Delay", "D": "Speedy redressal"}, "answer": "D", "i": "qdb4sxl6n56"}, {"q": "Staff councils serve to:", "options": {"A": "Fix train fares", "B": "Discuss staff matters at unit level", "C": "Run elections", "D": "Collect taxes"}, "answer": "B", "i": "qlbs8wsomls"}, {"q": "On railways, union recognition is decided through:", "options": {"A": "Secret ballot among employees", "B": "Seniority", "C": "Lottery", "D": "Nomination by management"}, "answer": "A", "i": "qac25of6xm4"}, {"q": "Negotiating rights with railway administration belong to:", "options": {"A": "Any union", "B": "Recognised unions", "C": "Political parties", "D": "NGOs"}, "answer": "B", "i": "q517hmydqg6"}, {"q": "Secret ballot for union recognition on railways was:", "options": {"A": "Banned", "B": "Only for officers", "C": "A colonial practice", "D": "Introduced on railways in the 2000s"}, "answer": "D", "i": "qii3kmochcf"}, {"q": "The historic all-India railway strike took place in:", "options": {"A": "2020", "B": "1947", "C": "1974", "D": "1991"}, "answer": "C", "i": "q1f1wnqogkbr"}, {"q": "The 1974 railway strike was led by:", "options": {"A": "A judge", "B": "A station master", "C": "George Fernandes", "D": "A minister"}, "answer": "C", "i": "q1e450k9xuos"}, {"q": "Under the Industrial Disputes Act, railways are:", "options": {"A": "A public utility service under the ID Act", "B": "A private firm", "C": "A foreign company", "D": "An industry exempt from law"}, "answer": "A", "i": "qxtlyoj62p7"}, {"q": "For a strike in railways, the ID Act requires:", "options": {"A": "Only verbal notice", "B": "Notice to passengers", "C": "No notice needed", "D": "Statutory notice before strike"}, "answer": "D", "i": "q13t1jv06ewq"}, {"q": "ESMA stands for a law relating to:", "options": {"A": "A pension scheme", "B": "A ticket quota", "C": "A train type", "D": "Law to prohibit strikes in essential services"}, "answer": "D", "i": "qci527qzlko"}, {"q": "The role of a negotiating union is to:", "options": {"A": "Sell tickets", "B": "Fix fares", "C": "Bargain on staff demands", "D": "Drive trains"}, "answer": "C", "i": "q12uhn8i9wuo"}, {"q": "Collective bargaining seeks:", "options": {"A": "Litigation", "B": "Strikes", "C": "Negotiated settlements", "D": "Lockouts"}, "answer": "C", "i": "q1soux01wix5"}, {"q": "Labour welfare inspectors on railways deal with:", "options": {"A": "Train driving", "B": "Signalling", "C": "Ticket checking", "D": "Staff welfare measures"}, "answer": "D", "i": "qkh3tlr702l"}, {"q": "Which matter is excluded from grievance machinery?", "options": {"A": "Transfer requests", "B": "Matters under adjudication", "C": "Allowance claims", "D": "Duty rosters"}, "answer": "B", "i": "q2gi6d5bwr4a"}, {"q": "Union representatives act for:", "options": {"A": "Government revenue", "B": "Personal gain", "C": "Members' collective interests", "D": "Management profits"}, "answer": "C", "i": "q5of44hrl2l"}, {"q": "Healthy industrial relations are built on:", "options": {"A": "Suspicion", "B": "Mutual trust and dialogue", "C": "Secrecy", "D": "Confrontation"}, "answer": "B", "i": "qr0xd3gj4ym"}, {"q": "Grievance committees function to:", "options": {"A": "Collect fares", "B": "Drive trains", "C": "Punish", "D": "Hear and recommend on complaints"}, "answer": "D", "i": "q1ccgwxxpvb4"}, {"q": "An aggrieved employee is expected to:", "options": {"A": "File court cases first", "B": "Go on strike first", "C": "Go to press first", "D": "Use the internal grievance channel first"}, "answer": "D", "i": "q111n19ru5zg"}, {"q": "Victimisation for legitimate union activity is:", "options": {"A": "Mandatory", "B": "Encouraged", "C": "Allowed", "D": "An unfair labour practice"}, "answer": "D", "i": "q3rax95gy2a"}, {"q": "A recognised union enjoys:", "options": {"A": "Ownership of railways", "B": "Tax exemption", "C": "Nothing", "D": "Negotiating and representational rights"}, "answer": "D", "i": "qm9wslbw47f"}, {"q": "An unrecognised union has:", "options": {"A": "No formal negotiating status", "B": "Veto power", "C": "Management control", "D": "Full negotiating rights"}, "answer": "A", "i": "q1hruyq7kvwn"}, {"q": "The role of a federation is to:", "options": {"A": "Coordinate affiliated unions nationally", "B": "Fix salaries", "C": "Build tracks", "D": "Run trains"}, "answer": "A", "i": "q211sqdp72d0"}, {"q": "Affiliated zonal unions mainly negotiate at the:", "options": {"A": "Parliament", "B": "Courts", "C": "Board level", "D": "Zonal level"}, "answer": "D", "i": "qqdgsh6d7bk"}, {"q": "Divisional unions deal with:", "options": {"A": "Defence", "B": "National policy", "C": "Division-level issues", "D": "Foreign affairs"}, "answer": "C", "i": "q1oum7wku0d3"}, {"q": "Successful negotiation requires:", "options": {"A": "Rumours", "B": "Violence", "C": "Threats", "D": "Reasonable, fact-based demands"}, "answer": "D", "i": "qthl84iovw1"}, {"q": "In industrial relations, a strike is regarded as a:", "options": {"A": "First step", "B": "Last resort", "C": "Routine tool", "D": "Celebration"}, "answer": "B", "i": "q2bqw67632xg"}, {"q": "The 1974 railway strike:", "options": {"A": "Closed railways", "B": "No impact", "C": "Shaped later labour forums", "D": "Banned unions"}, "answer": "C", "i": "qdlc9468l7b"}, {"q": "The preferred method of settling railway industrial disputes is:", "options": {"A": "Peaceful negotiated settlement", "B": "Violence", "C": "Shutdown", "D": "Disruption"}, "answer": "A", "i": "q10jeqbcpu7n"}, {"q": "A tripartite labour body includes:", "options": {"A": "Only workers", "B": "Only government", "C": "Two parties", "D": "Government, employers and workers"}, "answer": "D", "i": "qx9cjfu47pb"}, {"q": "The Indian Labour Conference is:", "options": {"A": "A railway station", "B": "Apex tripartite labour forum", "C": "A train", "D": "A union office"}, "answer": "B", "i": "q1leucit31ys"}, {"q": "A bipartite forum involves:", "options": {"A": "Courts alone", "B": "Three parties", "C": "Management and labour", "D": "Government alone"}, "answer": "C", "i": "q25tvcabhrxn"}, {"q": "Stability in railway industrial relations rests on:", "options": {"A": "Court cases", "B": "Strikes", "C": "Continuous dialogue forums", "D": "Lockouts"}, "answer": "C", "i": "q1mb2gi02626"}, {"q": "The railway industrial-relations framework comprises:", "options": {"A": "Only strikes", "B": "Grievance redressal, negotiation and participation", "C": "Only courts", "D": "Only rules"}, "answer": "B", "i": "q20zpcqbtsv8"}, {"q": "The credibility of PNM/JCM/PREM depends on:", "options": {"A": "Delaying them", "B": "Breaking them", "C": "Honouring them", "D": "Hiding them"}, "answer": "C", "i": "q1md008wsvgu"}, {"q": "The ultimate beneficiary of good railway industrial relations is:", "options": {"A": "Uninterrupted national service", "B": "Conflict", "C": "Stagnation", "D": "Disruption"}, "answer": "A", "i": "q1iiz1824hmm"}, {"q": "The three pillars of railway industrial relations are:", "options": {"A": "Only courts", "B": "Only strikes", "C": "Only PNM", "D": "PNM, JCM and PREM together"}, "answer": "D", "i": "q1ptyhfey7mz"}]