[{"q":"The Industrial Disputes Act was enacted in","options":{"A":"1947","B":"1948","C":"1950","D":"1926"},"answer":"A"},{"q":"The ID Act, 1947 came into force on","options":{"A":"1 April 1947","B":"1 April 1948","C":"15 August 1947","D":"26 January 1950"},"answer":"A"},{"q":"Under the ID Act, 'industry' means","options":{"A":"Any business, trade, undertaking, manufacture or calling of employers","B":"Only factories","C":"Only mines","D":"Only railways"},"answer":"A"},{"q":"The definition of 'workman' under ID Act excludes","options":{"A":"Persons in managerial/administrative capacity drawing > Rs.18,000/month","B":"All workers","C":"Only casual labour","D":"None"},"answer":"A"},{"q":"The wage limit for 'workman' under ID Act (supervisory) is","options":{"A":"Rs.18,000 per month","B":"Rs.5,000","C":"Rs.15,000","D":"No limit"},"answer":"A"},{"q":"Lay-off under ID Act means","options":{"A":"Failure/refusal/inability of employer to give employment due to shortage of coal, power, raw materials etc.","B":"Termination","C":"Retirement","D":"Transfer"},"answer":"A"},{"q":"Lay-off compensation is","options":{"A":"50% of basic + DA","B":"100% wages","C":"25% wages","D":"No compensation"},"answer":"A"},{"q":"Lay-off compensation is payable for","options":{"A":"First 45 days","B":"All days","C":"Only 10 days","D":"No days"},"answer":"A"},{"q":"Retrenchment means","options":{"A":"Termination of service for any reason other than punishment","B":"Voluntary retirement","C":"Superannuation","D":"Closure"},"answer":"A"},{"q":"Notice for retrenchment under Section 25F is","options":{"A":"One month's notice or wages in lieu","B":"Three months","C":"No notice","D":"One week"},"answer":"A"},{"q":"Retrenchment compensation is","options":{"A":"15 days average pay per completed year of service","B":"One month per year","C":"No compensation","D":"30 days per year"},"answer":"A"},{"q":"Section 25F applies to workmen with","options":{"A":"1 year continuous service","B":"5 years","C":"10 years","D":"6 months"},"answer":"A"},{"q":"Closure of an undertaking requires notice of","options":{"A":"60 days (if 100+ workmen)","B":"30 days","C":"90 days","D":"No notice"},"answer":"A"},{"q":"Chapter VB (special provisions) applies to establishments with","options":{"A":"100 or more workmen","B":"50 or more","C":"300 or more","D":"10 or more"},"answer":"A"},{"q":"Prior permission for lay-off/retrenchment/closure under Chapter VB is required from","options":{"A":"Appropriate Government","B":"Labour Court","C":"High Court","D":"None"},"answer":"A"},{"q":"An 'award' under ID Act means","options":{"A":"Interim or final determination of Industrial Tribunal/Labour Court","B":"Cash prize","C":"Promotion","D":"None"},"answer":"A"},{"q":"Conciliation officers are appointed under","options":{"A":"Section 4","B":"Section 3","C":"Section 7","D":"Section 10"},"answer":"A"},{"q":"Works Committees are required where","options":{"A":"100 or more workmen employed","B":"50 or more","C":"20 or more","D":"1000 or more"},"answer":"A"},{"q":"Grievance Settlement Authority is under","options":{"A":"Section 9C","B":"Section 9A","C":"Section 10","D":"Section 11"},"answer":"A"},{"q":"Notice of change (Section 9A) requires","options":{"A":"21 days notice","B":"30 days","C":"60 days","D":"No notice"},"answer":"A"},{"q":"Strikes in public utility service require notice of","options":{"A":"6 weeks (and within 14 days of last strike notice)","B":"2 weeks","C":"No notice","D":"1 week"},"answer":"A"},{"q":"Public utility services include","options":{"A":"Railways, posts, telegraph, water, electricity","B":"Only railways","C":"IT companies","D":"None"},"answer":"A"},{"q":"Lock-out means","options":{"A":"Temporary closing of place of employment by employer","B":"Permanent closure","C":"Strike","D":"Transfer"},"answer":"A"},{"q":"Illegal strikes are under","options":{"A":"Section 24","B":"Section 22","C":"Section 23","D":"Section 26"},"answer":"A"},{"q":"Penalty for illegal strike/lock-out is","option