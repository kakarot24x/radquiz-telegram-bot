[{"q": "The Employees' Provident Funds Act, 1952 applies to establishments employing at least:", "options": {"A": "10 persons", "B": "50 persons", "C": "20 persons", "D": "100 persons"}, "answer": "C", "i": "q1bllekt1ec2"}, {"q": "The employee's contribution to the Provident Fund is:", "options": {"A": "12% of wages", "B": "8.33% of wages", "C": "15% of wages", "D": "10% of wages"}, "answer": "A", "i": "qu1iv3zppsm"}, {"q": "The employer's 12% contribution is split as:", "options": {"A": "8.33% to pension scheme + 3.67% to PF", "B": "10% PF + 2% insurance", "C": "Entirely to PF", "D": "6% PF + 6% pension"}, "answer": "A", "i": "q2bwtbkwxjti"}, {"q": "The wage ceiling for mandatory EPF coverage is:", "options": {"A": "Rs 21,000 per month", "B": "Rs 25,000 per month", "C": "Rs 15,000 per month", "D": "Rs 6,500 per month"}, "answer": "B", "i": "q28h670cmrp2"}, {"q": "The EDLI Scheme, 1976 provides to PF members:", "options": {"A": "Life insurance linked to PF balance", "B": "Medical benefits", "C": "Housing loan", "D": "Monthly pension"}, "answer": "A", "i": "q1nospq28inc"}, {"q": "The Employees' Pension Scheme, 1995 provides members with:", "options": {"A": "Lump-sum only", "B": "Medical care", "C": "Monthly pension after retirement", "D": "Bonus"}, "answer": "C", "i": "q1r82gk6mpzr"}, {"q": "Minimum pensionable service required under EPS, 1995 is:", "options": {"A": "5 years", "B": "15 years", "C": "10 years", "D": "20 years"}, "answer": "C", "i": "q12x9ilb30l2"}, {"q": "The normal pensionable age under the Employees' Pension Scheme is:", "options": {"A": "60 years", "B": "55 years", "C": "58 years", "D": "62 years"}, "answer": "C", "i": "q1j4gnb1kw22"}, {"q": "UAN stands for:", "options": {"A": "Universal Account Number", "B": "United Account Number", "C": "User Access Number", "D": "Unique Aadhaar Number"}, "answer": "A", "i": "q1llhircpcso"}, {"q": "The UAN allotted to a PF member is:", "options": {"A": "Portable across employments", "B": "Valid for one job only", "C": "Optional", "D": "Changed every year"}, "answer": "A", "i": "qf3c687qjlz"}, {"q": "PF contributions are calculated on:", "options": {"A": "Basic wages plus dearness allowance", "B": "Bonus", "C": "Overtime", "D": "Gross salary"}, "answer": "A", "i": "q1ckojfdsju2"}, {"q": "The employer's contribution towards the EDLI scheme is:", "options": {"A": "12% of wages", "B": "8.33% of wages", "C": "0.5% of wages", "D": "Nil"}, "answer": "C", "i": "qou77n9xp3h"}, {"q": "Interest credited to PF accumulations is:", "options": {"A": "Declared every year by the Government", "B": "Bank savings rate", "C": "Zero", "D": "Fixed at 12%"}, "answer": "A", "i": "q1w6iooglcs6"}, {"q": "Final PF withdrawal on leaving service is claimed in:", "options": {"A": "Form 19", "B": "Form 5", "C": "Form 2", "D": "Form 10C"}, "answer": "A", "i": "qk6pxmzgqgp"}, {"q": "A non-refundable advance from PF is claimed in:", "options": {"A": "Form 19", "B": "Form 10C", "C": "Form 31", "D": "Form 2"}, "answer": "C", "i": "q13a5trnfxrl"}, {"q": "Nomination under the EPF scheme is furnished in:", "options": {"A": "Form 9", "B": "Form 11", "C": "Form 2", "D": "Form 5"}, "answer": "C", "i": "q2aq5ow6dxyh"}, {"q": "A new employee's declaration of PF particulars is given in:", "options": {"A": "Form 19", "B": "Form 31", "C": "Form 2", "D": "Form 11"}, "answer": "D", "i": "q1efb0jzhrti"}, {"q": "Monthly PF contributions with ECR must be remitted by the:", "options": {"A": "30th of next month", "B": "21st of next month", "C": "7th of next month", "D": "15th of the following month"}, "answer": "D", "i": "q1n74lacwl6u"}, {"q": "Delayed remittance of PF dues attracts:", "options": {"A": "A reward", "B": "A holiday", "C": "Nothing", "D": "Damages and interest"}, "answer": "D", "i": "q15a78xkfycr"}, {"q": "Voluntary coverage of an establishment under the EPF Act is possible when:", "options": {"A": "Only Government orders it", "B": "It has 100+ workers", "C": "It can never opt in", "D": "Employer and majority of employees jointly request it"}, "answer": "D", "i": "qxaeccms0px"}, {"q": "An 'excluded employee' under the EPF scheme is one drawing above the ceiling:", "options": {"A": "Never", "B": "After promotion", "C": "After one year of service", "D": "At the time of joining"}, "answer": "D", "i": "qsn96g7koob"}, {"q": "An employee contributing MORE than the statutory 12% to PF:", "options": {"A": "Needs court permission", "B": "Only if employer agrees", "C": "Is prohibited", "D": "May do so voluntarily"}, "answer": "D", "i": "q2amg8w7fgl2"}, {"q": "An employer reducing wages to offset PF liability is:", "options": {"A": "Encouraged", "B": "Optional", "C": "Permitted", "D": "Prohibited"}, "answer": "D", "i": "qko116u66ov"}, {"q": "How many schemes operate under the EPF & MP Act, 1952?", "options": {"A": "Five", "B": "One", "C": "Two", "D": "Three"}, "answer": "D", "i": "qbdpto2f2hc"}, {"q": "For contract labour, the principal employer's PF duty is to:", "options": {"A": "Ensure the contractor remits dues", "B": "Ignore it", "C": "Pay workers directly", "D": "Do nothing"}, "answer": "A", "i": "q1jh4nxp6vkz"}, {"q": "On retirement, a member's PF accumulation is:", "options": {"A": "Half withdrawable", "B": "Forfeited", "C": "Locked forever", "D": "Fully withdrawable"}, "answer": "D", "i": "qq5p6v3obnn"}, {"q": "Partial PF withdrawal is permitted for purposes like:", "options": {"A": "Buying shares", "B": "Car purchase", "C": "Foreign travel", "D": "Housing, medical, education or marriage"}, "answer": "D", "i": "qiqsl8rkpqr"}, {"q": "EPS pension taken early at age 50 is paid with:", "options": {"A": "An increase", "B": "A reduction for early drawal", "C": "No change", "D": "Lump sum only"}, "answer": "B", "i": "q524sh6u5v6"}, {"q": "Administrative charges of the EPF scheme are borne by the:", "options": {"A": "Employee", "B": "Employer", "C": "Government", "D": "Shared equally"}, "answer": "B", "i": "qgg45vfj0o8"}, {"q": "International workers in covered establishments are:", "options": {"A": "Excluded", "B": "Covered from day one", "C": "Covered after 5 years", "D": "Optionally covered"}, "answer": "B", "i": "q3n0h2zavt6"}, {"q": "PF transfer on change of employment is effected through:", "options": {"A": "Cash payment", "B": "UAN-based online transfer", "C": "Cheque", "D": "Demand draft"}, "answer": "B", "i": "q1iujleg1xvg"}, {"q": "EDLI assurance benefit is payable on the member's:", "options": {"A": "Retirement", "B": "Death while in service", "C": "Resignation", "D": "Transfer"}, "answer": "B", "i": "q2g762xdgblf"}, {"q": "Employer's EPS contribution ceases when the member attains age:", "options": {"A": "60", "B": "55", "C": "58", "D": "50"}, "answer": "C", "i": "q14xfm4a3qvb"}, {"q": "Inspectors appointed under the EPF Act are empowered to:", "options": {"A": "Arrest employers", "B": "Inspect records and premises", "C": "Close factories", "D": "Fix wages"}, "answer": "B", "i": "q9ufeu8ds2u"}, {"q": "Appeals against orders under the EPF Act lie to the:", "options": {"A": "Civil Court", "B": "EPF Appellate Tribunal", "C": "High Court directly", "D": "Labour Court"}, "answer": "B", "i": "qmp0svyongc"}, {"q": "For PF purposes, contributions are payable on basic wages plus:", "options": {"A": "Bonus", "B": "Dearness allowance", "C": "Overtime", "D": "Leave encashment"}, "answer": "B", "i": "qm8xl7x9dab"}, {"q": "Wilful non-payment of PF dues by an employer is:", "options": {"A": "A punishable offence", "B": "A purely civil matter", "C": "Ignored", "D": "Rewarded"}, "answer": "A", "i": "qgf2dlt6qxz"}, {"q": "The EPF & MP Act, 1952 extends to:", "options": {"A": "Only cities", "B": "The whole of India", "C": "Only factories", "D": "Only PSUs"}, "answer": "B", "i": "q111f1hmhzuh"}, {"q": "KYC seeding (Aadhaar/bank) of UAN enables:", "options": {"A": "Higher interest", "B": "Online claim settlement", "C": "Lower contribution", "D": "Exemption"}, "answer": "B", "i": "q1wb7hriyyft"}, {"q": "The employee's entire 12% share is credited to the:", "options": {"A": "Pension fund", "B": "Insurance fund", "C": "Provident Fund account", "D": "Admin fund"}, "answer": "C", "i": "q1zz95iowvl0"}]