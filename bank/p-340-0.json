[{"q": "In the present hierarchy, the Controller of Stores is designated as:", "options": {"A": "PCMM (Principal Chief Materials Manager)", "B": "PCEE (Principal Chief Electrical Engineer)", "C": "PCME (Principal Chief Mechanical Engineer)", "D": "PCOM (Principal Chief Operations Manager)"}, "answer": "A", "i": "qugfjb7sd1h"}, {"q": "In the purchase hierarchy, the officer immediately below the PCMM is the:", "options": {"A": "Senior Materials Manager", "B": "Divisional Materials Manager", "C": "Chief Materials Manager", "D": "Deputy Chief Materials Manager"}, "answer": "C", "i": "qlkos2lmo71"}, {"q": "Dy.CMM stands for:", "options": {"A": "District Chief Materials Manager", "B": "Deputy Chief Materials Manager", "C": "Deputy Commercial Materials Manager", "D": "Divisional Chief Materials Manager"}, "answer": "B", "i": "q1kkmur9dzwh"}, {"q": "The purchase organisation at divisional level is headed by the:", "options": {"A": "Chief Depot Officer", "B": "Deputy Chief Materials Manager", "C": "Senior Materials Manager", "D": "Sr.DMM / Divisional Materials Manager"}, "answer": "D", "i": "qda9zu080wx"}, {"q": "The officer in charge of a stores depot is designated the:", "options": {"A": "Depot Officer (CDO / SDO)", "B": "Divisional Engineer", "C": "Assistant Personnel Officer", "D": "Senior Commercial Manager"}, "answer": "A", "i": "q780wv4nj0q"}, {"q": "The Controller of Stores is primarily responsible for:", "options": {"A": "Train operations and traffic control", "B": "Procurement, custody and issue of stores", "C": "Construction of new railway lines", "D": "Passenger ticketing and reservations"}, "answer": "B", "i": "q1ra7pl49n7c"}, {"q": "The COS works in close coordination with the Accounts Department, headed by the:", "options": {"A": "Chief Personnel Officer", "B": "Chief Operations Manager", "C": "FA&CAO (Financial Adviser and Chief Accounts Officer)", "D": "Chief Safety Officer"}, "answer": "C", "i": "q28nc40hev0q"}, {"q": "Which of the following are executive departments that indent on stores?", "options": {"A": "Personnel, Accounts, Commercial and Security", "B": "Audit, Vigilance, Medical and Catering", "C": "Railway Board, RDSO and Metro Railways", "D": "Engineering, Mechanical, Electrical, S&T and Operating"}, "answer": "D", "i": "q21c041n0k3p"}, {"q": "Purchase at railway headquarters is organised under the:", "options": {"A": "COS / PCMM at headquarters", "B": "Divisional Railway Manager", "C": "Chief Commercial Manager", "D": "Senior Divisional Engineer"}, "answer": "A", "i": "q1caf2a85vld"}, {"q": "A Senior Materials Manager (SMM) normally reports to the:", "options": {"A": "Divisional Materials Manager", "B": "Deputy Chief Materials Manager", "C": "Depot Officer", "D": "Assistant Materials Manager"}, "answer": "B", "i": "q1cucnnj589i"}, {"q": "The lowest gazetted officer level in the stores purchase hierarchy is the:", "options": {"A": "Senior Materials Manager", "B": "Divisional Materials Manager", "C": "Deputy Chief Materials Manager", "D": "Assistant Materials Manager"}, "answer": "D", "i": "q1mqmzkmm980"}, {"q": "Material received at a depot is taken on charge through the:", "options": {"A": "Purchase Order", "B": "Stock Sheet", "C": "Material Receipt Note (MRN)", "D": "Indent Form"}, "answer": "C", "i": "q25x2oua1tri"}, {"q": "The safe custody of stores at a depot rests with the:", "options": {"A": "Depot Officer", "B": "Divisional Engineer", "C": "Section Engineer", "D": "Commercial Inspector"}, "answer": "A", "i": "qfzrcpj3op8"}, {"q": "The disposal of surplus and scrap stores is the responsibility of the:", "options": {"A": "Chief Engineer", "B": "Controller of Stores", "C": "Divisional Railway Manager", "D": "Chief Commercial Manager"}, "answer": "B", "i": "q10rln692pv"}, {"q": "Financial concurrence for purchase proposals is given by:", "options": {"A": "The COS alone", "B": "The Railway Board", "C": "The General Manager", "D": "Finance (Accounts Department)"}, "answer": "D", "i": "q1u0bvzmzeeu"}, {"q": "Non-stock (special) items are procured:", "options": {"A": "In bulk for depot storage", "B": "Against rate contracts for stock", "C": "Against specific indents for direct issue", "D": "Through local market purchase only"}, "answer": "C", "i": "q22svcoebv8p"}, {"q": "Procurement of ordinary stock items is based on:", "options": {"A": "Average annual consumption and lead time", "B": "The General Manager's personal orders", "C": "Supplier recommendations alone", "D": "Fixed annual quotas from the Railway Board"}, "answer": "A", "i": "q7mgk8r6hcg"}, {"q": "The Tender Committee functions to assist the:", "options": {"A": "General Manager in staff matters", "B": "COS in deciding tenders", "C": "FA&CAO in budget estimates", "D": "Divisional Railway Manager in train operations"}, "answer": "B", "i": "q16qlh59i235"}, {"q": "Rate contracts for stores items are entered into by the:", "options": {"A": "Divisional Engineer", "B": "Senior Section Engineer", "C": "Depot Store Keeper", "D": "COS / PCMM"}, "answer": "D", "i": "q15wdq6cgkxf"}, {"q": "User departments communicate their stores requirements to the COS through:", "options": {"A": "Indents", "B": "Telegrams to the Railway Board", "C": "Complaint books", "D": "Passenger feedback forms"}, "answer": "A", "i": "q16s9nnajwqn"}, {"q": "At headquarters, the COS organises purchase work through:", "options": {"A": "Divisional offices", "B": "Running rooms", "C": "Purchase sections / groups", "D": "Ticket booking offices"}, "answer": "C", "i": "q86rnktcbe4"}, {"q": "Purchase officers work under the COS in:", "options": {"A": "Depot godowns", "B": "Purchase Sections", "C": "Locomotive sheds", "D": "Station buildings"}, "answer": "B", "i": "qx4gey4oijk"}, {"q": "Physical verification of stock balances is conducted by:", "options": {"A": "The Depot Officer himself", "B": "The purchase officer", "C": "The supplier of the material", "D": "Stock verifiers of the Accounts Department"}, "answer": "D", "i": "qnjrl4k7hsu"}, {"q": "Before disposal, surplus stores are first offered to:", "options": {"A": "Other railways and indentors", "B": "Private scrap dealers directly", "C": "The general public by auction only", "D": "Foreign buyers through export agents"}, "answer": "A", "i": "qp72basdu3f"}, {"q": "Technical specifications for stores items are finalised in consultation with the:", "options": {"A": "Supplier's marketing team", "B": "Railway Board secretariat", "C": "User / executive department", "D": "Accounts Department alone"}, "answer": "C", "i": "q1052ufu3vnb"}, {"q": "The Depot Officer functions under the administrative control of the:", "options": {"A": "Divisional Railway Manager alone", "B": "COS / PCMM", "C": "Chief Commercial Manager", "D": "Chief Medical Director"}, "answer": "B", "i": "qip1cf1xhr2"}, {"q": "Divisional purchase powers are exercised by the:", "options": {"A": "Chief Depot Officer", "B": "Senior Section Engineer", "C": "Assistant Accounts Officer", "D": "Sr.DMM / DMM within delegated powers"}, "answer": "D", "i": "q18caxjxx3xg"}, {"q": "The distinction between HQ purchase and divisional purchase is based on:", "options": {"A": "Value limits and delegation of powers", "B": "The colour of the indent form", "C": "The language of the tender", "D": "The distance of the depot"}, "answer": "A", "i": "q1phsd5vfq3x"}, {"q": "As head of the Stores Department, the COS reports to the:", "options": {"A": "Member of the Railway Board", "B": "Chief Personnel Officer", "C": "General Manager of the railway", "D": "Divisional Railway Manager"}, "answer": "C", "i": "qhxzme6cm2a"}, {"q": "Stores policy at the Railway Board level is coordinated through the:", "options": {"A": "Operating directorate", "B": "Railway Board's stores directorate", "C": "Tourism directorate", "D": "Catering directorate"}, "answer": "B", "i": "qnvh4zt6uf5"}, {"q": "One of the primary duties of the COS is:", "options": {"A": "Running of passenger trains", "B": "Maintenance of track", "C": "Signalling installations", "D": "Procurement of stores"}, "answer": "D", "i": "q1g1o1lxrvmi"}, {"q": "'Materials Management' is the modern term for the functions of the:", "options": {"A": "Stores Department", "B": "Operating Department", "C": "Commercial Department", "D": "Security Department"}, "answer": "A", "i": "q1kjpr5oj4bh"}, {"q": "The purchase organisation at headquarters is headed at the top by the:", "options": {"A": "Deputy Chief Materials Manager", "B": "Senior Materials Manager", "C": "PCMM", "D": "Assistant Materials Manager"}, "answer": "C", "i": "q2e3gunrwd7d"}, {"q": "A Chief Depot Officer (CDO) is in charge of:", "options": {"A": "A railway station", "B": "A stores depot", "C": "A locomotive shed", "D": "A booking office"}, "answer": "B", "i": "q20j7qvonp7s"}, {"q": "Issue of stores from a depot to departments is made against:", "options": {"A": "Verbal requests", "B": "Newspaper advertisements", "C": "Personal letters", "D": "Requisitions"}, "answer": "D", "i": "qdcy77hxl35"}, {"q": "Stores are broadly classified as:", "options": {"A": "Stock items and non-stock items", "B": "Heavy items and light items", "C": "Indian items and imported items", "D": "New items and old items"}, "answer": "A", "i": "q1364uf8tgu7"}, {"q": "Emergency purchases at depot level may be made by the:", "options": {"A": "Station Master", "B": "Ticket Collector", "C": "Depot Officer within delegated powers", "D": "Loco Pilot"}, "answer": "C", "i": "q10hjiado37f"}, {"q": "The COS ensures availability of stores for the:", "options": {"A": "Entertainment of staff", "B": "Maintenance and operation of the railway", "C": "Construction of staff quarters only", "D": "Running of railway schools"}, "answer": "B", "i": "q10aepoq17gd"}, {"q": "Liaison with suppliers for purchase matters is maintained by:", "options": {"A": "Station Masters", "B": "Ticket checking staff", "C": "Running staff", "D": "Purchase officers"}, "answer": "D", "i": "qarjzisvbuo"}, {"q": "Tender schedules for purchase are prepared by the:", "options": {"A": "Purchase section", "B": "Accounts section", "C": "Personnel branch", "D": "Operating control"}, "answer": "A", "i": "q10krn0bx4sw"}, {"q": "Pre-dispatch inspection of purchased material is conducted by:", "options": {"A": "The indenting engineer personally", "B": "The supplier's own staff", "C": "Authorised inspecting agencies", "D": "The station master"}, "answer": "C", "i": "q1u8k4h9pqss"}, {"q": "The COS is responsible for the disposal of:", "options": {"A": "Passenger luggage", "B": "Unserviceable and surplus stores", "C": "Lost property", "D": "Catering waste"}, "answer": "B", "i": "q19dr3de8i30"}, {"q": "A stores depot generally serves the requirements of:", "options": {"A": "One railway station", "B": "One coaching train", "C": "One goods shed", "D": "A division"}, "answer": "D", "i": "q2alaxmfre1u"}, {"q": "The seniority order PCMM > CMM > Dy.CMM > SMM is:", "options": {"A": "The correct descending hierarchy", "B": "The reverse of the actual order", "C": "Applicable only to depots", "D": "Abolished in 1990"}, "answer": "A", "i": "q9izirc7ifj"}, {"q": "DMM stands for:", "options": {"A": "Deputy Mechanical Manager", "B": "District Materials Manager", "C": "Divisional Materials Manager", "D": "Depot Maintenance Manager"}, "answer": "C", "i": "qa71v61jxis"}, {"q": "SMM stands for:", "options": {"A": "Senior Mechanical Manager", "B": "Senior Materials Manager", "C": "Stores Maintenance Manager", "D": "Section Materials Manager"}, "answer": "B", "i": "qy2892151ol"}, {"q": "AMM stands for:", "options": {"A": "Assistant Mechanical Manager", "B": "Additional Materials Manager", "C": "Area Materials Manager", "D": "Assistant Materials Manager"}, "answer": "D", "i": "q1ii3ix86tig"}, {"q": "PCMM stands for:", "options": {"A": "Principal Chief Materials Manager", "B": "Principal Commercial Marketing Manager", "C": "Principal Chief Mechanical Manager", "D": "Principal Civil Maintenance Manager"}, "answer": "A", "i": "qtmkvdxjiua"}, {"q": "The designation 'Controller of Stores' has in the current setup been changed to:", "options": {"A": "Chief Operations Manager", "B": "Chief Personnel Officer", "C": "PCMM", "D": "Chief Safety Officer"}, "answer": "C", "i": "q1iod9nwwl26"}, {"q": "Purchase of items of common use for all railways is coordinated by the:", "options": {"A": "Station Superintendent", "B": "COS in line with Railway Board guidelines", "C": "Chief Ticket Inspector", "D": "Divisional Security Commissioner"}, "answer": "B", "i": "q2b8005kwdl7"}, {"q": "The COS formulates the railway's:", "options": {"A": "Train time table", "B": "Staff seniority lists", "C": "Passenger fare structure", "D": "Purchase policy and procedures"}, "answer": "D", "i": "q2emwp4yoogm"}, {"q": "Stores accounts are maintained at the depot and compiled by:", "options": {"A": "The Accounts Department", "B": "The supplier", "C": "The indentor", "D": "The Railway Board"}, "answer": "A", "i": "qip605su95v"}, {"q": "The cost of stores issued from a depot is debited to the:", "options": {"A": "Supplier's account", "B": "COS personal account", "C": "Consuming department's allocation", "D": "Railway Board's contingency fund"}, "answer": "C", "i": "q1jsh5c11atc"}, {"q": "The COS periodically reviews depot stock levels to avoid:", "options": {"A": "Staff transfers", "B": "Over-stocking and under-stocking", "C": "Train delays", "D": "Ticketless travel"}, "answer": "B", "i": "qxx6iaoite1"}, {"q": "Maximum and minimum limits for stock items are fixed by the:", "options": {"A": "Supplier", "B": "Indentor", "C": "Accounts officer", "D": "COS"}, "answer": "D", "i": "q1jf0iom6m3r"}, {"q": "Procurement planning by the COS is based on:", "options": {"A": "Indents and consumption trends", "B": "Astrological predictions", "C": "Supplier advertisements", "D": "Staff preferences"}, "answer": "A", "i": "q1fkyk2o37yw"}, {"q": "The COS exercises purchase powers that are:", "options": {"A": "Unlimited in all cases", "B": "Shared with the DRM", "C": "Financially delegated to him", "D": "Vested in the supplier"}, "answer": "C", "i": "q1abwcnw86lr"}, {"q": "Coordination meetings between the COS and user departments ensure:", "options": {"A": "Higher ticket revenue", "B": "Timely supply of materials", "C": "Faster train speeds", "D": "More catering contracts"}, "answer": "B", "i": "q58cagrz1dx"}, {"q": "The HQ purchase organisation mainly deals with:", "options": {"A": "Staff grievances", "B": "Passenger complaints", "C": "Lost property", "D": "High-value and bulk purchases"}, "answer": "D", "i": "q2a3c61348h6"}, {"q": "The divisional stores organisation mainly deals with:", "options": {"A": "Day-to-day divisional requirements", "B": "Railway Board policy", "C": "Inter-railway transfers", "D": "Foreign purchases"}, "answer": "A", "i": "q1vey3lg5jue"}, {"q": "The depot officer is primarily responsible for:", "options": {"A": "Train punctuality", "B": "Ticket checking", "C": "Safe custody of stores", "D": "Track maintenance"}, "answer": "C", "i": "q4povsvoqjo"}, {"q": "Receipt, inspection and acceptance of material at the depot are supervised by the:", "options": {"A": "Loco inspector", "B": "Depot Officer", "C": "Guard of the train", "D": "Station master"}, "answer": "B", "i": "q8o4i7rw3uw"}, {"q": "Claims against suppliers for shortages or rejections are preferred by the:", "options": {"A": "Passenger", "B": "Ticket collector", "C": "Running staff", "D": "COS / depot organisation"}, "answer": "D", "i": "qgrxcegg32e"}, {"q": "The COS liaises with other railways for:", "options": {"A": "Transfer of surplus stores", "B": "Exchange of locomotives drivers", "C": "Sharing of ticket revenue", "D": "Joint catering services"}, "answer": "A", "i": "q3s6xz49bkx"}, {"q": "Training of stores staff on procedures is the responsibility of the:", "options": {"A": "Chief Medical Director", "B": "Chief Security Commissioner", "C": "COS", "D": "Chief Public Relations Officer"}, "answer": "C", "i": "q1a0hg7mzflt"}, {"q": "The duties of a purchase officer include:", "options": {"A": "Driving locomotives", "B": "Floating tenders and placing orders", "C": "Checking tickets", "D": "Maintaining signals"}, "answer": "B", "i": "qgk4zfwkc6j"}, {"q": "Purchase orders are placed by the COS on:", "options": {"A": "Any willing shopkeeper", "B": "Relatives of staff", "C": "The lowest bidder without evaluation", "D": "Approved suppliers after tender evaluation"}, "answer": "D", "i": "q1jop52zf5n9"}, {"q": "In all purchases, the COS must ensure:", "options": {"A": "Economy in purchase", "B": "Purchase from a single source", "C": "Maximum possible stock", "D": "Purchase without tenders"}, "answer": "A", "i": "qrwffja1i6c"}, {"q": "The rules governing stores procedures on Indian Railways are contained in the:", "options": {"A": "Indian Railway Establishment Code", "B": "Indian Railway Finance Code", "C": "Indian Railway Stores Code", "D": "Indian Railway Accounts Code"}, "answer": "C", "i": "qmpnam6hu5p"}, {"q": "As head of the Stores Department, the COS is accountable to the:", "options": {"A": "Chief Minister", "B": "General Manager of the railway", "C": "Supplier community", "D": "Comptroller and Auditor General directly"}, "answer": "B", "i": "q1liqmgakyex"}]