[{"q":"Extraordinary pension is governed by?","options":{"A":"Railway Services (Extraordinary Pension) Rules","B":"Pension Rules, 1993","C":"PF Rules","D":"Gratuity Rules"},"answer":"A"},{"q":"Extraordinary pension is admissible when disability or death is?","options":{"A":"Any cause","B":"Attributable to government service","C":"Natural causes","D":"After retirement"},"answer":"B"},{"q":"Disability pension depends mainly on?","options":{"A":"Length of service","B":"Pay drawn","C":"Percentage of disability by medical board","D":"Age"},"answer":"C"},{"q":"For 100% disability attributable to duty, the pensioner gets?","options":{"A":"Half pension","B":"No pension","C":"Gratuity only","D":"Full disability pension"},"answer":"D"},{"q":"Constant Attendance Allowance is meant for?","options":{"A":"100% disabled needing an attendant","B":"All pensioners","C":"50% disabled","D":"Family pensioners"},"answer":"A"},{"q":"Extraordinary family pension compared to ordinary family pension is?","options":{"A":"Same as ordinary","B":"Higher than ordinary","C":"Lower than ordinary","D":"Not paid"},"answer":"B"},{"q":"Extraordinary awards are?","options":{"A":"Flat for all","B":"Random","C":"Graded by circumstances of death","D":"Same as gratuity"},"answer":"C"},{"q":"Death due to enemy action or terrorist attack gets?","options":{"A":"Ordinary pension","B":"No pension","C":"Gratuity only","D":"Liberalized higher awards"},"answer":"D"},{"q":"The medical board assesses?","options":{"A":"Attributability and percentage of disability","B":"Pay fixation","C":"Seniority","D":"Age proof"},"answer":"A"},{"q":"Disability pension is paid?","options":{"A":"Lump sum","B":"Monthly","C":"Yearly","D":"One-time"},"answer":"B"},{"q":"'Attributable to service' means the disability was?","options":{"A":"Any illness","B":"Pre-existing disease","C":"Caused by duty conditions","D":"After retirement"},"answer":"C"},{"q":"A disease aggravated by service is?","options":{"A":"Never covered","B":"Covered partially","C":"Only if fatal","D":"Also treated as attributable"},"answer":"D"},{"q":"Disability pension comprises?","options":{"A":"Service element plus disability element","B":"Only service element","C":"Only disability element","D":"Gratuity plus bonus"},"answer":"A"},{"q":"For partial disability, the disability element is?","options":{"A":"Full in all cases","B":"Proportionate to disability percentage","C":"Nil","D":"Half of service element"},"answer":"B"},{"q":"Constant Attendance Allowance is paid as?","options":{"A":"One-time grant","B":"Yearly payment","C":"Fixed monthly allowance","D":"No such allowance"},"answer":"C"},{"q":"Invalid pension differs from disability pension in that?","options":{"A":"They are the same","B":"Invalid is higher","C":"Neither exists","D":"Invalid is for unfitness; disability needs attributability"},"answer":"D"},{"q":"Is the widow eligible for extraordinary family pension?","options":{"A":"Yes, at higher rates","B":"No","C":"Same as ordinary","D":"One-time only"},"answer":"A"},{"q":"Children under extraordinary pension rules are?","options":{"A":"Not covered","B":"Covered","C":"Only sons","D":"Only daughters"},"answer":"B"},{"q":"Assessment of disability for pension purposes?","options":{"A":"Never","B":"Yearly automatic","C":"Board may reassess on review","D":"By the employee alone"},"answer":"C"},{"q":"If the degree of disability changes later, the pension?","options":{"A":"Unchanged forever","B":"Stopped","C":"Doubled","D":"May be revised"},"answer":"D"},{"q":"Pension for war injury is at?","options":{"A":"Special liberal rates","B":"Ordinary rates","C":"No pension","D":"Gratuity only"},"answer":"A"},{"q":"Higher awards for death in specified circumstances are called?","options":{"A":"Bonus","B":"Liberalized pensionary awards","C":"Ex-gratia","D":"Gratuity"},"answer":"B"},{"q":"Ex-gratia lump sum on death is paid?","options":{"A":"Never","B":"In all deaths","C":"In specified cases","D":"Only after retirement"},"answer":"C"},{"q":"Disability due to the employee's own negligence?","options":{"A":"Always paid","B":"Doubled","C":"Paid as gratuity","D":"May be denied"},"answer":"D"},{"q":"Who decides attributability to service?","options":{"A":"Competent authority on medical advice","B":"The employee","C":"The union","D":"A court"},"answer":"A"},{"q":"Extraordinary pension rules cover events?","options":{"A":"After retirement","B":"While in service","C":"On resignation","D":"On dismissal"},"answer":"B"},{"q":"Disability pension continues?","options":{"A":"For 7 years","B":"Till age 60","C":"For life, subject to conditions","D":"For 15 years"},"answer":"C"},{"q":"After a disability pensioner's death, the family receives?","options":{"A":"Nothing","B":"Gratuity","C":"Refund","D":"Family pension as admissible"},"answer":"D"},{"q":"Service injuries for pension claims should be documented?","options":{"A":"At the time of occurrence","B":"After retirement","C":"By the family later","D":"Not needed"},"answer":"A"},{"q":"Disablement for extraordinary pension is assessed by?","options":{"A":"Self-declaration","B":"Medical board examination","C":"Office memo","D":"Police report"},"answer":"B"}]