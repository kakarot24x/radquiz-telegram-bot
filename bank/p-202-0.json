[{"q": "The two investment approaches in NPS are:", "options": {"A": "Active and Auto choice", "B": "Fixed and floating", "C": "Short and long term", "D": "Equity and debt only"}, "answer": "A", "i": "q2f962m117rl"}, {"q": "In Active choice, the subscriber:", "options": {"A": "Must pick a single fund", "B": "Cannot choose allocation", "C": "Decides allocation across asset classes", "D": "Gets fixed returns"}, "answer": "C", "i": "q3qea3en4le"}, {"q": "Asset class 'E' stands for:", "options": {"A": "Exchange fund", "B": "Emergency fund", "C": "Equity", "D": "Europe fund"}, "answer": "C", "i": "q2c73nefcz8p"}, {"q": "Asset class 'C' stands for:", "options": {"A": "Corporate debt", "B": "Cash", "C": "Commodity", "D": "Currency"}, "answer": "A", "i": "q2g7kqr24oop"}, {"q": "Asset class 'G' stands for:", "options": {"A": "Global fund", "B": "Gold", "C": "Government securities", "D": "Growth fund"}, "answer": "C", "i": "q11vv9r2bfxt"}, {"q": "Maximum equity allocation permitted in Active choice is:", "options": {"A": "25%", "B": "50%", "C": "75%", "D": "100%"}, "answer": "C", "i": "q1zzkq2m0lxi"}, {"q": "Auto choice adjusts asset allocation based on the:", "options": {"A": "Employer", "B": "Market timing", "C": "Subscriber's age", "D": "Salary level"}, "answer": "C", "i": "qvavtivvx58"}, {"q": "Auto choice variants are:", "options": {"A": "LC75, LC50, LC25", "B": "A1, A2, A3", "C": "Gold, Silver, Bronze", "D": "Plan 1, 2, 3"}, "answer": "A", "i": "q1zwtnff7zsw"}, {"q": "As age rises in Auto choice, equity exposure:", "options": {"A": "Becomes 100%", "B": "Rises", "C": "Falls", "D": "Stays the same"}, "answer": "C", "i": "qdubly1oc3t"}, {"q": "Pension Fund Managers for government NPS include:", "options": {"A": "Private banks", "B": "RBI", "C": "Only SBI", "D": "SBI Pension Funds, UTI Retirement Solutions and LIC Pension Fund"}, "answer": "D", "i": "quqeq0kq73d"}, {"q": "A subscriber can change the Pension Fund Manager:", "options": {"A": "Every month", "B": "Only at retirement", "C": "Never", "D": "Once a year"}, "answer": "D", "i": "qko3w8q5gzx"}, {"q": "The investment choice (Active/Auto) can be changed:", "options": {"A": "Once a year", "B": "Daily", "C": "Never", "D": "Only by the employer"}, "answer": "A", "i": "q1dr1sr2wy5p"}, {"q": "NPS NAV is declared:", "options": {"A": "Monthly", "B": "Only at exit", "C": "Yearly", "D": "Daily on business days"}, "answer": "D", "i": "qn488qn6g3t"}, {"q": "Contributions in NPS buy:", "options": {"A": "Bonds directly", "B": "Shares directly", "C": "Fixed deposits", "D": "Units at the applicable NAV"}, "answer": "D", "i": "qphsqz9neb4"}, {"q": "The 'A' asset class covers:", "options": {"A": "Alternate investments like REITs/InvITs, capped at 5%", "B": "Agriculture", "C": "Aviation", "D": "Automobiles"}, "answer": "A", "i": "qyx4yplatlu"}, {"q": "The default scheme for government employees is:", "options": {"A": "Only G-secs", "B": "Chosen by the employer", "C": "100% equity", "D": "Conservative, managed by the three PFMs"}, "answer": "D", "i": "qfcnmyodf0p"}, {"q": "NPS fund management charges are:", "options": {"A": "2% fixed", "B": "5% fixed", "C": "Among the highest", "D": "Among the lowest in the world"}, "answer": "D", "i": "q27ul3lat2gp"}, {"q": "Scheme E invests predominantly in:", "options": {"A": "Gold", "B": "Real estate", "C": "Government bonds", "D": "Equity index funds"}, "answer": "D", "i": "q28v7o75t92l"}, {"q": "Scheme G invests in:", "options": {"A": "Corporate FDs", "B": "Mutual funds", "C": "Equity", "D": "Government securities"}, "answer": "D", "i": "q7t1u8vo5pn"}, {"q": "Scheme C invests in:", "options": {"A": "Corporate debt instruments", "B": "Cash", "C": "Commodities", "D": "Currency"}, "answer": "A", "i": "q8aw2btyq9z"}, {"q": "The NPS Trust's role in investments is:", "options": {"A": "Setting NAV", "B": "Collecting contributions", "C": "Day-to-day trading", "D": "Overseeing PFMs in subscribers' interest"}, "answer": "D", "i": "q263bv5420fb"}, {"q": "PFRDA's role in NPS investments is:", "options": {"A": "Managing the funds", "B": "Paying annuity", "C": "Guaranteeing returns", "D": "Prescribing investment guidelines"}, "answer": "D", "i": "q1hk7gtutanc"}, {"q": "Tier II follows:", "options": {"A": "Only bank deposits", "B": "No investment pattern", "C": "A different PFM", "D": "The same investment choice as selected"}, "answer": "D", "i": "qcycq7z9j0a"}, {"q": "Which is TRUE about NPS?", "options": {"A": "Capital is protected", "B": "RBI insures NPS", "C": "It guarantees 9% returns", "D": "Returns are market-linked and not guaranteed"}, "answer": "D", "i": "q1guj33pqal"}, {"q": "A subscriber can view investments through:", "options": {"A": "CRA online access", "B": "Only the employer", "C": "Newspapers", "D": "It cannot be viewed"}, "answer": "A", "i": "qhw4nwosvfa"}, {"q": "In Auto choice LC75, '75' denotes:", "options": {"A": "75% starting equity up to age 35", "B": "75% debt", "C": "75 schemes", "D": "Exit at age 75"}, "answer": "A", "i": "qhx30wcnlqa"}, {"q": "Rebalancing in Auto choice happens:", "options": {"A": "Manually only", "B": "At exit", "C": "Never", "D": "Automatically with age"}, "answer": "D", "i": "q5ewgcjs2hm"}, {"q": "Switching between Auto and Active choice is:", "options": {"A": "Allowed anytime free of cost", "B": "Only at age 60", "C": "Not allowed", "D": "Allowed once a year"}, "answer": "D", "i": "qb6v3atw64f"}, {"q": "For government subscribers, the default corpus is:", "options": {"A": "Managed by the three PFMs under the default scheme", "B": "Kept as cash", "C": "Invested only in equity", "D": "Held by the employer"}, "answer": "A", "i": "q1075cghmbif"}, {"q": "Charges deducted from the NPS corpus include:", "options": {"A": "CRA and PFM charges", "B": "Income tax", "C": "GST on salary", "D": "Stamp duty"}, "answer": "A", "i": "qk0vfwu589t"}]