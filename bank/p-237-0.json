[{"q": "New Service in financial rules means:", "options": {"A": "Expenditure on a new policy needing fresh funds", "B": "Salary payment", "C": "Refund", "D": "Routine repair"}, "answer": "A", "i": "q52uokk9r7b"}, {"q": "Expenditure on a new service requires approval of:", "options": {"A": "Parliament", "B": "Bank", "C": "Depot keeper", "D": "Vendor"}, "answer": "A", "i": "qevw0m43gcw"}, {"q": "Pending Parliament approval, a new service is provided with a:", "options": {"A": "Token provision", "B": "Double provision", "C": "No provision", "D": "Full cost"}, "answer": "A", "i": "q28wdae4hbfl"}, {"q": "A token demand is usually for:", "options": {"A": "A nominal sum like Re 1", "B": "Zero", "C": "Crores of rupees", "D": "Half the cost"}, "answer": "A", "i": "q1tbgi4nrj0k"}, {"q": "New Instrument of Service means:", "options": {"A": "Small expenditure on an existing service", "B": "Salary", "C": "Pension", "D": "New policy"}, "answer": "A", "i": "q5mfggsf02i"}, {"q": "A new instrument of service is financed through:", "options": {"A": "Re-appropriation within the grant", "B": "Donation", "C": "Parliament vote", "D": "Court order"}, "answer": "A", "i": "qmpjsxokpx1"}, {"q": "Supplementary grants are provided under which Article of the Constitution?", "options": {"A": "Article 115", "B": "Article 370", "C": "Article 21", "D": "Article 32"}, "answer": "A", "i": "q6mecr3nhfe"}, {"q": "Additional funds during the year are sought through:", "options": {"A": "Supplementary demands", "B": "Pass rules", "C": "Time table", "D": "Census"}, "answer": "A", "i": "q1kr7nznzapv"}, {"q": "Expenditure incurred in excess of the grant is regularised by an:", "options": {"A": "Excess grant", "B": "Bonus", "C": "Fine", "D": "Advance"}, "answer": "A", "i": "q14do6bj1sl3"}, {"q": "A token cut in budget discussion is for:", "options": {"A": "Rs 100", "B": "Rs 1000", "C": "Rs 1", "D": "Rs 10"}, "answer": "A", "i": "q1udi163dedz"}, {"q": "A policy cut motion seeks to reduce the demand to:", "opt