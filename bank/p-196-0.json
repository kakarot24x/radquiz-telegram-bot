[{"q": "DCRG stands for?", "options": {"A": "Death-cum-Retirement Gratuity", "B": "Daily Cash Reserve Grant", "C": "Departmental Contributory Retirement Grant", "D": "Dearness Compensatory Relief Grant"}, "answer": "A", "i": "q1nyvzv4ck3s"}, {"q": "Retirement gratuity accrues at what rate?", "options": {"A": "One full month's pay per year", "B": "One-fourth month's emoluments per completed six-monthly period", "C": "Half month's pay per year", "D": "One month per six-monthly period"}, "answer": "B", "i": "q1igxrjotp6j"}, {"q": "What is the maximum ceiling on gratuity amount?", "options": {"A": "₹10 lakh", "B": "₹20 lakh", "C": "₹25 lakh", "D": "₹30 lakh"}, "answer": "C", "i": "qrq6s9qwslc"}, {"q": "'Emoluments' for DCRG computation means?", "options": {"A": "Pay only", "B": "All allowances", "C": "HRA only", "D": "Pay plus dearness allowance"}, "answer": "D", "i": "q10336gopft2"}, {"q": "Death gratuity for service of less than one year is?", "options": {"A": "2 months' emoluments", "B": "6 months' emoluments", "C": "12 months' emoluments", "D": "No gratuity"}, "answer": "A", "i": "q1nxeb32rtfr"}, {"q": "Death gratuity for service between 1 and 5 years is?", "options": {"A": "2 months' emoluments", "B": "6 months' emoluments", "C": "12 months' emoluments", "D": "20 months' emoluments"}, "answer": "B", "i": "q2frwfate6l2"}, {"q": "Death gratuity for service between 5 and 11 years is?", "options": {"A": "6 months' emoluments", "B": "2 months' emoluments", "C": "12 months' emoluments", "D": "20 months' emoluments"}, "answer": "C", "i": "q88c6l8peo3"}, {"q": "Death gratuity for service between 11 and 20 years is?", "options": {"A": "6 months' emoluments", "B": "12 months' emoluments", "C": "33 months' emoluments", "D": "20 months' emoluments"}, "answer": "D", "i": "q2f76naipe2q"}, {"q": "Death gratuity for service beyond 20 years is?", "options": {"A": "Half month's emoluments per completed six-monthly period", "B": "Fixed 20 months", "C": "12 months flat", "D": "One month per year"}, "answer": "A", "i": "q5oksoyi8wo"}, {"q": "DCRG is payable to?", "options": {"A": "Only the spouse", "B": "The nominee or legal heirs", "C": "The government", "D": "The PF office"}, "answer": "B", "i": "q19fmzw3l2i5"}, {"q": "Maximum qualifying service counted for gratuity is?", "options": {"A": "30 years", "B": "35 years", "C": "33 years", "D": "40 years"}, "answer": "C", "i": "qwqtz5mfxhq"}, {"q": "What happens to gratuity on dismissal from service?", "options": {"A": "Paid in full", "B": "Paid half", "C": "Paid after 5 years", "D": "Forfeited on dismissal"}, "answer": "D", "i": "q47f02rtzug"}, {"q": "Nomination for DCRG is recorded in the?", "options": {"A": "Service book", "B": "Bank passbook", "C": "Attendance register", "D": "No record needed"}, "answer": "A", "i": "qsi7d0tdt2p"}, {"q": "If there is no nomination, DCRG goes to?", "options": {"A": "Eldest son gets all", "B": "Family members as per rules", "C": "Lapses to government", "D": "Spouse alone"}, "answer": "B", "i": "qso4wp6g1ii"}, {"q": "Retirement gratuity of a government servant is for tax?", "options": {"A": "Fully taxable", "B": "Taxed at 10%", "C": "Fully exempt for government employees", "D": "Taxed as salary"}, "answer": "C", "i": "q1h45k5115p7"}, {"q": "Death gratuity is payable on?", "options": {"A": "After retirement only", "B": "On voluntary retirement", "C": "On resignation", "D": "On death while in service"}, "answer": "D", "i": "q1sgbwa5p509"}, {"q": "Can a retiree draw both monthly pension and DCRG?", "options": {"A": "Yes, both are admissible", "B": "No, only one", "C": "Only gratuity", "D": "Only pension"}, "answer": "A", "i": "q1p09am3xyzu"}, {"q": "Can DCRG nomination be changed?", "options": {"A": "Never", "B": "Yes, anytime during service", "C": "Only once", "D": "Only at retirement"}, "answer": "B", "i": "q1ye9ln5z5zs"}, {"q": "On resignation from service, gratuity is?", "options": {"A": "Paid in full", "B": "Paid half", "C": "Forfeited", "D": "Paid after 10 years"