signee end is:","options":{"A":"A check inspection; not a second full inspection normally","B":"Prohibited","C":"Done by vendor","D":"Always done fully"},"answer":"A"},{"q":"Test reports of samples are:","options":{"A":"Thrown away","B":"Kept as record of acceptance","C":"Given to vendor","D":"Hidden"},"answer":"B"},{"q":"Performance of suppliers is reviewed through:","options":{"A":"Not reviewed","B":"Horoscope","C":"Delivery, quality and service records","D":"Caste"},"answer":"C"},{"q":"Debarred firms are:","options":{"A":"Promoted","B":"Ignored","C":"Given more orders","D":"Not allowed to participate for a specified period"},"answer":"D"},{"q":"Registration of vendors is done:","options":{"A":"By railways after assessing capacity","B":"By banks","C":"Automatically","D":"By vendors themselves"},"answer":"A"},{"q":"Approved vendor lists are:","options":{"A":"Secret","B":"Maintained and updated periodically","C":"Permanent without review","D":"Made by vendors"},"answer":"B"},{"q":"Development of indigenous sources is:","options":{"A":"Irrelevant","B":"Discouraged","C":"Encouraged to reduce imports","D":"Prohibited"},"answer":"C"},{"q":"Import substitution in stores means:","options":{"A":"Banning vendors","B":"Selling scrap","C":"More imports","D":"Replacing imported items with indigenous ones"},"answer":"D"},{"q":"Standard bid documents for stores tenders ensure:","options":{"A":"Uniformity and transparency","B":"Higher prices","C":"Delays","D":"Confusion"},"answer":"A"},{"q":"E-procurement through IREPS has:","options":{"A":"Increased opacity","B":"Improved transparency and efficiency","C":"Stopped tenders","D":"No effect"},"answer":"B"},{"q":"Digital signatures in e-tenders ensure:","options":{"A":"Nothing","B":"Faster trains","C":"Authenticity of bids","D":"Lower prices"},"answer":"C"},{"q":"Tender evaluation must be:","options":{"A":"Random","B":"Secret from records","C":"Biased","D":"Objective and as per tender conditions"},"answer":"D"},{"q":"The lowest tender is accepted:","options":{"A":"If suitable and rates are reasonable","B":"Never","C":"By lottery","D":"Automatically always"},"answer":"A"},{"q":"If L-1 is technically unsuitable:","options":{"A":"It is still accepted","B":"The next suitable lowest offer is considered","C":"Tender is awarded by draw","D":"Purchase is abandoned always"},"answer":"B"},{"q":"Purchase without tender (PAC/single) needs:","options":{"A":"Staff approval","B":"No justification","C":"Recorded justification and competent sanction","D":"Vendor's request"},"answer":"C"},{"q":"Urgency in purchase must be:","options":{"A":"Created artificially","B":"Ignored","C":"Assumed","D":"Genuine and recorded"},"answer":"D"},{"q":"Stock-out of critical items is avoided by:","options":{"A":"Proper planning and re-order levels","B":"Luck","C":"Blaming vendors","D":"Emergency purchases always"},"answer":"A"},{"q":"Over-stocking is harmful because it:","options":{"A":"Improves service","B":"Blocks capital and increases carrying cost","C":"Reduces staff","D":"Helps vendors"},"answer":"B"},{"q":"Inventory carrying cost includes:","options":{"A":"Nothing","B":"Only purchase price","C":"Interest, storage, insurance and obsolescence","D":"Staff salary only"},"answer":"C"},{"q":"Ordering cost includes:","options":{"A":"Only paper cost","B":"Staff tea","C":"Train fare","D":"Tendering, processing and inspection costs"},"answer":"D"},{"q":"The ultimate aim of the stores tender system is:","options":{"A":"Transparent, competitive procurement at reasonable cost","B":"To delay purchases","C":"To increase paperwork","D":"To favour vendors"},"answer":"A"},{"q":"Ethics in public procurement demand:","options":{"A":"Favouritism","B":"Fairness, transparency and accountability","C":"Secrecy","D":"Cash dealings"},"answer":"B"}]