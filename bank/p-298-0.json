[{"q":"An advertised (open) tender is invited through:","options":{"A":"Word of mouth","B":"Phone calls","C":"Public advertisement on IREPS and press","D":"Private letters"},"answer":"C"},{"q":"A limited tender is invited:","options":{"A":"From one vendor","B":"Without any notice","C":"From the public at large","D":"From a limited number of approved/known vendors"},"answer":"D"},{"q":"A single tender is resorted to when:","options":{"A":"Only one source exists or conditions justify it","B":"For all purchases","C":"To avoid records","D":"Always"},"answer":"A"},{"q":"A global tender is invited for:","options":{"A":"Local stationery","B":"High-value items needing international competition","C":"Scrap sale","D":"Staff hiring"},"answer":"B"},{"q":"NIT stands for:","options":{"A":"Nominal Issue Ticket","B":"National Institute of Technology","C":"Notice Inviting Tender","D":"New Item Trial"},"answer":"C"},{"q":"The tender notice specifies:","options":{"A":"Staff names","B":"Train timings","C":"The vendor's profit","D":"Description, quantity, tender cost, EMD and dates"},"answer":"D"},{"q":"Tender documents are sold/issued:","options":{"A":"On payment of tender cost where prescribed","B":"Only to relatives","C":"After award","D":"Free always"},"answer":"A"},{"q":"The tender box (electronic) closes at:","options":{"A":"Any time","B":"The specified due date and time","C":"When the vendor wishes","D":"After opening"},"answer":"B"},{"q":"Late tenders are:","options":{"A":"Given preference","B":"Accepted with fine","C":"Not considered","D":"Opened first"},"answer":"C"},{"q":"Tender opening is done by:","options":{"A":"The lowest bidder","B":"The guard","C":"A single clerk","D":"The tender opening committee"},"answer":"D"},{"q":"Tenderers or their representatives:","options":{"A":"May witness the tender opening","B":"Open the tenders","C":"Decide the award","D":"Are barred from opening"},"answer":"A"},{"q":"At tender opening, the committee records:","options":{"A":"Only the lowest rate","B":"Rates and details of all valid offers in a comparative statement","C":"Nothing","D":"Vendor's caste"},"answer":"B"},{"q":"Unsigned or incomplete tenders are:","options":{"A":"Accepted","B":"Given preference","C":"Liable to be rejected","D":"Opened last"},"answer":"C"},{"q":"Overwriting in rates without attestation:","options":{"A":"Gets preference","B":"Is encouraged","C":"Is ignored","D":"Can render the offer liable to rejection"},"answer":"D"},{"q":"The validity period of an offer is:","options":{"A":"The period the bidder keeps the offer open, as specified","B":"One day","C":"Decided after award","D":"Not required"},"answer":"A"},{"q":"Withdrawal of offer during validity:","options":{"A":"Is permitted freely","B":"Can lead to forfeiture of EMD","C":"Is encouraged","D":"Has no consequence"},"answer":"B"},{"q":"Extension of validity is sought:","options":{"A":"Never","B":"From the guard","C":"From all tenderers when decision is delayed","D":"Only from the winner"},"answer":"C"},{"q":"The tender committee evaluates:","options":{"A":"Vendor's religion","B":"Nothing","C":"Only the price","D":"Technical suitability, commercial terms and price"},"answer":"D"},{"q":"Technically unsuitable offers are:","options":{"A":"Rejected before price comparison","B":"Given preference","C":"Negotiated first","D":"Accepted if cheap"},"answer":"A"},{"q":"The comparative statement ranks offers by:","options":{"A":"Vendor's age","B":"Evaluated cost to the railway","C":"Alphabetical order","D":"Lottery"},"answer":"B"},{"q":"L-1 in tender evaluation means:","options":{"A":"The local vendor","B":"The last tenderer","C":"The lowest evaluated suitable offer","D":"The longest delivery"},"answer":"C"},{"q":"The TC minutes record:","options":{"A":"Staff gossip","B":"Train timings","C":"Lunch menu","D":"Deliberations, evaluation and recommendations"},"answer":"D"},{"q":"Acceptance of tender is communicated through:","options":{"A":"Letter of acceptance / purchase order","B":"Newspape