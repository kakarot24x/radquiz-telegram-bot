[{"q": "An advertised (open) tender is invited through:", "options": {"A": "Word of mouth", "B": "Phone calls", "C": "Public advertisement on IREPS and press", "D": "Private letters"}, "answer": "C", "i": "q1xsqe3nx9fl"}, {"q": "A limited tender is invited:", "options": {"A": "From one vendor", "B": "Without any notice", "C": "From the public at large", "D": "From a limited number of approved/known vendors"}, "answer": "D", "i": "q2c35i66e0nx"}, {"q": "A single tender is resorted to when:", "options": {"A": "Only one source exists or conditions justify it", "B": "For all purchases", "C": "To avoid records", "D": "Always"}, "answer": "A", "i": "q1usua7z09q6"}, {"q": "A global tender is invited for:", "options": {"A": "Local stationery", "B": "High-value items needing international competition", "C": "Scrap sale", "D": "Staff hiring"}, "answer": "B", "i": "q16pmmz5ucx9"}, {"q": "NIT stands for:", "options": {"A": "Nominal Issue Ticket", "B": "National Institute of Technology", "C": "Notice Inviting Tender", "D": "New Item Trial"}, "answer": "C", "i": "qtr45rp03df"}, {"q": "The tender notice specifies:", "options": {"A": "Staff names", "B": "Train timings", "C": "The vendor's profit", "D": "Description, quantity, tender cost, EMD and dates"}, "answer": "D", "i": "q1uzm64ffvhg"}, {"q": "Tender documents are sold/issued:", "options": {"A": "On payment of tender cost where prescribed", "B": "Only to relatives", "C": "After award", "D": "Free always"}, "answer": "A", "i": "qluohjuvc99"}, {"q": "The tender box (electronic) closes at:", "options": {"A": "Any time", "B": "The specified due date and time", "C": "When the vendor wishes", "D": "After opening"}, "answer": "B", "i": "q1pmto3ux047"}, {"q": "Late tenders are:", "options": {"A": "Given preference", "B": "Accepted with fine", "C": "Not considered", "D": "Opened first"}, "answer": "C", "i": "qni2tsl0fob"}, {"q": "Tender opening is done by:", "options": {"A": "The lowest bidder", "B": "The guard", "C": "A single clerk", "D": "The tender opening committee"}, "answer": "D", "i": "q1pvoz5z0lt7"}, {"q": "Tenderers or their representatives:", "options": {"A": "May witness the tender opening", "B": "Open the tenders", "C": "Decide the award", "D": "Are barred from opening"}, "answer": "A", "i": "q1fwfqaubj6d"}, {"q": "At tender opening, the committee records:", "options": {"A": "Only the lowest rate", "B": "Rates and details of all valid offers in a comparative statement", "C": "Nothing", "D": "Vendor's caste"}, "answer": "B", "i": "q26210uelm9z"}, {"q": "Unsigned or incomplete tenders are:", "options": {"A": "Accepted", "B": "Given preference", "C": "Liable to be rejected", "D": "Opened last"}, "answer": "C", "i": "q1oe5bkfefdu"}, {"q": "Overwriting in rates without attestation:", "options": {"A": "Gets preference", "B": "Is encouraged", "C": "Is ignored", "D": "Can render the offer liable to rejection"}, "answer": "D", "i": "q1cap21gno1r"}, {"q": "The validity period of an offer is:", "options": {"A": "The period the bidder keeps the offer open, as specified", "B": "One day", "C": "Decided after award", "D": "Not required"}, "answer": "A", "i": "qrky4c98z6y"}, {"q": "Withdrawal of offer during validity:", "options": {"A": "Is permitted freely", "B": "Can lead to forfeiture of EMD", "C": "Is encouraged", "D": "Has no consequence"}, "answer": "B", "i": "q12ad8d9yx1w"}, {"q": "Extension of validity is sought:", "options": {"A": "Never", "B": "From the guard", "C": "From all tenderers when decision is delayed", "D": "Only from the winner"}, "answer": "C", "i": "qc6g6vikjev"}, {"q": "The tender committee evaluates:", "options": {"A": "Vendor's religion", "B": "Nothing", "C": "Only the price", "D": "Technical suitability, commercial terms and price"}, "answer": "D", "i": "q1i08x27mtoc"}, {"q": "Technically unsuitable offers are:", "options": {"A": "Rejected before price comparison", "B": "Given preference", "C": "Negotiated first", "D": "Accepted if cheap"}, "answer": "A", "i": "q2fqxkhfg5r9"}, {"q": "The comparative statement ranks offers by:", "options": {"A": "Vendor's age", "B": "Evaluated cost to the railway", "C": "Alphabetical order", "D": "Lottery"}, "answer": "B", "i": "q18n8vqk611x"}, {"q": "L-1 in tender evaluation means:", "options": {"A": "The local vendor", "B": "The last tenderer", "C": "The lowest evaluated suitable offer", "D": "The longest delivery"}, "answer": "C", "i": "q1sf7bh2ti38"}, {"q": "The TC minutes record:", "options": {"A": "Staff gossip", "B": "Train timings", "C": "Lunch menu", "D": "Deliberations, evaluation and recommendations"}, "answer": "D", "i": "q22s4ga36gxt"}, {"q": "Acceptance of tender is communicated through:", "options": {"A": "Letter of acceptance / purchase order", "B": "Newspaper ad", "C": "SMS to staff", "D": "Verbal message"}, "answer": "A", "i": "q27lxzh10z7v"}, {"q": "The accepting authority for tenders is:", "options": {"A": "The lowest bidder", "B": "The competent authority as per Schedule of Powers", "C": "The vendor's agent", "D": "Any clerk"}, "answer": "B", "i": "q2582t1yhz6h"}, {"q": "If rates are considered high, the TC may recommend:", "options": {"A": "Direct purchase at any price", "B": "Acceptance anyway", "C": "Negotiation, counter-offer or re-tendering", "D": "Cancellation of indent"}, "answer": "C", "i": "q1wujf4ju2os"}, {"q": "Re-tendering is ordered when:", "options": {"A": "Always", "B": "The vendor requests", "C": "Rates are reasonable", "D": "No suitable offer is received or rates are unreasonable"}, "answer": "D", "i": "q1cbwsxpy85i"}, {"q": "A single valid offer received against a tender:", "options": {"A": "Is evaluated on merits; acceptance needs justification", "B": "Is ignored", "C": "Is automatically rejected", "D": "Is automatically accepted"}, "answer": "A", "i": "q16uk51fftun"}, {"q": "Splitting of tendered quantity is resorted to:", "options": {"A": "To punish L-1", "B": "To ensure supply security as per tender conditions", "C": "Arbitrarily", "D": "Never"}, "answer": "B", "i": "q1r4jmwv0heu"}, {"q": "The option clause in tenders allows:", "options": {"A": "Cancellation free", "B": "Delay freely", "C": "The railway to increase/decrease quantity within limits", "D": "The vendor to change price"}, "answer": "C", "i": "qep57hzyali"}, {"q": "Fall clause in rate contracts protects against:", "options": {"A": "Quality issues", "B": "Delay", "C": "Price rise", "D": "The vendor selling cheaper to others during the contract"}, "answer": "D", "i": "qbgmro984fr"}, {"q": "Earnest Money Deposit is generally:", "options": {"A": "A percentage of the estimated value as specified", "B": "Equal to the contract value", "C": "A fixed one rupee", "D": "Not required"}, "answer": "A", "i": "q1icbn9d19z8"}, {"q": "Tender cost (document price) is:", "options": {"A": "Refunded always", "B": "Non-refundable charge for tender documents", "C": "Equal to EMD", "D": "Paid to the winner"}, "answer": "B", "i": "qurr2ihgi7m"}, {"q": "Small Scale / MSE units get EMD exemption:", "options": {"A": "Only for scrap", "B": "Never", "C": "As per government policy on production of proof", "D": "Automatically without proof"}, "answer": "C", "i": "q2anbs83sduy"}, {"q": "Security Deposit is collected:", "options": {"A": "From all bidders", "B": "Never", "C": "Before tender", "D": "From the successful tenderer as contract security"}, "answer": "D", "i": "q1q83jvwqj2p"}, {"q": "Security Deposit is released:", "options": {"A": "After satisfactory completion of the contract", "B": "Never", "C": "To the lowest bidder", "D": "Immediately on award"}, "answer": "A", "i": "qmtg8ncq2xa"}, {"q": "Liquidated damages for delayed supply are generally:", "options": {"A": "Unlimited", "B": "A specified percentage per week, subject to a maximum", "C": "Not leviable", "D": "Decided by the vendor"}, "answer": "B", "i": "q2g8fm2it7yb"}, {"q": "Extension of delivery with LD is granted:", "options": {"A": "By the vendor himself", "B": "Automatically", "C": "On the supplier's request judged on merits", "D": "Never"}, "answer": "C", "i": "q1p7enqm9ctd"}, {"q": "Denial clause in delivery extension means:", "options": {"A": "Denying payment", "B": "Denying inspection", "C": "Denying the extension", "D": "The supplier gets no benefit of price increase during extended period"}, "answer": "D", "i": "qjcnesm5wgq"}, {"q": "Risk purchase at the defaulter's cost needs:", "options": {"A": "Notice to the defaulting supplier", "B": "Vendor's permission", "C": "Court order", "D": "No notice"}, "answer": "A", "i": "q22976nbuv15"}, {"q": "The extra cost of risk purchase is:", "options": {"A": "Borne by the railway", "B": "Recovered from the defaulting supplier", "C": "Written off silently", "D": "Paid by staff"}, "answer": "B", "i": "q1nipf2at8yq"}, {"q": "Cancellation of contract for default needs:", "options": {"A": "Vendor's consent", "B": "No notice", "C": "Notice and opportunity as per contract", "D": "Staff vote"}, "answer": "C", "i": "qalq4ebhmnu"}, {"q": "Arbitration in purchase disputes is:", "options": {"A": "Decided by the vendor", "B": "Only in courts", "C": "Not available", "D": "As per the arbitration clause of the contract"}, "answer": "D", "i": "qn0few6zs79"}, {"q": "Jurisdiction clause specifies:", "options": {"A": "The courts having jurisdiction over disputes", "B": "No courts", "C": "Foreign courts", "D": "The vendor's home"}, "answer": "A", "i": "q18bm5w43nrq"}, {"q": "Inspection by RITES is:", "options": {"A": "Optional always", "B": "As stipulated in the purchase order", "C": "Done by railways only", "D": "Not recognized"}, "answer": "B", "i": "q26lmpcf90q"}, {"q": "Inspection fee is borne:", "options": {"A": "Never paid", "B": "Always by the railway", "C": "As per contract terms", "D": "By the guard"}, "answer": "C", "i": "q1ipck9caghb"}, {"q": "Consignee inspection is done:", "options": {"A": "Never", "B": "At the vendor's home", "C": "Before despatch", "D": "After receipt at the consignee's end"}, "answer": "D", "i": "q2d3d6tvgild"}, {"q": "Stores not found as per specification on consignee inspection:", "options": {"A": "Are rejected and reported", "B": "Are hidden", "C": "Are used anyway", "D": "Are accepted"}, "answer": "A", "i": "q1px5s2z4120"}, {"q": "Warranty claims are lodged:", "options": {"A": "After warranty expires", "B": "Within the warranty period", "C": "Never", "D": "Verbally only"}, "answer": "B", "i": "q21auur5gh2w"}, {"q": "Payment terms in tenders are:", "options": {"A": "Decided by vendor", "B": "100% advance always", "C": "As per tender conditions, usually after acceptance", "D": "In cash"}, "answer": "C", "i": "q12kmslxv49a"}, {"q": "Part payment against despatch documents is:", "options": {"A": "Always 100%", "B": "In foreign currency", "C": "Never allowed", "D": "Allowed where tender conditions provide"}, "answer": "D", "i": "q2930mdty9dx"}, {"q": "Retention money is:", "options": {"A": "A percentage withheld till warranty/satisfactory performance", "B": "A bribe", "C": "Tender cost", "D": "A bonus"}, "answer": "A", "i": "q1gcfda6i5o5"}, {"q": "Price preference to domestic bidders in global tenders is:", "options": {"A": "Prohibited", "B": "As per government policy", "C": "Always 50%", "D": "Decided by vendor"}, "answer": "B", "i": "q2g7itmx36pz"}, {"q": "Tender evaluation considers taxes:", "options": {"A": "Never", "B": "By ignoring them", "C": "On the basis of total landed cost as per conditions", "D": "Separately always"}, "answer": "C", "i": "q13etnkfb1on"}, {"q": "Conditional offers in tenders are:", "options": {"A": "Given preference", "B": "Ignored", "C": "Always accepted", "D": "Evaluated; conditions affecting price/comparability are loaded or rejected"}, "answer": "D", "i": "q86hiz5immg"}, {"q": "Alternative offers from a tenderer are:", "options": {"A": "Considered if the tender permits", "B": "Given preference", "C": "Not opened", "D": "Always rejected"}, "answer": "A", "i": "q25jykli4fy6"}, {"q": "Rebate offered in a tender is:", "options": {"A": "Ignored", "B": "Considered in evaluation as per conditions", "C": "A bribe", "D": "Added to price"}, "answer": "B", "i": "q7eaheirrgx"}, {"q": "Discount for prompt payment:", "options": {"A": "Is illegal", "B": "Is never considered", "C": "Is evaluated if the tender provides", "D": "Is mandatory"}, "answer": "C", "i": "q1nprttebc3m"}, {"q": "The tender committee may call tenderers for:", "options": {"A": "Bribes", "B": "Employment", "C": "Lunch", "D": "Clarifications on their offers"}, "answer": "D", "i": "ql8eppifxwe"}, {"q": "Post-tender modifications by bidders are:", "options": {"A": "Not permitted except clarifications", "B": "Encouraged", "C": "Mandatory", "D": "Freely allowed"}, "answer": "A", "i": "qoaxumcmlyg"}, {"q": "Canvassing by tenderers leads to:", "options": {"A": "Preference", "B": "Rejection of the offer", "C": "Negotiation", "D": "Award"}, "answer": "B", "i": "qeiq8o1eoha"}, {"q": "Collusive tendering (cartel) is:", "options": {"A": "Ignored", "B": "Encouraged", "C": "Dealt with as per rules; offers may be rejected", "D": "Rewarded"}, "answer": "C", "i": "q1zd5gyxa14m"}, {"q": "A tender committee with finance member is required:", "options": {"A": "For stationery only", "B": "Always regardless of value", "C": "Never", "D": "As per SOP thresholds for the value involved"}, "answer": "D", "i": "q23ru9ajd8b9"}, {"q": "Acceptance of tender at higher than estimated cost needs:", "options": {"A": "Justification and competent authority approval", "B": "Vendor's approval", "C": "Staff consent", "D": "No justification"}, "answer": "A", "i": "qx6pyy8a7n1"}, {"q": "The letter of acceptance creates:", "options": {"A": "Nothing", "B": "A binding contract between railway and supplier", "C": "An invitation", "D": "A complaint"}, "answer": "B", "i": "q20joo80fxrg"}, {"q": "Supply orders against rate contracts are placed:", "options": {"A": "By the vendor", "B": "Without any formality", "C": "Directly on the rate contract holder", "D": "Through fresh tender"}, "answer": "C", "i": "qxr1up8n256"}, {"q": "Delivery schedule in the purchase order is:", "options": {"A": "Optional", "B": "Decided later", "C": "Advisory", "D": "Binding, with LD for delay"}, "answer": "D", "i": "q17fbcm9677o"}, {"q": "Staggered delivery means:", "options": {"A": "Delivery in instalments as scheduled", "B": "One-time delivery", "C": "Delivery by air", "D": "No delivery"}, "answer": "A", "i": "q1cfowwh6jqv"}, {"q": "Consignee is:", "options": {"A": "The vendor", "B": "The railway officer/depot to whom stores are despatched", "C": "The bank", "D": "The auditor"}, "answer": "B", "i": "q1hlzt3lz0r7"}, {"q": "RR (Railway Receipt) is used for:", "options": {"A": "Tender fee", "B": "Passenger travel", "C": "Taking delivery of consigned goods", "D": "Staff salary"}, "answer": "C", "i": "q1uc795oww3y"}, {"q": "Demurrage on consignments is:", "options": {"A": "A discount", "B": "Salary", "C": "A reward", "D": "Charge for detention of wagons beyond free time"}, "answer": "D", "i": "q1m81cxwoywj"}, {"q": "Wharfage is:", "options": {"A": "Charge for detention of goods beyond free time", "B": "A tax", "C": "A salary", "D": "A tip"}, "answer": "A", "i": "q1a587lgg71z"}, {"q": "Shortage/damage in transit is claimed from:", "options": {"A": "The station master personally", "B": "The carrier or supplier as per terms", "C": "Passengers", "D": "Nobody"}, "answer": "B", "i": "qdj228jjgob"}, {"q": "Open delivery of suspected damaged consignment is:", "options": {"A": "Accepted blindly", "B": "Prohibited", "C": "Taken in presence of railway staff with remarks", "D": "Refused always"}, "answer": "C", "i": "q1zdjx29lrjt"}, {"q": "Packing of stores for despatch should be:", "options": {"A": "Decorative", "B": "Absent", "C": "Weak", "D": "Adequate to prevent damage in transit"}, "answer": "D", "i": "qzepxnme35"}, {"q": "Marking of packages includes:", "options": {"A": "Consignee, PO number and item details", "B": "Nothing", "C": "Poems", "D": "Vendor's horoscope"}, "answer": "A", "i": "q1iy2wfppyd2"}, {"q": "Despatch particulars are intimated to the consignee through:", "options": {"A": "Gossip", "B": "RR and advice notes", "C": "Newspaper", "D": "Dreams"}, "answer": "B", "i": "qw30kikt9vz"}, {"q": "Inspection note is issued by:", "options": {"A": "The station master", "B": "The vendor", "C": "The inspecting agency after inspection", "D": "The guard"}, "answer": "C", "i": "q25rfs2cghjc"}, {"q": "Stores with inspection note are:", "options": {"A": "Sent back", "B": "Auctioned", "C": "Rejected", "D": "Accepted by the consignee subject to verification"}, "answer": "D", "i": "q1d9zzrmvorr"}, {"q": "Duplicate inspection at consignee end is:", "options": {"A": "A check inspection; not a second full inspection normally", "B": "Prohibited", "C": "Done by vendor", "D": "Always done fully"}, "answer": "A", "i": "qkmrqd12prs"}, {"q": "Test reports of samples are:", "options": {"A": "Thrown away", "B": "Kept as record of acceptance", "C": "Given to vendor", "D": "Hidden"}, "answer": "B", "i": "q262ppgmsy9k"}, {"q": "Performance of suppliers is reviewed through:", "options": {"A": "Not reviewed", "B": "Horoscope", "C": "Delivery, quality and service records", "D": "Caste"}, "answer": "C", "i": "q1a0lrug4gd"}, {"q": "Debarred firms are:", "options": {"A": "Promoted", "B": "Ignored", "C": "Given more orders", "D": "Not allowed to participate for a specified period"}, "answer": "D", "i": "q1r8y7g54een"}, {"q": "Registration of vendors is done:", "options": {"A": "By railways after assessing capacity", "B": "By banks", "C": "Automatically", "D": "By vendors themselves"}, "answer": "A", "i": "q1251p79cu8i"}, {"q": "Approved vendor lists are:", "options": {"A": "Secret", "B": "Maintained and updated periodically", "C": "Permanent without review", "D": "Made by vendors"}, "answer": "B", "i": "qt4jwes2oaq"}, {"q": "Development of indigenous sources is:", "options": {"A": "Irrelevant", "B": "Discouraged", "C": "Encouraged to reduce imports", "D": "Prohibited"}, "answer": "C", "i": "qnnq6930rkp"}, {"q": "Import substitution in stores means:", "options": {"A": "Banning vendors", "B": "Selling scrap", "C": "More imports", "D": "Replacing imported items with indigenous ones"}, "answer": "D", "i": "q2k7yd0gduu"}, {"q": "Standard bid documents for stores tenders ensure:", "options": {"A": "Uniformity and transparency", "B": "Higher prices", "C": "Delays", "D": "Confusion"}, "answer": "A", "i": "q1blf9iglbaq"}, {"q": "E-procurement through IREPS has:", "options": {"A": "Increased opacity", "B": "Improved transparency and efficiency", "C": "Stopped tenders", "D": "No effect"}, "answer": "B", "i": "qayq3qrdctb"}, {"q": "Digital signatures in e-tenders ensure:", "options": {"A": "Nothing", "B": "Faster trains", "C": "Authenticity of bids", "D": "Lower prices"}, "answer": "C", "i": "q1cuhilglf47"}, {"q": "Tender evaluation must be:", "options": {"A": "Random", "B": "Secret from records", "C": "Biased", "D": "Objective and as per tender conditions"}, "answer": "D", "i": "q1g8oqqhky6i"}, {"q": "The lowest tender is accepted:", "options": {"A": "If suitable and rates are reasonable", "B": "Never", "C": "By lottery", "D": "Automatically always"}, "answer": "A", "i": "q1xaumpljsda"}, {"q": "If L-1 is technically unsuitable:", "options": {"A": "It is still accepted", "B": "The next suitable lowest offer is considered", "C": "Tender is awarded by draw", "D": "Purchase is abandoned always"}, "answer": "B", "i": "qgptagq3gj5"}, {"q": "Purchase without tender (PAC/single) needs:", "options": {"A": "Staff approval", "B": "No justification", "C": "Recorded justification and competent sanction", "D": "Vendor's request"}, "answer": "C", "i": "q1uzzn2awaje"}, {"q": "Urgency in purchase must be:", "options": {"A": "Created artificially", "B": "Ignored", "C": "Assumed", "D": "Genuine and recorded"}, "answer": "D", "i": "q1wfl2p9wm5x"}, {"q": "Stock-out of critical items is avoided by:", "options": {"A": "Proper planning and re-order levels", "B": "Luck", "C": "Blaming vendors", "D": "Emergency purchases always"}, "answer": "A", "i": "q183sgnjinms"}, {"q": "Over-stocking is harmful because it:", "options": {"A": "Improves service", "B": "Blocks capital and increases carrying cost", "C": "Reduces staff", "D": "Helps vendors"}, "answer": "B", "i": "q1wdn0ep5ge0"}, {"q": "Inventory carrying cost includes:", "options": {"A": "Nothing", "B": "Only purchase price", "C": "Interest, storage, insurance and obsolescence", "D": "Staff salary only"}, "answer": "C", "i": "q113ghwmixfp"}, {"q": "Ordering cost includes:", "options": {"A": "Only paper cost", "B": "Staff tea", "C": "Train fare", "D": "Tendering, processing and inspection costs"}, "answer": "D", "i": "q2d1kjngdpr5"}, {"q": "The ultimate aim of the stores tender system is:", "options": {"A": "Transparent, competitive procurement at reasonable cost", "B": "To delay purchases", "C": "To increase paperwork", "D": "To favour vendors"}, "answer": "A", "i": "q227d9477rmd"}, {"q": "Ethics in public procurement demand:", "options": {"A": "Favouritism", "B": "Fairness, transparency and accountability", "C": "Secrecy", "D": "Cash dealings"}, "answer": "B", "i": "q27ktsl2mq4c"}]