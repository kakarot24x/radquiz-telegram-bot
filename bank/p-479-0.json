[{"q":"Inspection differs from audit mainly because inspection is:","options":{"A":"Conducted by outsiders","B":"An executive function of the department itself","C":"Reported to Parliament","D":"Done by the CAG"},"answer":"B"},{"q":"Audit may be described as:","options":{"A":"A social gathering","B":"A training course","C":"Independent examination of accounts and transactions","D":"A construction activity"},"answer":"C"},{"q":"Statutory audit of railway accounts in India is conducted by:","options":{"A":"The Comptroller and Auditor General of India","B":"The Railway Minister","C":"The FA&CAO","D":"The Divisional Railway Manager"},"answer":"A"},{"q":"In each zonal railway, audit on behalf of the CAG is conducted by:","options":{"A":"The chief commercial manager","B":"The FA&CAO","C":"The divisional engineer","D":"The Principal Director of Audit"},"answer":"D"},{"q":"Inspection of accounts offices is carried out by:","options":{"A":"The audit department","B":"The accounts department itself","C":"The Parliament","D":"The courts"},"answer":"B"},{"q":"Audit is independent of:","options":{"A":"The executive whose accounts are audited","B":"All laws","C":"The Constitution","D":"Financial rules"},"answer":"A"},{"q":"Internal check means:","options":{"A":"Checking by the police","B":"Checking by passengers","C":"Checking by the media","D":"Check exercised within the department before a transaction is completed"},"answer":"D"},{"q":"Pre-check of bills before payment is exercised by:","options":{"A":"The CAG","B":"The Public Accounts Committee","C":"The accounts office","D":"The Parliament"},"answer":"C"},{"q":"Concurrent audit is audit that is:","options":{"A":"Done after ten years","B":"Conducted simultaneously with the transactions","C":"Done by the inspected office","D":"Never reported"},"answer":"B"},{"q":"Audit notes are issued by:","options":{"A":"The audit office","B":"The inspected clerk","C":"The contractor","D":"The passenger association"},"answer":"A"},{"q":"Inspection reports are issued by:","options":{"A":"The CAG","B":"The Parliament","C":"The Public Accounts Committee","D":"The inspecting officer of the accounts department"},"answer":"D"},{"q":"Audit examines transactions with regard to:","options":{"A":"Train speeds","B":"Catering taste","C":"Regularity, legality and propriety","D":"Uniform colours"},"answer":"C"},{"q":"Inspection primarily checks:","options":{"A":"Parliamentary debates","B":"Observance of rules and efficiency of offices","C":"Election results","D":"Weather conditions"},"answer":"B"},{"q":"Important audit findings may appear in:","options":{"A":"The CAG's report on Railways","B":"A film magazine","C":"A railway timetable","D":"A menu card"},"answer":"A"},{"q":"Inspection findings are settled:","options":{"A":"In Parliament","B":"In courts","C":"Within the department","D":"By the media"},"answer":"C"},{"q":"Audit objections may ultimately lead to scrutiny by:","options":{"A":"Film critics","B":"Sports bodies","C":"Trade unions","D":"The Public Accounts Committee"},"answer":"D"},{"q":"The Public Accounts Committee examines:","options":{"A":"Train timetables","B":"The audit reports of the CAG","C":"Catering menus","D":"Staff uniforms"},"answer":"B"},{"q":"The role of the Accounts department includes:","options":{"A":"Maintaining accounts and exercising internal check","B":"Conducting statutory audit","C":"Passing the railway budget","D":"Appointing the CAG"},"answer":"A"},{"q":"The role of Audit includes:","options":{"A":"Maintaining ledgers","B":"Passing bills","C":"Collecting fares","D":"Independently examining and reporting on the accounts"},"answer":"D"},{"q":"The Accounts department is a part of:","options":{"A":"The judiciary","B":"The legislature","C":"The executive","D":"The press"},"answer":"C"},{"q":"Audit is:","options":{"A":"A part of the spending departments","B":"External to the executive","C":"A commercial activity","D":"A construction wing"},"answer":"B"},{"q":"Separation of audit from accounts is intended to ensure:","options":{"A":"Independence of audit","B":"Higher fares","C":"More staff","D":"Faster trains"},"answer":"A"},{"q":"Unlike audit, inspection does not:","options":{"A":"Visit offices","B":"Check records","C":"Raise objections","D":"Report independently to the legislature"},"answer":"D"},{"q":"Audit can comment on:","options":{"A":"Train liveries","B":"Film songs","C":"Wasteful or infructuous expenditure","D":"Cricket matches"},"answer":"C"},{"q":"Inspection is in nature:","options":{"A":"Judicial","B":"Administrative","C":"Legislative","D":"Military"},"answer":"B"},{"q":"Statutory audit derives its authority from:","options":{"A":"The Constitution and the law","B":"Departmental circulars","C":"Newspaper editorials","D":"Staff demands"},"answer":"A"},{"q":"Test check is a technique used by:","options":{"A":"Neither inspection nor audit","B":"Only inspection","C":"Only audit","D":"Both inspection and audit"},"answer":"D"},{"q":"While inspection reports remain internal, audit reports are:","options":{"A":"Destroyed","B":"Kept secret forever","C":"Laid before Parliament","D":"Sold in markets"},"answer":"C"},{"q":"Audit examines whether expenditure was:","options":{"A":"Incurred under proper sanction and authority","B":"Popular with staff","C":"Reported in newspapers","D":"Paid in cash"},"answer":"A"},{"q":"Internal check prevents errors by:","options":{"A":"Punishing staff","B":"Checking transactions before they are completed","C":"Hiding mistakes","D":"Delaying payments"},"answer":"B"},{"q":"Which operates continuously on a day-to-day basis:","options":{"A":"Statutory audit","B":"Parliamentary review","C":"The CAG's report","D":"Internal check"},"answer":"D"},{"q":"Statutory audit is usually:","options":{"A":"Concurrent with every payment","B":"Done by the cashier","C":"Periodic and conducted after transactions","D":"A secret activity"},"answer":"C"},{"q":"Concurrent audit combines:","options":{"A":"Cooking and cleaning","B":"Timeliness of concurrent checking with independence of audit","C":"Inspection and construction","D":"Audit and catering"},"answer":"B"},{"q":"Inspection tours are planned by:","options":{"A":"The accounts department","B":"The audit department","C":"The Parliament","D":"The courts"},"answer":"A"},{"q":"Audit programmes are planned by:","options":{"A":"The FA&CAO","B":"The inspected office","C":"The contractors","D":"The audit office"},"answer":"D"},{"q":"An inspecting officer is answerable to:","options":{"A":"The CAG","B":"The Parliament","C":"The FA&CAO","D":"The press"},"answer":"C"},{"q":"The railway audit officer is answerable to:","options":{"A":"The FA&CAO","B":"The CAG through the audit hierarchy","C":"The DRM","D":"The contractors"},"answer":"B"},{"q":"Inspection can usefully suggest:","options":{"A":"Improvements in office procedure","B":"New train services","C":"Fare increases","D":"Election dates"},"answer":"A"},{"q":"Audit can point out:","options":{"A":"Good monsoons","B":"Cricket scores","C":"Film hits","D":"Cases of loss, waste or procedural lapse"},"answer":"D"},{"q":"Inspection reports generally:","options":{"A":"Are published as books","B":"Are debated in Parliament","C":"Do not become public documents","D":"Are sold to passengers"},"answer":"C"},{"q":"Audit reports of the CAG are:","options":{"A":"Secret forever","B":"Public documents laid before Parliament","C":"Destroyed yearly","D":"Written in code"},"answer":"B"},{"q":"Objections raised by inspection are settled through:","options":{"A":"Departmental action and compliance","B":"Court cases always","C":"Strikes","D":"Elections"},"answer":"A"},{"q":"Audit objections require:","options":{"A":"No reply","B":"Replies only from clerks","C":"Newspaper replies","D":"Formal replies from the railway administration"},"answer":"D"},{"q":"A draft audit para is issued to:","options":{"A":"Passengers","B":"Contractors","C":"The Ministry of Railways","D":"Film producers"},"answer":"C"},{"q":"Inspection is a tool of:","options":{"A":"Legislative control","B":"Management control","C":"Judicial control","D":"Media control"},"answer":"B"},{"q":"Audit is a tool of:","options":{"A":"Legislative and parliamentary control over the executive","B":"Ticket checking","C":"Train driving","D":"Catering"},"answer":"A"},{"q":"Both inspection and audit ultimately aim at:","options":{"A":"Reducing staff","B":"Closing offices","C":"Increasing fares","D":"Proper utilization of public money"},"answer":"D"},{"q":"Internal check is exercised through:","options":{"A":"Surprise raids by police","B":"Media reports","C":"Pre-check of bills, vouchers and payments","D":"Public meetings"},"answer":"C"},{"q":"The Accounts department compiles:","options":{"A":"Train timetables","B":"The appropriation and finance accounts","C":"Cricket fixtures","D":"Film scripts"},"answer":"B"},{"q":"The CAG:","options":{"A":"Certifies the finance and appropriation accounts","B":"Prepares the railway budget","C":"Drives trains","D":"Sells tickets"},"answer":"A"},{"q":"Inspection verifies the balances of:","options":{"A":"Only one office","B":"Passengers' luggage","C":"Bank lockers","D":"Subordinate offices during periodical visits"},"answer":"D"},{"q":"Audit verifies that the accounts:","options":{"A":"Are beautifully bound","B":"Use costly paper","C":"Are free from material misstatement","D":"Are written in verse"},"answer":"C"},{"q":"Inspection staff belongs to:","options":{"A":"The Indian Audit and Accounts Department","B":"The railway accounts organization","C":"The Parliament secretariat","D":"The judiciary"},"answer":"B"},{"q":"Audit staff belongs to:","options":{"A":"The Indian Audit and Accounts Department","B":"The commercial department","C":"The operating department","D":"The medical department"},"answer":"A"},{"q":"The inspecting officer checks compliance with:","options":{"A":"Road traffic rules","B":"City building bylaws","C":"Film certification norms","D":"Financial rules and departmental orders"},"answer":"D"},{"q":"The auditor checks compliance with:","options":{"A":"Fashion trends","B":"Recipes","C":"Laws, rules, sanctions and canons of financial propriety","D":"Sports rules"},"answer":"C"},{"q":"Inspection findings may be useful to audit in:","options":{"A":"Cooking","B":"Planning the scope of audit","C":"Driving trains","D":"Selling tickets"},"answer":"B"},{"q":"A key difference is that inspection reports to management while audit reports to:","options":{"A":"The legislature","B":"The contractors","C":"The passengers","D":"The staff union"},"answer":"A"},{"q":"The power of independent reporting rests with:","options":{"A":"Inspection","B":"Internal check","C":"The cashier","D":"Audit"},"answer":"D"},{"q":"In short, inspection is internal and departmental, while audit is:","options":{"A":"A social event","B":"A construction method","C":"Independent and external to the executive","D":"A catering service"},"answer":"C"}]