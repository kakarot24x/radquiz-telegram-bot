[{"q": "The 7th CPC pay matrix has levels", "options": {"A": "1 to 18", "B": "1 to 10", "C": "1 to 40", "D": "A to Z"}, "answer": "A", "i": "q14kxl3c3t3o"}, {"q": "Minimum pay under the 7th CPC is", "options": {"A": "Rs 7,000", "B": "Rs 18,000", "C": "Rs 10,000", "D": "Rs 25,000"}, "answer": "B", "i": "qwkcn26zf5z"}, {"q": "Maximum pay under the 7th CPC is", "options": {"A": "Rs 1,00,000", "B": "Rs 5,00,000", "C": "Rs 2,50,000", "D": "Rs 80,000"}, "answer": "C", "i": "q2g2s54jzvfj"}, {"q": "The fitment factor applied in the 7th CPC is", "options": {"A": "1.86", "B": "3.00", "C": "2.00", "D": "2.57"}, "answer": "D", "i": "q1jdyyjtgxux"}, {"q": "The 7th CPC pay was implemented from", "options": {"A": "1.1.2016", "B": "1.1.2021", "C": "1.1.2011", "D": "1.1.2006"}, "answer": "A", "i": "qconaugrkqw"}, {"q": "Annual increment under the 7th CPC is", "options": {"A": "5% of basic pay", "B": "3% of basic pay", "C": "10% of basic pay", "D": "1% of basic pay"}, "answer": "B", "i": "q2darntva9u7"}, {"q": "The dates of next increment (DNI) are", "options": {"A": "the employee's birthday", "B": "any date chosen", "C": "1st January or 1st July", "D": "only 1st April"}, "answer": "C", "i": "q1kj9kecnokl"}, {"q": "An increment is earned on completion of", "options": {"A": "12 months always", "B": "no service at all", "C": "one month of service", "D": "6 months of qualifying service"}, "answer": "D", "i": "q1ubjnvo9c09"}, {"q": "On promotion, pay is fixed by", "options": {"A": "granting one increment and moving to the next cell in the higher level", "B": "doubling the pay", "C": "reducing the pay", "D": "keeping the same pay"}, "answer": "A", "i": "q29k4s6tgpyy"}, {"q": "If pay fixed on promotion is below the higher level's minimum,", "options": {"A": "pay is frozen", "B": "it is fixed at the minimum of the higher level", "C": "it stays below the minimum", "D": "promotion is cancelled"}, "answer": "B", "i": "q1gm6jlkqcnx"}, {"q": "The option for pay fixation on promotion can be exercised", "options": {"A": "never", "B": "at any time in the career", "C": "from the date of promotion or the date of next increment", "D": "only after five years"}, "answer": "C", "i": "q11ozihqmk5"}, {"q": "MACP upgradations are granted after", "options": {"A": "every single year", "B": "8, 16 and 24 years", "C": "12 and 24 years", "D": "10, 20 and 30 years of service"}, "answer": "D", "i": "qntg1adflc5"}, {"q": "MACP is admissible when", "options": {"A": "no regular promotion has occurred in the period", "B": "always to everyone", "C": "even after regular promotions", "D": "only to officers"}, "answer": "A", "i": "q298ray8tcn9"}, {"q": "Under MACP the employee gets", "options": {"A": "actual functional promotion", "B": "financial upgradation to the next level", "C": "double increment", "D": "no benefit"}, "answer": "B", "i": "q1c1559zpujr"}, {"q": "Dearness Allowance is revised", "options": {"A": "every year", "B": "never", "C": "every three months based on AICPI", "D": "every five years"}, "answer": "C", "i": "q6pv6e0eei2"}, {"q": "HRA was revised upward when DA crossed", "options": {"A": "25%", "B": "100%", "C": "never", "D": "50%"}, "answer": "D", "i": "q23d1bcx4tbo"}, {"q": "HRA in X-class cities at the revised rate is", "options": {"A": "30%", "B": "45%", "C": "50%", "D": "10%"}, "answer": "A", "i": "q13clxjep6k1"}, {"q": "HRA in Z-class cities at the revised rate is", "options": {"A": "20%", "B": "10%", "C": "5%", "D": "30%"}, "answer": "B", "i": "q24p0zsgepy1"}, {"q": "Transport allowance is admissible for", "options": {"A": "foreign travel", "B": "goods transport", "C": "commuting between residence and office", "D": "LTC travel"}, "answer": "C", "i": "q1ajyp4zpumy"}, {"q": "Non-Practising Allowance (NPA) is admissible to", "options": {"A": "teachers", "B": "all staff", "C": "drivers", "D": "doctors"}, "answer": "D", "i": "qnzr2wk9dc"}, {"q": "On deputation, pay is", "options": {"A": "protected as per rules", "B": "not protected", "C": "halved", "D": "doubled"}, "answer": "A", "i": "qjoav9m2nqw"}, {"q": "Stepping up of pay applies when", "options": {"A": "on every transfer", "B": "a senior draws less than a junior due to a fixation anomaly", "C": "always on demand", "D": "never"}, "answer": "B", "i": "qnasrsa4l87"}, {"q": "Bunching benefit in the 7th CPC was for", "options": {"A": "retirees", "B": "all employees", "C": "pay stages bunched at the same cell", "D": "only officers"}, "answer": "C", "i": "qoiu2bhojpz"}, {"q": "On first appointment, pay is fixed at", "options": {"A": "any cell", "B": "the maximum of the level", "C": "the mid-point", "D": "the minimum of the pay level"}, "answer": "D", "i": "q19ioffjfprc"}, {"q": "Advance increments may be granted for", "options": {"A": "outstanding achievements as per rules", "B": "everyone", "C": "never", "D": "on mere demand"}, "answer": "A", "i": "qut54s052d3"}, {"q": "Stagnation increment is for", "options": {"A": "new recruits", "B": "employees stagnating at the maximum of the level", "C": "promoted staff", "D": "all employees"}, "answer": "B", "i": "q1zop9q52e17"}, {"q": "Pay during extraordinary leave is", "options": {"A": "full pay", "B": "half pay", "C": "not admissible", "D": "double pay"}, "answer": "C", "i": "qtkbns2ucta"}, {"q": "Pay during study leave is", "options": {"A": "no pay", "B": "full pay always", "C": "double pay", "D": "leave salary as per rules"}, "answer": "D", "i": "qmaq8x8ofz1"}, {"q": "Deductions from pay include", "options": {"A": "provident fund, taxes and authorized recoveries", "B": "only donations", "C": "arbitrary cuts", "D": "nothing at all"}, "answer": "A", "i": "q1pvfob93ene"}, {"q": "Pay for pension purposes means", "options": {"A": "transport allowance", "B": "basic pay in the pay matrix", "C": "bonus", "D": "house rent allowance"}, "answer": "B", "i": "q1x69jbk4wl0"}, {"q": "Dearness Relief is admissible on", "options": {"A": "full pay always", "B": "bonus only", "C": "pension as per rules", "D": "never"}, "answer": "C", "i": "q4vx9tgtjm3"}, {"q": "Productivity Linked Bonus for railways is linked to", "options": {"A": "attendance alone", "B": "nothing", "C": "seniority", "D": "productivity"}, "answer": "D", "i": "qpgl6zihu1y"}, {"q": "The wage ceiling for PLB calculation is", "options": {"A": "Rs 7,000 per month", "B": "Rs 1,000", "C": "no ceiling", "D": "Rs 50,000"}, "answer": "A", "i": "q39up449hyy"}, {"q": "Overtime under HOER is calculated", "options": {"A": "at a flat Rs 100", "B": "at prescribed rates for eligible staff", "C": "always at double rate", "D": "never paid"}, "answer": "B", "i": "q21dejihfyfp"}, {"q": "Night duty allowance is for duty between", "options": {"A": "on leave days", "B": "06:00 and 22:00 hours", "C": "22:00 and 06:00 hours", "D": "only on Sundays"}, "answer": "C", "i": "q1s7uzog60af"}, {"q": "Pay of a re-employed pensioner is fixed", "options": {"A": "at the maximum", "B": "ignoring pension", "C": "by doubling pay", "D": "after adjusting pension as per rules"}, "answer": "D", "i": "q2d4k12v8lgj"}, {"q": "Honorarium is", "options": {"A": "payment for special work of an occasional nature", "B": "monthly salary", "C": "pension", "D": "an illegal payment"}, "answer": "A", "i": "q18qicfqf6sp"}, {"q": "Fee in service rules means", "options": {"A": "salary", "B": "payment for permitted services to others", "C": "a bribe", "D": "a tax"}, "answer": "B", "i": "qkjfyldu2se"}, {"q": "Special pay is", "options": {"A": "dearness allowance", "B": "house rent allowance", "C": "an addition to pay for special duties", "D": "bonus"}, "answer": "C", "i": "q1kpwwjxiev5"}, {"q": "Personal pay is granted", "options": {"A": "as secret pay", "B": "as illegal pay", "C": "as bonus", "D": "to protect pay in certain fixations"}, "answer": "D", "i": "q1nl79hlkfc7"}, {"q": "Presumptive pay relates to", "options": {"A": "pay of a post held in an officiating capacity", "B": "imagined pay", "C": "future pay", "D": "pension"}, "answer": "A", "i": "q1139cs5yjjl"}, {"q": "Officiating pay is admissible when", "options": {"A": "always", "B": "holding a higher post temporarily", "C": "never", "D": "on leave"}, "answer": "B", "i": "qkj5cowktj7"}, {"q": "Charge allowance is for", "options": {"A": "train charge", "B": "electric charge", "C": "holding additional charge of a post", "D": "no such allowance"}, "answer": "C", "i": "q62ehbmezhd"}, {"q": "Deputation (duty) allowance is admissible", "options": {"A": "on promotion", "B": "on leave", "C": "on retirement", "D": "on deputation outside the cadre"}, "answer": "D", "i": "qjzvourp3yp"}, {"q": "Children Education Allowance is admissible", "options": {"A": "per child per annum up to prescribed limits", "B": "never", "C": "for only one child", "D": "without any limit"}, "answer": "A", "i": "q10b7dmusnis"}, {"q": "Hostel subsidy is for", "options": {"A": "tourists", "B": "children studying in hostels away from home", "C": "no one", "D": "employees in hostels"}, "answer": "B", "i": "qzmv71zi05y"}, {"q": "Transfer travelling allowance includes", "options": {"A": "double salary", "B": "a car", "C": "composite transfer grant", "D": "nothing extra"}, "answer": "C", "i": "qr58m56hl3z"}, {"q": "Tour travelling allowance includes", "options": {"A": "entertainment allowance", "B": "nothing", "C": "shopping allowance", "D": "daily allowance for halts"}, "answer": "D", "i": "q18bo7wz5zu8"}, {"q": "LTC can be availed", "options": {"A": "to home town and anywhere in India in blocks", "B": "every month", "C": "only for foreign travel", "D": "never"}, "answer": "A", "i": "q1w9bmde0csc"}, {"q": "Leave encashment with LTC is allowed up to", "options": {"A": "unlimited days", "B": "10 days per block", "C": "60 days", "D": "never"}, "answer": "B", "i": "q1vm161aox3j"}, {"q": "Fixed medical allowance is admissible to", "options": {"A": "contractors", "B": "serving staff only", "C": "pensioners at prescribed rates", "D": "no one"}, "answer": "C", "i": "q2epqyz0t8nc"}, {"q": "Washing allowance is for", "options": {"A": "no one", "B": "all staff", "C": "officers only", "D": "staff supplied with uniforms"}, "answer": "D", "i": "q1dzez8bilez"}, {"q": "Uniforms are supplied to", "options": {"A": "categories prescribed in the rules", "B": "everyone", "C": "no one", "D": "only officers"}, "answer": "A", "i": "q18ovx7skrsd"}, {"q": "Risk and hardship allowance is for", "options": {"A": "desk work", "B": "specified risky duties", "C": "all staff", "D": "no duties"}, "answer": "B", "i": "qmxh1p2ueiz"}, {"q": "The pay matrix replaced", "options": {"A": "dearness allowance", "B": "house rent allowance", "C": "pay bands and grade pay", "D": "pensions"}, "answer": "C", "i": "q2aqn04xbjat"}, {"q": "The grade pay concept belonged to the", "options": {"A": "7th CPC", "B": "5th CPC", "C": "4th CPC", "D": "6th CPC"}, "answer": "D", "i": "q1mia7cbfrcr"}, {"q": "The fitment benefit in the 6th CPC was", "options": {"A": "1.86", "B": "3.00", "C": "1.00", "D": "2.57"}, "answer": "A", "i": "qk0hvexy2yn"}, {"q": "Anomaly committees were set up to", "options": {"A": "investigate accidents", "B": "resolve pay anomalies of implementation", "C": "do nothing", "D": "probe crimes"}, "answer": "B", "i": "q9beyv1lrqq"}, {"q": "Level in the pay matrix denotes", "options": {"A": "a train coach", "B": "nothing", "C": "the hierarchy rung of the post", "D": "a building floor"}, "answer": "C", "i": "q1mbjy9nyz6c"}, {"q": "Cell in the pay matrix denotes", "options": {"A": "a battery cell", "B": "a blood cell", "C": "a prison cell", "D": "the pay stage within a level"}, "answer": "D", "i": "q1yfauz2q9tt"}, {"q": "Movement from one cell to the next is by", "options": {"A": "annual increment", "B": "lottery", "C": "promotion", "D": "transfer"}, "answer": "A", "i": "q22f4coax133"}, {"q": "Movement to a higher level is by", "options": {"A": "seniority alone", "B": "promotion or MACP", "C": "annual increment", "D": "transfer"}, "answer": "B", "i": "q2cay4sn6icq"}, {"q": "Pay fixation on MACP is", "options": {"A": "a double promotion", "B": "no benefit at all", "C": "like promotion fixation with one increment", "D": "a pay cut"}, "answer": "C", "i": "qvtdh8hdytt"}, {"q": "The option for MACP fixation date is", "options": {"A": "any random date", "B": "never available", "C": "after five years", "D": "MACP date or the next increment date"}, "answer": "D", "i": "q2f1guc64llb"}, {"q": "Service counted for MACP is", "options": {"A": "continuous regular service", "B": "casual service", "C": "broken service", "D": "training always"}, "answer": "A", "i": "q22x0zlsd3l9"}, {"q": "Special Duty Allowance is for", "options": {"A": "all postings", "B": "postings in specified difficult areas", "C": "leave periods", "D": "retired staff"}, "answer": "B", "i": "q1ao4k4qgxj"}, {"q": "Compensatory allowances are meant for", "options": {"A": "all stations", "B": "no stations", "C": "costly or difficult stations", "D": "foreign stations"}, "answer": "C", "i": "qgade1jo6nk"}, {"q": "Cash handling allowance is for", "options": {"A": "all clerks", "B": "officers", "C": "no one", "D": "cashiers handling cash"}, "answer": "D", "i": "qcyhnebozbq"}, {"q": "Last Pay Certificate is issued", "options": {"A": "on transfer to another unit", "B": "never", "C": "every month", "D": "on retirement only"}, "answer": "A", "i": "qkb6lztfja7"}, {"q": "The monthly pay bill is prepared", "options": {"A": "never", "B": "every month by the bill section", "C": "by the employee", "D": "once a year"}, "answer": "B", "i": "q1hneig83vdt"}, {"q": "Arrears of pay arise when", "options": {"A": "pay is cut", "B": "bonus is paid", "C": "revisions are implemented with retrospective effect", "D": "never"}, "answer": "C", "i": "qjiqtamyaxw"}, {"q": "Subsistence allowance during suspension equals", "options": {"A": "only HRA", "B": "nothing", "C": "full pay", "D": "leave salary on half pay"}, "answer": "D", "i": "q31uqb8ajzn"}, {"q": "Pay for the day of joining on transfer is drawn", "options": {"A": "from the new unit after joining", "B": "only as advance", "C": "never", "D": "double from both"}, "answer": "A", "i": "q1pe96tw1ceh"}, {"q": "Recovery of overpaid pay is", "options": {"A": "written off always", "B": "effected in instalments as per rules", "C": "never done", "D": "done in one go always"}, "answer": "B", "i": "q773v8cmf1l"}, {"q": "Pay during joining time is", "options": {"A": "double pay", "B": "not admissible", "C": "admissible as on duty", "D": "half pay"}, "answer": "C", "i": "q9vngw1mcaj"}, {"q": "Deputationists may opt for", "options": {"A": "only pension", "B": "no pay", "C": "double pay", "D": "pay of the deputation post or their own pay plus allowance"}, "answer": "D", "i": "q1siwpjmykkp"}, {"q": "Foreign service contributions are paid by", "options": {"A": "the foreign employer", "B": "the employee always", "C": "no one", "D": "the union"}, "answer": "A", "i": "q175u1sgnnmp"}, {"q": "Pay protection on appointment to a lower post is", "options": {"A": "never given", "B": "as per rules through personal pay", "C": "automatic doubling", "D": "banned"}, "answer": "B", "i": "qf4k0qnnafo"}, {"q": "Ad hoc bonus is announced", "options": {"A": "never", "B": "every month", "C": "yearly by the Government for non-PLB staff", "D": "only in election years"}, "answer": "C", "i": "q9ih0ddjp1h"}, {"q": "Workshop incentive is linked to", "options": {"A": "attendance alone", "B": "seniority", "C": "luck", "D": "production outturn"}, "answer": "D", "i": "q1u11ffskmyn"}]