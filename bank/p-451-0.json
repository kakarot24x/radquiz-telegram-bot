[{"q": "In railway costing, 'unit cost' means:", "options": {"A": "Total expenditure of the railway for a year", "B": "Cost incurred per unit of output like a passenger-kilometre", "C": "Salary cost per railway employee", "D": "Fuel cost per litre of diesel"}, "answer": "B", "i": "qf6dax83a5o"}, {"q": "One passenger-kilometre represents:", "options": {"A": "One passenger carried over one kilometre", "B": "One coach run for one kilometre", "C": "One train run for one kilometre", "D": "One berth occupied for one hour"}, "answer": "A", "i": "q1ywof1idvuj"}, {"q": "One net tonne-kilometre represents:", "options": {"A": "One wagon moved over one kilometre", "B": "One tonne of wagon tare moved one kilometre", "C": "One tonne of paying load carried one kilometre", "D": "One locomotive hauling one tonne"}, "answer": "C", "i": "qrzt4cf38y9"}, {"q": "Gross tonne-kilometre includes:", "options": {"A": "Only the paying load", "B": "Only the locomotive weight", "C": "Only coaching stock weight", "D": "Paying load plus tare weight of vehicles"}, "answer": "D", "i": "q18t7ar1c67a"}, {"q": "Cost per coach-kilometre is mainly used in the costing of:", "options": {"A": "Goods train operations", "B": "Passenger and coaching services", "C": "Shunting operations", "D": "Track maintenance works"}, "answer": "B", "i": "q2bdrodpje42"}, {"q": "The wagon-kilometre is a standard unit for costing:", "options": {"A": "Goods rolling stock", "B": "Passenger amenities", "C": "Station staff deployment", "D": "Signalling assets"}, "answer": "A", "i": "qsh4vajqib1"}, {"q": "Train-kilometres for a period are obtained by:", "options": {"A": "Multiplying the number of trains by coaches", "B": "Dividing kilometres by train numbers", "C": "Adding the distance run by every train", "D": "Counting only loaded trains"}, "answer": "C", "i": "q15ft1qemr00"}, {"q": "The principal input for computing railway unit costs is:", "options": {"A": "Budget estimates", "B": "Operating statistics", "C": "Staff rosters", "D": "Fuel tender rates"}, "answer": "B", "i": "q26o4r5m04iw"}, {"q": "Separating fixed and variable costs mainly helps in:", "options": {"A": "Deciding on additional or new traffic", "B": "Paying monthly salaries", "C": "Counting wagons in yards", "D": "Printing tickets"}, "answer": "A", "i": "q2eyh9qyxdlt"}, {"q": "Which of the following is a fixed cost for the railway?", "options": {"A": "Fuel for locomotives", "B": "Overtime of running crew", "C": "Wagon repairs per kilometre", "D": "Interest on capital"}, "answer": "D", "i": "q15i75ubp9qm"}, {"q": "Which cost varies directly with the volume of traffic?", "options": {"A": "Depreciation of buildings", "B": "Rent of office buildings", "C": "Fuel consumption", "D": "Administrative salaries"}, "answer": "C", "i": "qubhja1d8bx"}, {"q": "Unit costs help in tariff fixation by:", "options": {"A": "Raising all fares every year", "B": "Checking whether rates cover the cost of service", "C": "Fixing staff pay scales", "D": "Setting fuel purchase prices"}, "answer": "B", "i": "q1ib8vrpmfa0"}, {"q": "In make-or-buy decisions, unit costs compare:", "options": {"A": "Departmental working with outsourcing", "B": "Two gauges of track", "C": "Day trains with night trains", "D": "AC coaches with non-AC coaches"}, "answer": "A", "i": "qldkbgzty1b"}, {"q": "A major limitation of unit cost figures is that they:", "options": {"A": "Are always exact", "B": "Never change over time", "C": "Include future costs", "D": "Are averages that hide wide variations"}, "answer": "D", "i": "qfrb47bysgs"}, {"q": "The marginal cost of adding one wagon to a train already running is:", "options": {"A": "Equal to the average cost", "B": "Lower than the average cost", "C": "Equal to total fixed cost", "D": "Always zero"}, "answer": "B", "i": "qg2yqevmn56"}, {"q": "A longer average lead in goods traffic generally:", "options": {"A": "Raises terminal cost per tonne", "B": "Has no effect on cost", "C": "Lowers the cost per tonne-kilometre", "D": "Doubles wagon requirement"}, "answer": "C", "i": "q1uwg8zs65w5"}, {"q": "Terminal costs in goods traffic are incurred at:", "options": {"A": "Loading and unloading points", "B": "Mid-section block stations", "C": "Running crew lobbies", "D": "Fuelling stations"}, "answer": "A", "i": "q1gk9ewz08cx"}, {"q": "A high empty wagon running raises:", "options": {"A": "Passenger earnings", "B": "Wagon turn-round speed", "C": "Line capacity", "D": "Cost per net tonne-kilometre"}, "answer": "D", "i": "q1ug7szun6kf"}, {"q": "Empty return ratio matters in goods costing because:", "options": {"A": "Empty wagons earn freight", "B": "Empty kilometres add cost without revenue", "C": "Empty wagons need no maintenance", "D": "Empty trains run faster"}, "answer": "B", "i": "qjafcez2n59"}, {"q": "Cost per passenger-kilometre is most relevant for:", "options": {"A": "Fixing freight tariffs", "B": "Designing wagons", "C": "Analysing coaching profitability", "D": "Planning track renewals"}, "answer": "C", "i": "q4x0nlvlp53"}, {"q": "Common costs like track maintenance between coaching and goods are:", "options": {"A": "Apportioned on a suitable basis", "B": "Charged fully to goods", "C": "Ignored in costing", "D": "Charged fully to coaching"}, "answer": "A", "i": "q2esul1wxqxz"}, {"q": "Cost centres in railway costing are used to:", "options": {"A": "Pay contractors", "B": "Count tickets sold", "C": "Fix train timetables", "D": "Collect costs by activity"}, "answer": "D", "i": "q1ek086mcbj3"}, {"q": "Engine kilometre cost broadly includes:", "options": {"A": "Ticket printing charges", "B": "Loco crew, fuel and locomotive maintenance", "C": "Station lighting", "D": "Parcel handling"}, "answer": "B", "i": "q17oc78heaka"}, {"q": "Wages of train crew are treated in costing as:", "options": {"A": "Fixed overhead", "B": "Capital expenditure", "C": "Variable with train-kilometres", "D": "Suspense head"}, "answer": "C", "i": "qjdp9p8nftn"}, {"q": "Depreciation of rolling stock is generally treated as:", "options": {"A": "A fixed cost", "B": "A variable cost", "C": "A suspense item", "D": "Revenue"}, "answer": "A", "i": "q1fsxhh8snwu"}, {"q": "In computing unit costs, overheads are:", "options": {"A": "Ignored completely", "B": "Charged to a single service", "C": "Written off at once", "D": "Allocated to the services"}, "answer": "D", "i": "qh1z24nf046"}, {"q": "Cost per coach-kilometre helps in comparing:", "options": {"A": "Freight rate levels", "B": "Efficiency of coaching stock use", "C": "Loco fuel consumption", "D": "Track wear rates"}, "answer": "B", "i": "q5stwtmsqsl"}, {"q": "Faster wagon turn-round lowers unit cost because:", "options": {"A": "More wagons are needed", "B": "Terminal costs rise", "C": "Fixed wagon cost spreads over more tonne-km", "D": "Train speeds fall"}, "answer": "C", "i": "q1w0sng086n7"}, {"q": "Wagon repair costs are best related to:", "options": {"A": "Wagon-kilometres run", "B": "Number of stations", "C": "Staff strength", "D": "Ticket sales"}, "answer": "A", "i": "q13x48vvn387"}, {"q": "Shunting costs are generally treated as:", "options": {"A": "Coaching costs", "B": "Passenger amenity costs", "C": "Track costs", "D": "Terminal and handling costs"}, "answer": "D", "i": "q5vdd1nrf54"}, {"q": "Costing a specific train service requires identifying:", "options": {"A": "The total railway budget", "B": "Costs attributable to that service", "C": "National GDP data", "D": "Staff seniority lists"}, "answer": "B", "i": "q1dtb9x71dhn"}, {"q": "'Sectional costing' means computing cost for:", "options": {"A": "The whole railway", "B": "A single wagon", "C": "A particular section or route", "D": "One employee"}, "answer": "C", "i": "qkp3x1nz3ev"}, {"q": "Comparing unit costs across gauges needs caution because:", "options": {"A": "Operating conditions differ", "B": "All gauges are identical", "C": "Costs are uniform everywhere", "D": "Statistics are exact"}, "answer": "A", "i": "q1p04l49q9md"}, {"q": "Comparing electric and diesel traction costs should consider:", "options": {"A": "Only fuel price", "B": "Only staff numbers", "C": "Only maximum speed", "D": "Energy, maintenance and capital costs"}, "answer": "D", "i": "qf1ireijqzk"}, {"q": "The operating ratio is related to unit costs as:", "options": {"A": "Its exact inverse", "B": "An overall cost-versus-earnings indicator", "C": "The same as unit cost", "D": "Wholly unrelated"}, "answer": "B", "i": "q2773dx9ou69"}, {"q": "Traffic costing in Indian Railways is mainly based on:", "options": {"A": "Guesswork", "B": "Daily census of every cost", "C": "Sample studies and operating statistics", "D": "Foreign railway data"}, "answer": "C", "i": "qveq1tag1kk"}, {"q": "Sample studies are used in costing because:", "options": {"A": "A full census is too costly", "B": "Samples are perfectly exact", "C": "Census is prohibited", "D": "Staff prefer samples"}, "answer": "A", "i": "q1c169sputio"}, {"q": "Cost per originating tonne is most useful for:", "options": {"A": "Passenger trains", "B": "Loco sheds", "C": "Ticket checking", "D": "Terminals handling goods"}, "answer": "D", "i": "q1g1vu51i3p1"}, {"q": "Transhipment at a break of gauge adds:", "options": {"A": "No extra cost", "B": "Handling cost per tonne", "C": "Running speed", "D": "Wagon capacity"}, "answer": "B", "i": "q1c8dt6wewqf"}, {"q": "Tare weight of wagons matters in costing because:", "options": {"A": "It earns freight", "B": "It is ignored", "C": "Hauling tare consumes energy", "D": "It always reduces payload"}, "answer": "C", "i": "q1qucsrogk9z"}, {"q": "Fuel cost per 1000 gross tonne-km measures:", "options": {"A": "Energy efficiency of haulage", "B": "Ticket pricing levels", "C": "Staff productivity", "D": "Wagon design quality"}, "answer": "A", "i": "qj1mh9s8afn"}, {"q": "Staff cost per million traffic units indicates:", "options": {"A": "Fuel price trends", "B": "Wagon age", "C": "Route length", "D": "Manpower productivity"}, "answer": "D", "i": "q31ktoyruhl"}, {"q": "In coaching costing, empty coaching stock movement:", "options": {"A": "Earns revenue", "B": "Adds cost without carrying passengers", "C": "Is free of cost", "D": "Is prohibited"}, "answer": "B", "i": "q1s61j8tj1k2"}, {"q": "Cost per train-km of a mail/express is generally higher than a passenger train because of:", "options": {"A": "Fewer coaches", "B": "Lower speeds", "C": "Higher speeds and better amenities", "D": "Shorter runs"}, "answer": "C", "i": "q2ckio98xaiu"}, {"q": "Signalling and telecom costs are apportioned to services on:", "options": {"A": "A usage or benefit basis", "B": "Equal share per train", "C": "Goods services only", "D": "Coaching services only"}, "answer": "A", "i": "qw9cn7tzi3r"}, {"q": "Marshalling yard costs form part of:", "options": {"A": "Line haul cost", "B": "Ticketing cost", "C": "Loco fuel cost", "D": "Goods terminal costs"}, "answer": "D", "i": "q237e8b6n2gj"}, {"q": "The incremental cost concept is applied when:", "options": {"A": "Closing a railway line", "B": "Considering extra traffic on existing services", "C": "Buying land", "D": "Fixing pay scales"}, "answer": "B", "i": "q232d1wcxwn1"}, {"q": "Fully distributed cost of a service includes:", "options": {"A": "Only fuel cost", "B": "Only crew wages", "C": "Variable costs plus a share of fixed costs", "D": "Only overheads"}, "answer": "C", "i": "q2b7li5ywyon"}, {"q": "If additional traffic covers its incremental cost, it:", "options": {"A": "Improves railway finances", "B": "Always causes a loss", "C": "Needs an immediate fare hike", "D": "Must be refused"}, "answer": "A", "i": "q1m4dou91lvc"}, {"q": "Unit cost figures become misleading when:", "options": {"A": "Traffic is stable", "B": "Records are accurate", "C": "Costs are current", "D": "Operating conditions change significantly"}, "answer": "D", "i": "q65ytj9yhcw"}, {"q": "Cost per wagon-kilometre is computed from:", "options": {"A": "Ticket revenue", "B": "Wagon capital and maintenance costs divided by wagon-km", "C": "Staff salaries alone", "D": "Fuel bills alone"}, "answer": "B", "i": "qg26888rypn"}, {"q": "Depreciation per coach-kilometre spreads:", "options": {"A": "Fuel cost", "B": "Crew wages", "C": "The capital cost of the coach over its use", "D": "Ticket revenue"}, "answer": "C", "i": "q4ve5znkz4o"}, {"q": "Higher occupancy in coaches:", "options": {"A": "Lowers cost per passenger-kilometre", "B": "Raises cost per train-km", "C": "Raises fuel per coach", "D": "Has no costing effect"}, "answer": "A", "i": "q1p1hwhg7jd"}, {"q": "Costing helps decide on retaining a loss-making service by comparing:", "options": {"A": "Staff opinions", "B": "Political views", "C": "Timetable convenience", "D": "Avoidable cost with social benefit"}, "answer": "D", "i": "q277pqzh4z5h"}, {"q": "Station staff costs are generally:", "options": {"A": "Fully variable", "B": "Fixed and apportioned", "C": "Charged to one train", "D": "Ignored in costing"}, "answer": "B", "i": "q1sb3aowcf9h"}, {"q": "Loco maintenance cost per engine-km reflects:", "options": {"A": "Ticket sales", "B": "Station earnings", "C": "Shed efficiency", "D": "Wagon loading"}, "answer": "C", "i": "q168wb9nxx91"}, {"q": "Demurrage charges are levied mainly to:", "options": {"A": "Discourage detention of wagons", "B": "Raise freight rates", "C": "Pay running crew", "D": "Fund pensions"}, "answer": "A", "i": "q188tfeigjz2"}, {"q": "Wharfage is a charge related to:", "options": {"A": "Ticket booking", "B": "Loco fuelling", "C": "Passenger luggage", "D": "Use of goods sheds and sidings"}, "answer": "D", "i": "q23dfbszwnx9"}, {"q": "In goods costing, 'lead' means:", "options": {"A": "Wagon capacity", "B": "Average distance of haul", "C": "Train length", "D": "Loading time"}, "answer": "B", "i": "q1nu28ix1a7u"}, {"q": "A fall in average lead raises:", "options": {"A": "Train speeds", "B": "Wagon capacity", "C": "The terminal cost share per tonne-km", "D": "Fuel efficiency"}, "answer": "C", "i": "qob7ad6irgi"}, {"q": "Unit costs differ across railway zones mainly beca