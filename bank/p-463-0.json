[{"q": "Who is primarily responsible for the safe custody of cash at a railway station?", "options": {"A": "Station Master", "B": "Ticket Collector", "C": "Accounts Clerk", "D": "RPF Constable"}, "answer": "A", "i": "q15rnvlhnftt"}, {"q": "How often should the station cash book normally be written up?", "options": {"A": "Weekly", "B": "Daily", "C": "Monthly", "D": "Only when inspected"}, "answer": "B", "i": "q1wec47puta2"}, {"q": "Corrections in the station cash book must be made by:", "options": {"A": "Erasing the entry", "B": "Overwriting it", "C": "Scoring out and attesting", "D": "Using correction fluid"}, "answer": "C", "i": "q5dcqj32t79"}, {"q": "Private money of staff must:", "options": {"A": "Be kept in the safe", "B": "Be mixed with railway cash for convenience", "C": "Be recorded in the cash book", "D": "Never be mixed with railway cash"}, "answer": "D", "i": "qbyandg6dt9"}, {"q": "Station cash collections should be remitted to the cash office or bank:", "options": {"A": "Once a month", "B": "Promptly, normally every day", "C": "Only after audit", "D": "When the safe is full"}, "answer": "B", "i": "q2egy115vlit"}, {"q": "The cash book balance at the close of day must be:", "options": {"A": "Verified with actual cash in hand", "B": "Taken as correct without checking", "C": "Adjusted to match estimates", "D": "Carried only weekly"}, "answer": "A", "i": "q29ss89lmuh9"}, {"q": "Cash book pages at a station should be:", "options": {"A": "Loose sheets", "B": "Torn out after use", "C": "Reused after a year", "D": "Bound and serially numbered"}, "answer": "D", "i": "q4pujsry0al"}, {"q": "Who attests the daily closing of the station cash book?", "options": {"A": "Any porter", "B": "The cleaning staff", "C": "The Station Master", "D": "A passenger"}, "answer": "C", "i": "q1q1rj63y0bd"}, {"q": "Cash received at the station must be acknowledged by:", "options": {"A": "A serially numbered receipt", "B": "A verbal assurance", "C": "A plain paper note", "D": "No document needed"}, "answer": "A", "i": "q23ca9zx9pey"}, {"q": "Counterfoils of used receipt books must be:", "options": {"A": "Destroyed immediately", "B": "Preserved for audit", "C": "Given to passengers", "D": "Reused"}, "answer": "B", "i": "qraxhtrveen"}, {"q": "A shortage of cash found at a station must be:", "options": {"A": "Ignored if small", "B": "Adjusted secretly", "C": "Reported and investigated", "D": "Written off by the SM"}, "answer": "C", "i": "q1ilmi2l09v1"}, {"q": "Cash found in excess at a station should be:", "options": {"A": "Kept by the SM", "B": "Shared among staff", "C": "Returned without record", "D": "Credited to railway revenue after inquiry"}, "answer": "D", "i": "qizzhrs9jyr"}, {"q": "An imprest is best described as:", "options": {"A": "A standing advance for petty expenses", "B": "A monthly salary", "C": "A bank loan", "D": "A penalty fund"}, "answer": "A", "i": "qqfstklnrea"}, {"q": "The amount of a station imprest is fixed by:", "options": {"A": "The Station Master", "B": "The competent authority (DRM)", "C": "The ticket clerk", "D": "The bank manager"}, "answer": "B", "i": "qzcvsdipoyh"}, {"q": "Imprest expenditure must be supported by:", "options": {"A": "Memory", "B": "Estimates", "C": "Verbal orders", "D": "Proper vouchers"}, "answer": "D", "i": "q1us2t5nvex6"}, {"q": "An imprest is recouped:", "options": {"A": "Never", "B": "Only at year end", "C": "Periodically on submission of vouchers", "D": "By the bank automatically"}, "answer": "C", "i": "q1h0272fm1km"}, {"q": "Imprest money must be kept:", "options": {"A": "Mixed with station earnings", "B": "Separate from other cash", "C": "In the SM's pocket", "D": "At the bank only"}, "answer": "B", "i": "q1uopm068nus"}, {"q": "The imprest holder is:", "options": {"A": "Personally responsible for its safe custody", "B": "Not responsible at all", "C": "Responsible only on Sundays", "D": "Responsible only for notes"}, "answer": "A", "i": "q9r1oiz087y"}, {"q": "Imprest should NOT be used for:", "options": {"A": "Minor stationery", "B": "Small repairs", "C": "Postage", "D": "Personal advances to staff"}, "answer": "D", "i": "q1mlcc9pxgti"}, {"q": "During inspections, the imprest cash is:", "options": {"A": "Ignored", "B": "Hidden", "C": "Counted and verified", "D": "Doubled"}, "answer": "C", "i": "q1syipgwsema"}, {"q": "Duplicate keys of the station safe are normally deposited with:", "options": {"A": "The ticket clerk", "B": "The divisional office", "C": "A passenger", "D": "The bank"}, "answer": "B", "i": "q1tdvh7i3vyi"}, {"q": "When charge is handed over, station cash must be:", "options": {"A": "Jointly counted and verified", "B": "Taken on trust", "C": "Left in the drawer", "D": "Sent home"}, "answer": "A", "i": "q2cxybyb8kp5"}, {"q": "A shortage detected during handing over of charge is the responsibility of the:", "options": {"A": "Incoming SM", "B": "Ticket clerk", "C": "DRM", "D": "Outgoing SM"}, "answer": "D", "i": "q2cifsg3praf"}, {"q": "Suspected counterfeit currency notes received at a station must be:", "options": {"A": "Passed on to passengers", "B": "Destroyed quietly", "C": "Seized and reported to police", "D": "Kept in the imprest"}, "answer": "C", "i": "q1vtujn4t7po"}, {"q": "Torn or mutilated notes should be:", "options": {"A": "Exchanged through the bank/RBI", "B": "Thrown away", "C": "Given as change", "D": "Taped and reused freely"}, "answer": "A", "i": "qbg0ch3y3g0"}, {"q": "Loss of station cash by theft must be followed by:", "options": {"A": "Silence", "B": "A staff collection", "C": "Immediate write-off", "D": "FIR and report to divisional authorities"}, "answer": "D", "i": "qyvfnxu9o42"}, {"q": "Cash in transit from the station to the bank should be:", "options": {"A": "Sent by post", "B": "Escorted by authorized staff", "C": "Left unattended", "D": "Carried openly by anyone"}, "answer": "B", "i": "q1xdtf7li4s5"}, {"q": "Bank pay-in slips for station remittances are normally prepared in:", "options": {"A": "Single copy", "B": "Pencil", "C": "Triplicate", "D": "No copies"}, "answer": "C", "i": "q2c6m4wasozs"}, {"q": "The daily cash position of a station is reported to:", "options": {"A": "Passengers", "B": "The press", "C": "No one", "D": "The divisional office"}, "answer": "D", "i": "q13p90lc5wac"}, {"q": "Unremitted cash held at the station at month end must be:", "options": {"A": "Disclosed in the monthly return", "B": "Hidden", "C": "Used for expenses", "D": "Distributed"}, "answer": "A", "i": "q1nfyzmbrum8"}, {"q": "Staff handling station cash are generally required to furnish:", "options": {"A": "Nothing", "B": "A reference letter", "C": "Security/fidelity guarantee", "D": "A medical certificate"}, "answer": "C", "i": "q1360zuqnoi0"}, {"q": "The station cash book records:", "options": {"A": "Only train timings", "B": "All cash receipts and payments", "C": "Staff leave", "D": "Complaints"}, "answer": "B", "i": "qse2j7h2jjq"}, {"q": "The opening balance in the cash book each day is:", "options": {"A": "Always zero", "B": "A fresh estimate", "C": "Decided by staff", "D": "The previous day's closing balance"}, "answer": "D", "i": "q15nc9154zow"}, {"q": "Receipts and payments in the cash book appear in:", "options": {"A": "Separate columns", "B": "The same column", "C": "No columns", "D": "Pencil only"}, "answer": "A", "i": "qyq0rmxm0qo"}, {"q": "The monthly certificate in the station cash book is signed by:", "options": {"A": "The peon", "B": "The Station Master", "C": "A vendor", "D": "Nobody"}, "answer": "B", "i": "q2b0jddpm5rb"}, {"q": "Surprise checks of station cash are conducted by:", "options": {"A": "Passengers", "B": "Vendors", "C": "Ticket agents", "D": "Inspecting officers"}, "answer": "D", "i": "q1lwma28rn35"}, {"q": "A cashier must not:", "options": {"A": "Count cash", "B": "Issue receipts", "C": "Keep railway cash at home overnight", "D": "Use the safe"}, "answer": "C", "i": "qgljihupuuw"}, {"q": "Refunds paid in cash at the station require:", "options": {"A": "Proper authority and vouchers", "B": "No authority", "C": "Only verbal approval", "D": "SM's verbal nod only"}, "answer": "A", "i": "qxzdgyxfl1g"}, {"q": "Vouchers supporting station cash payments must be:", "options": {"A": "Discarded", "B": "Serially numbered and filed", "C": "Kept in pockets", "D": "Burnt monthly"}, "answer": "B", "i": "q27hb9e61fqg"}, {"q": "Delay in remitting station cash beyond the prescribed time requires:", "options": {"A": "Nothing", "B": "A celebration", "C": "Extra staff", "D": "An explanation to higher authority"}, "answer": "D", "i": "qbcvpv5t51y"}, {"q": "Cash book totals are carried forward:", "options": {"A": "Never", "B": "Yearly only", "C": "In pencil", "D": "At each balancing"}, "answer": "D", "i": "quabifpqepg"}, {"q": "The bank balance shown at the station is verified with:", "options": {"A": "The bank passbook/statement", "B": "Guesswork", "C": "Last year's figures", "D": "Staff memory"}, "answer": "A", "i": "q13p3yy3mtjw"}, {"q": "Remittance challans received from the bank must be:", "options": {"A": "Thrown away", "B": "Preserved as proof of remittance", "C": "Given to vendors", "D": "Reused"}, "answer": "B", "i": "q183xm1lyc0i"}, {"q": "No payment from station cash is allowed without:", "options": {"A": "A phone call", "B": "A crowd", "C": "Competent sanction", "D": "A newspaper"}, "answer": "C", "i": "q29mfppjbnss"}, {"q": "Advances from station cash to staff are:", "options": {"A": "Prohibited", "B": "Encouraged", "C": "Unlimited", "D": "Unrecorded"}, "answer": "A", "i": "q1obff8qkg0l"}, {"q": "Cash received after the day's remittance is:", "options": {"A": "Forgotten", "B": "Entered and remitted the next day", "C": "Kept for a month", "D": "Divided among staff"}, "answer": "B", "i": "q19mxjxphewj"}, {"q": "The station cash safe should be kept:", "options": {"A": "Open", "B": "In a corridor", "C": "Unlocked", "D": "Locked at all times except during transactions"}, "answer": "D", "i": "q6t159zb5bb"}, {"q": "Opening the safe normally requires the presence of:", "options": {"A": "A passenger", "B": "A vendor", "C": "The Station Master or authorized officer", "D": "Anyone"}, "answer": "C", "i": "q1puqx1ks857"}, {"q": "A register of safe custody should record:", "options": {"A": "Opening/closing and cash movements", "B": "Train arrivals", "C": "Staff birthdays", "D": "Weather"}, "answer": "A", "i": "qor36lmmgm6"}, {"q": "At night, station cash is secured by:", "options": {"A": "Leaving it on the counter", "B": "Giving it to vendors", "C": "Open drawers", "D": "Locked safe and secure premises"}, "answer": "D", "i": "q1gaka23kww3"}, {"q": "Erasures in the station cash book are:", "options": {"A": "Allowed freely", "B": "Strictly prohibited", "C": "Encouraged", "D": "Done with ink remover"}, "answer": "B", "i": "q1xi9a4ij5r8"}, {"q": "The cash book should be written in:", "options": {"A": "Pencil", "B": "Chalk", "C": "Ink", "D": "Crayon"}, "answer": "C", "i": "q83wcupv05q"}, {"q": "If an entry is made in the wrong column, the correct procedure is to:", "options": {"A": "Erase it", "B": "Ignore it", "C": "Tear the page", "D": "Score it out, attest, and rewrite correctly"}, "answer": "D", "i": "q4okidtynww"}, {"q": "Temporary imprest may be sanctioned for:", "options": {"A": "Specific short-term needs like fairs or melas", "B": "Permanent salary", "C": "Buying trains", "D": "Staff parties"}, "answer": "A", "i": "q9hidrsutvk"}, {"q": "An unspent temporary imprest must be:", "options": {"A": "Kept forever", "B": "Shared", "C": "Surrendered promptly", "D": "Invested"}, "answer": "C", "i": "qvgdlcpvtzq"}, {"q": "Cash shortages due to negligence of staff are normally:", "options": {"A": "Ignored", "B": "Recovered from the responsible staff", "C": "Paid by passengers", "D": "Written off instantly"}, "answer": "B", "i": "q6t68auutku"}, {"q": "Write-off of irrecoverable cash shortages needs:", "options": {"A": "Sanction of competent authority", "B": "No sanction", "C": "Staff vote", "D": "Passenger consent"}, "answer": "A", "i": "q1i5o9jigk3d"}, {"q": "Inspection remarks on station cash are recorded in:", "options": {"A": "A diary", "B": "A newspaper", "C": "A train register", "D": "The inspection book/cash records"}, "answer": "D", "i": "q1p2u5ejk5l9"}, {"q": "Audit objections on cash discrepancies must be:", "options": {"A": "Ignored", "B": "Torn up", "C": "Replied to promptly", "D": "Hidden"}, "answer": "C", "i": "qp1gj3yc7of"}, {"q": "The Station Master is personally liable for cash loss caused by:", "options": {"A": "Floods only", "B": "His negligence", "C": "Lightning", "D": "Passengers"}, "answer": "B", "i": "q6op4zuqdi3"}, {"q": "Before taking over charge, the incoming officer should:", "options": {"A": "Sign blindly", "B": "Refuse", "C": "Trust the staff", "D": "Verify cash, books and keys"}, "answer": "D", "i": "qcgkkaccc84"}, {"q": "Relief of cash-handling staff must include:", "options": {"A": "Joint verification of cash and records", "B": "No verification", "C": "Only keys", "D": "Only wishes"}, "answer": "A", "i": "q6id8aptgi4"}, {"q": "Rotation of staff handling cash is desirable because it:", "options": {"A": "Increases salary", "B": "Reduces scope for fraud", "C": "Wastes time", "D": "Confuses passengers"}, "answer": "B", "i": "q9gjsuiyj6k"}, {"q": "The daily remittance figure in the cash book should agree with:", "options": {"A": "Estimates", "B": "Last month", "C": "Bank challans", "D": "Rumours"}, "answer": "C", "i": "q13fwsodg82h"}, {"q": "Cash collected from parcel and goods traffic is entered in:", "options": {"A": "No book", "B": "A diary", "C": "A timetable", "D": "The station cash book"}, "answer": "D", "i": "qmu7bdr6hpg"}, {"q": "Separate cash books may be maintained for:", "options": {"A": "Distinct funds like imprest", "B": "Every clerk", "C": "Every hour", "D": "Every passenger"}, "answer": "A", "i": "q9zx4u9udj3"}, {"q": "The closing balance of the cash book represents:", "options": {"A": "Profit", "B": "Loss", "C": "Cash and bank balance in hand", "D": "Staff salary"}, "answer": "C", "i": "q1zrm4dqn3e3"}, {"q": "A nil closing balance means:", "options": {"A": "A loss", "B": "All cash duly remitted", "C": "An error", "D": "Theft"}, "answer": "B", "i": "q211f5yt0406"}, {"q": "Emergency expenditure from station cash is allowed only with:", "options": {"A": "Prior competent approval", "B": "No approval", "C": "Staff consent", "D": "Passenger donation"}, "answer": "A", "i": "q1h9awhvc0l9"}, {"q": "The ultimate purpose of station cash accounting is to ensure:", "options": {"A": "More trains", "B": "Faster trains", "C": "Cheaper tickets", "D": "Every rupee is accounted for"}, "answer": "D", "i": "q2fmfmwlbsvi"}]