[{"q": "Which authority issues economy instructions for Railways from time to time?", "options": {"A": "Railway Board", "B": "Zonal General Manager", "C": "Principal Financial Adviser", "D": "Divisional Railway Manager"}, "answer": "A", "i": "q2dn7t3gbug6"}, {"q": "Creation of new posts in Railways requires prior concurrence of", "options": {"A": "Finance", "B": "Establishment section", "C": "Safety department", "D": "Personnel branch"}, "answer": "A", "i": "q1bhpj570iw0"}, {"q": "The ban on creation of new posts mainly aims at", "options": {"A": "faster recruitment", "B": "better training", "C": "improving safety", "D": "controlling staff costs"}, "answer": "D", "i": "qnv4kpcrabu"}, {"q": "Purchase of new staff cars is generally", "options": {"A": "unlimited", "B": "freely allowed", "C": "banned except replacement after prescribed life", "D": "a DRM power"}, "answer": "C", "i": "q1chbxp5mp8f"}, {"q": "Economy instructions commonly restrict", "options": {"A": "ticket booking", "B": "foreign tours and deputations", "C": "train running", "D": "track renewals"}, "answer": "B", "i": "q1ilzwr60bcn"}, {"q": "Mandatory cuts on controllable expenditure under economy drives are generally of the order of", "options": {"A": "5 percent", "B": "10 percent", "C": "25 percent", "D": "2 percent"}, "answer": "B", "i": "q1x67ccnuhea"}, {"q": "Controllable expenditure includes items like", "options": {"A": "pension", "B": "interest payments", "C": "salaries", "D": "office expenses, travel and contingencies"}, "answer": "D", "i": "q1yxroll6dyo"}, {"q": "Review of continuing schemes is done mainly to", "options": {"A": "create posts", "B": "increase staff", "C": "weed out wasteful or ineffective expenditure", "D": "delay projects"}, "answer": "C", "i": "q1ol23qda4r3"}, {"q": "Anticipated savings in a grant should be", "options": {"A": "spent quickly", "B": "surrendered as soon as foreseen", "C": "carried forward", "D": "kept unreported"}, "answer": "B", "i": "q2caq8ti2uva"}, {"q": "Surrender of savings helps the administration in", "options": {"A": "higher spending", "B": "avoiding audit", "C": "nothing", "D": "re-appropriation to heads needing funds"}, "answer": "D", "i": "q1mzpmee6pc9"}, {"q": "Austerity measures restrict holding of conferences and seminars in", "options": {"A": "offices", "B": "divisions", "C": "railway institutes", "D": "costly hotels"}, "answer": "D", "i": "qhdqja465x4"}, {"q": "Overtime payments in Railways require", "options": {"A": "union approval", "B": "no sanction", "C": "prior sanction and periodic review", "D": "staff demand"}, "answer": "C", "i": "q1qs5oaj3zsl"}, {"q": "Control over fuel consumption is exercised through", "options": {"A": "random checks", "B": "specific fuel consumption norms and targets", "C": "bulk purchases", "D": "no norms"}, "answer": "B", "i": "qdb2ltl6ew7"}, {"q": "Engagement of consultants by Railways is", "options": {"A": "restricted under economy instructions", "B": "free", "C": "fully banned", "D": "encouraged"}, "answer": "A", "i": "q14bskesphgg"}, {"q": "Economy in printing, stationery and telephones is part of", "options": {"A": "budget speech", "B": "pink book", "C": "works programme", "D": "austerity instructions"}, "answer": "D", "i": "q2dbjofk3nkp"}, {"q": "Posts kept unfilled beyond the prescribed period may", "options": {"A": "remain forever", "B": "lapse", "C": "double", "D": "get transferred"}, "answer": "B", "i": "q12orv9vhl8x"}, {"q": "Filling of vacancies in non-safety categories under economy orders needs", "options": {"A": "no approval", "B": "approval of the General Manager", "C": "staff consent", "D": "Board approval always"}, "answer": "B", "i": "q1f651r2yq0r"}, {"q": "Which of the following is NOT an economy measure?", "options": {"A": "Cut in office expenses", "B": "Higher dividend payment", "C": "Overtime control", "D": "Ban on new posts"}, "answer": "B", "i": "q18t7nypeiwl"}, {"q": "Zero-based budgeting requires every department to", "options": {"A": "prepare no budget", "B": "renew automatically", "C": "add 10 percent to last year budget", "D": "justify every rupee afresh"}, "answer": "D", "i": "q12env5uthkc"}, {"q": "Review of continuing schemes is typically undertaken every", "options": {"A": "never", "B": "month", "C": "few years", "D": "decade"}, "answer": "C", "i": "q1vvje8z9jgq"}, {"q": "Economy instructions of the Railway Board apply to", "options": {"A": "headquarters only", "B": "all railway units", "C": "workshops only", "D": "divisions only"}, "answer": "B", "i": "q19b38gvh1ot"}, {"q": "Hiring of taxis and vehicles is", "options": {"A": "restricted with ceilings under economy orders", "B": "fully banned", "C": "free", "D": "unrestricted"}, "answer": "A", "i": "qk4uu1l1u2o"}, {"q": "Which expenditure is usually protected from economy cuts?", "options": {"A": "Furniture", "B": "Advertisements", "C": "Office parties", "D": "Safety-related expenditure"}, "answer": "D", "i": "q277y99b920b"}, {"q": "Austerity in government finance means", "options": {"A": "larger deficits", "B": "lavish spending", "C": "strict economy in public spending", "D": "more borrowing"}, "answer": "C", "i": "qr6mfl2reyj"}, {"q": "Savings from economy measures get reflected in", "options": {"A": "higher spending", "B": "revised estimates", "C": "no accounts", "D": "pink book"}, "answer": "B", "i": "q1l7ioqo7x1w"}, {"q": "Restrictions on foreign travel mainly aim to save", "options": {"A": "foreign exchange and travel costs", "B": "staff", "C": "fuel", "D": "time"}, "answer": "A", "i": "q2ffpg6m24f2"}, {"q": "Creation of posts in safety categories is", "options": {"A": "discouraged", "B": "not allowed", "C": "fully banned", "D": "generally exempted from the ban"}, "answer": "D", "i": "qsxw0t3oi2i"}, {"q": "Economy circulars are issued by", "options": {"A": "CAG", "B": "Accounts office", "C": "Railway Board directorates", "D": "unions"}, "answer": "C", "i": "qjs24mpkjfl"}, {"q": "Work study in Railways is used to", "options": {"A": "assess staff requirements scientifically", "B": "increase pay", "C": "conduct audit", "D": "impart training"}, "answer": "A", "i": "q1c4bixnxyyb"}, {"q": "Compliance with economy measures is monitored through", "options": {"A": "no monitoring", "B": "annual parties", "C": "inspections only", "D": "monthly expenditure reviews"}, "answer": "D", "i": "q2dfprujk6h4"}, {"q": "A cut on other charges in budgets is an example of", "options": {"A": "capitalisation", "B": "suspense booking", "C": "economy drive", "D": "revenue increase"}, "answer": "C", "i": "qdaorvn1iwi"}, {"q": "Which of the following is a controllable item for economy cuts?", "options": {"A": "Pension", "B": "Pay", "C": "Dearness allowance", "D": "Office contingencies"}, "answer": "D", "i": "q1guucie0gm7"}, {"q": "Economy instructions on telephones cover", "options": {"A": "STD and ISD limits", "B": "free unlimited use", "C": "no rules", "D": "personal phones"}, "answer": "A", "i": "q293lo9ep5be"}, {"q": "Ban on purchase of furniture and office equipment is", "options": {"A": "part of periodic economy instructions", "B": "never imposed", "C": "a GM power", "D": "permanent"}, "answer": "A", "i": "q5sku0d2u48"}, {"q": "Surrender of anticipated savings must be done", "options": {"A": "never", "B": "in April", "C": "after March", "D": "before close of the financial year"}, "answer": "D", "i": "q28fdrzxtv2o"}, {"q": "Re-appropriation of funds is possible only when", "options": {"A": "automatically", "B": "savings exist under some head", "C": "Board approves everything", "D": "never"}, "answer": "B", "i": "q73ko091g4p"}, {"q": "Economy in expenditure is also enforced through provisions of", "options": {"A": "General Financial Rules", "B": "no rules", "C": "union demands", "D": "court orders"}, "answer": "A", "i": "q5mf7xitdxm"}, {"q": "Which GFR principle supports economy in expenditure?", "options": {"A": "Exercise the same vigilance as a person of ordinary prudence", "B": "No checks needed", "C": "Borrow freely", "D": "Spend freely"}, "answer": "A", "i": "q1jq6n2ukgin"}, {"q": "Financial propriety includes", "options": {"A": "speed", "B": "secrecy", "C": "lavishness", "D": "economy and avoidance of waste"}, "answer": "D", "i": "q15hiqfhh8hh"}, {"q": "Holding meetings through video conferencing supports", "options": {"A": "nothing", "B": "tourism", "C": "economy in travel expenditure", "D": "delays"}, "answer": "C", "i": "qll2vmnwhc4"}, {"q": "Restrictions on inaugurations, decorations and gifts are", "options": {"A": "economy measures", "B": "cultural rules", "C": "safety rules", "D": "not issued"}, "answer": "A", "i": "q6z417xdk6z"}, {"q": "Economy instructions on staff cars prescribe replacement", "options": {"A": "only after prescribed age or kilometres", "B": "every year", "C": "with no rule", "D": "freely"}, "answer": "A", "i": "q24dniotrvkb"}, {"q": "Engagement of manpower through outsourcing is", "options": {"A": "free", "B": "unregulated", "C": "banned", "D": "allowed with controls under instructions"}, "answer": "D", "i": "q81xdd3oq54"}, {"q": "Which expenditure is exempt from economy cuts?", "options": {"A": "Gifts", "B": "Advertisements", "C": "Statutory and safety obligations", "D": "Hospitality"}, "answer": "C", "i": "qr12l9xrgsd"}, {"q": "Mandatory saving targets are fixed by", "options": {"A": "DRM", "B": "Railway Board and Ministry of Finance", "C": "staff", "D": "CAG"}, "answer": "B", "i": "q14leqqxq3ka"}, {"q": "Review of continuing schemes uses", "options": {"A": "lottery", "B": "seniority", "C": "nothing", "D": "output-outcome framework"}, "answer": "D", "i": "q1ry4o9xk5gv"}, {"q": "Schemes found ineffective on review are", "options": {"A": "ignored", "B": "doubled", "C": "expanded", "D": "wound up or restructured"}, "answer": "D", "i": "q11lxagliy8u"}, {"q": "Economy in works expenditure is ensured through", "options": {"A": "post-payment checks", "B": "detailed estimates and finance vetting", "C": "no estimates", "D": "verbal orders"}, "answer": "B", "i": "q16ahnm50