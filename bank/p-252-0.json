[{"q":"What does IREC stand for?","options":{"A":"Indian Railway Establishment Code","B":"Indian Railway Enquiry Code","C":"Indian Railway Engineering Code","D":"Indian Railway Employment Charter"},"answer":"A"},{"q":"IREC is issued under the authority of","options":{"A":"the Prime Minister","B":"the President of India","C":"the Chief Justice of India","D":"the Railway Minister alone"},"answer":"B"},{"q":"IREC Volume I mainly deals with","options":{"A":"leave and passes only","B":"pension rules","C":"general rules and service conditions","D":"signal engineering"},"answer":"C"},{"q":"IREC Volume II mainly deals with","options":{"A":"stores purchase rules","B":"train working rules","C":"bridge engineering","D":"establishment matters like pay and allowances"},"answer":"D"},{"q":"A railway servant is a person","options":{"A":"employed in railway service and paid from railway revenues","B":"working on railway contract","C":"holding a railway pass","D":"travelling by train daily"},"answer":"A"},{"q":"A permanent post means a post","options":{"A":"lasting more than ten years","B":"sanctioned without limit of time","C":"approved by Parliament","D":"filled by a permanent employee"},"answer":"B"},{"q":"A temporary post is one","options":{"A":"kept vacant for a year","B":"abolished every March","C":"sanctioned for a specified limited period","D":"filled on daily wages"},"answer":"C"},{"q":"The normal period of probation is","options":{"A":"1 year","B":"5 years","C":"6 months","D":"2 years"},"answer":"D"},{"q":"Probation may be extended when","options":{"A":"performance is not satisfactory","B":"seniority changes","C":"the employee takes leave","D":"a vacancy arises"},"answer":"A"},{"q":"Confirmation means","options":{"A":"grant of first increment","B":"substantive appointment after satisfactory probation","C":"promotion to gazetted rank","D":"transfer to headquarters"},"answer":"B"},{"q":"Lien means","options":{"A":"a type of allowance","B":"a loan from the railway","C":"the title to hold a permanent post substantively","D":"leave without pay"},"answer":"C"},{"q":"A railway servant can retain lien on","options":{"A":"all posts ever held","B":"any number of posts","C":"two posts with permission","D":"only one permanent post at a time"},"answer":"D"},{"q":"The service book is maintained for","options":{"A":"non-gazetted railway servants","B":"gazetted officers","C":"retired employees","D":"contract labour"},"answer":"A"},{"q":"Entries in the service book are attested by","options":{"A":"the employee himself","B":"the head of office","C":"a co-worker","D":"the trade union"},"answer":"B"},{"q":"The confidential record for gazetted officers is called","options":{"A":"service book","B":"leave account","C":"character roll","D":"pass register"},"answer":"C"},{"q":"The date of birth once recorded","options":{"A":"can be changed every year","B":"is updated at each promotion","C":"is optional information","D":"cannot normally be altered later"},"answer":"D"},{"q":"At first appointment a railway servant must produce","options":{"A":"a certificate of medical fitness","B":"a character roll","C":"a pension form","D":"a railway pass"},"answer":"A"},{"q":"Railway servants are liable for service","options":{"A":"only on their parent railway","B":"anywhere in India","C":"only at headquarters","D":"only in their home state"},"answer":"B"},{"q":"The age of superannuation is","options":{"A":"58 years","B":"62 years","C":"60 years","D":"55 years"},"answer":"C"},{"q":"A temporary servant's service can be terminated with","options":{"A":"no notice at all","B":"Parliament approval","C":"one year's notice","D":"one month's notice or pay in lieu"},"answer":"D"},{"q":"Quasi-permanent status may follow","options":{"A":"3 years of continuous temporary service","B":"only after retirement","C":"6 months of service","D":"10 years of service"},"answer":"A"},{"q":"Seniority is generally determined by","options":{"A":"place of posting","B":"length of continuous service in the grade","C":"date of birth","D":"educational qualification"},"answer":"B"},{"q":"Transfer on administrative grounds","options":{"A":"is never permitted","B":"needs written consent","C":"does not require the employee's consent","D":"needs union approval"},"answer":"C"},{"q":"A railway servant on transfer is eligible for","options":{"A":"exemption from duty","B":"double salary","C":"free housing anywhere","D":"joining time to join the new post"},"answer":"D"},{"q":"Suspension of a railway servant is","options":{"A":"not a punishment in itself","B":"a major penalty","C":"equal to dismissal","D":"a minor penalty"},"answer":"A"},{"q":"Dies-non refers to","options":{"A":"a type of leave","B":"a break in service","C":"an allowance","D":"a promotion"},"answer":"B"},{"q":"Resignation from railway service","options":{"A":"is effective instantly","B":"needs court approval","C":"requires acceptance by the competent authority","D":"is never accepted"},"answer":"C"},{"q":"Voluntary retirement is admissible after","options":{"A":"5 years of service","B":"10 years without notice","C":"only after age 58","D":"20 years of qualifying service with 3 months' notice"},"answer":"D"},{"q":"On superannuation a servant retires","options":{"A":"on the afternoon of the last day of that month","B":"on the first of next year","C":"whenever he chooses","D":"at midnight of the birthday"},"answer":"A"},{"q":"A servant born on the 1st of a month retires","options":{"A":"a month later","B":"on the afternoon of the previous month's last day","C":"on the 1st itself","D":"on his birthday"},"answer":"B"},{"q":"A whole-time railway servant","options":{"A":"can work for contractors","B":"needs no permission for part-time work","C":"cannot take other employment without prior permission","D":"may run any business freely"},"answer":"C"},{"q":"Gazetted railway officers must","options":{"A":"disclose colleagues' assets","B":"file returns with the Board only","C":"publish their salary","D":"declare assets and liabilities annually"},"answer":"D"},{"q":"Conduct of railway servants is governed by","options":{"A":"Railway Services (Conduct) Rules, 1966","B":"the Companies Act","C":"the Factories Act","D":"the Payment of Wages Act"},"answer":"A"},{"q":"Discipline matters are governed by","options":{"A":"the Trade Unions Act","B":"Railway Servants (Discipline and Appeal) Rules, 1968","C":"the Indian Penal Code","D":"the Civil Procedure Code"},"answer":"B"},{"q":"Hours of work are regulated by","options":{"A":"the Motor Vehicles Act","B":"the Minimum Wages Act","C":"Hours of Employment Regulations (HOER)","D":"the Shops Act"},"answer":"C"},{"q":"Railway servants are entitled to","options":{"A":"rest at management's mercy","B":"work every day","C":"rest only on festivals","D":"a weekly day of rest"},"answer":"D"},{"q":"The three national holidays are","options":{"A":"Republic Day, Independence Day and Gandhi Jayanti","B":"Diwali, Holi and Dussehra","C":"Christmas, Eid and Gurpurab","D":"Pongal, Onam and Bihu"},"answer":"A"},{"q":"Casual leave admissible per calendar year is","options":{"A":"30 days","B":"8 days","C":"15 days","D":"4 days"},"answer":"B"},{"q":"Leave to a railway servant","options":{"A":"is an absolute right","B":"must be granted on demand","C":"cannot be claimed as a matter of right","D":"can never be refused"},"answer":"C"},{"q":"Study leave is granted","options":{"A":"for any private purpose","B":"only to gazetted officers","C":"without any conditions","D":"for higher studies in public interest"},"answer":"D"},{"q":"Extraordinary leave is leave","options":{"A":"without pay, not debited to the leave account","B":"counted as duty","C":"granted only to officers","D":"with full pay"},"answer":"A"},{"q":"Leave encashment on retirement is limited to","options":{"A":"500 days","B":"300 days of earned leave","C":"unlimited days","D":"100 days"},"answer":"B"},{"q":"Privilege passes are admissible under","options":{"A":"the Conduct Rules","B":"HOER","C":"Railway Servants (Pass) Rules","D":"the Leave Rules"},"answer":"C"},{"q":"PTO stands for","options":{"A":"Pay and Transfer Option","B":"Provisional Train Order","C":"Permanent Transfer Order","D":"Privilege Ticket Order"},"answer":"D"},{"q":"Railway servants get medical facilities through","options":{"A":"railway hospitals and empanelled hospitals","B":"no medical facility","C":"only private clinics","D":"only AIIMS"},"answer":"A"},{"q":"Railway accommodation is allotted","options":{"A":"only to officers","B":"according to entitlement and availability","C":"to everyone on demand","D":"by lottery only"},"answer":"B"},{"q":"Children Education Allowance is admissible to","options":{"A":"retired staff","B":"only officers","C":"servants with school-going children","D":"only for college"},"answer":"C"},{"q":"Travelling allowance is admissible","options":{"A":"for private trips","B":"for daily commuting","C":"for LTC travel","D":"for journeys on tour and transfer"},"answer":"D"},{"q":"During suspension, subsistence allowance is normally","options":{"A":"half pay for the first three months","B":"full pay always","C":"no payment at all","D":"double pay"},"answer":"A"},{"q":"On reinstatement, the suspension period is","options":{"A":"always treated as duty","B":"regularized as duty, leave or dies-non by order","C":"always forfeited","D":"ignored entirely"},"answer":"B"},{"q":"Promotion in railways is generally by","options":{"A":"lottery","B":"seniority alone always","C":"seniority-cum-suitability or selection","D":"political recommendation"},"answer":"C"},{"q":"MACP provides financial upgradation after","options":{"A":"5, 10 and 15 years","B":"only at retirement","C":"every 5 years","D":"10, 20 and 30 years of service"},"answer":"D"},{"q":"Service records of staff must be","options":{"A":"kept up to date and verified periodically","B":"maintained by the employee","C":"destroyed after 5 years","D":"updated only at retirement"},"answer":"A"},{"q":"Verification of qualifying service is done","options":{"A":"only on promotion","B":"before retirement benefits are settled","C":"after retirement","D":"never"},"answer":"B"},{"q":"A servant under suspension","options":{"A":"is on leave","B":"has resigned","C":"cannot leave headquarters without permission","D":"may travel freely"},"answer":"C"},{"q":"Headquarters during suspension is","options":{"A":"always New Delhi","B":"irrelevant","C":"chosen by the employee","D":"fixed by the competent authority"},"answer":"D"},{"q":"Character and antecedents are verified","options":{"A":"before confirmation in service","B":"by the employee himself","C":"never","D":"only at retirement"},"answer":"A"},{"q":"A railway servant must declare","options":{"A":"his travel plans","B":"his home town for LTC purposes","C":"his bank balance monthly","D":"his friends list"},"answer":"B"},{"q":"Overtime allowance is admissible to","options":{"A":"retired staff","B":"all officers","C":"eligible non-gazetted staff under HOER","D":"ministers"},"answer":"C"},{"q":"First appointment requires","options":{"A":"political recommendation","B":"only a written test","C":"only an interview","D":"fulfilment of age, qualification and medical standards"},"answer":"D"}]