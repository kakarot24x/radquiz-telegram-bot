[{"q": "Normal exit from NPS for government employees is at:", "options": {"A": "55 years", "B": "58 years", "C": "60 years (superannuation)", "D": "65 years"}, "answer": "C", "i": "q1o75ebs4ckv"}, {"q": "At superannuation, the minimum annuitization required is:", "options": {"A": "60% of corpus", "B": "80% of corpus", "C": "20% of corpus", "D": "40% of corpus"}, "answer": "D", "i": "q251x1twxdkq"}, {"q": "At superannuation, the maximum lump sum withdrawal allowed is:", "options": {"A": "80%", "B": "100%", "C": "40%", "D": "60%"}, "answer": "D", "i": "q1ruhybti6a6"}, {"q": "If the corpus is up to Rs. 5 lakh at age 60, the subscriber may:", "options": {"A": "Withdraw 100% as lump sum", "B": "Must buy annuity", "C": "Wait till 70", "D": "Forfeit the amount"}, "answer": "A", "i": "q1iccmkbrfnb"}, {"q": "On premature exit (before 60), annuitization required is:", "options": {"A": "40%", "B": "60%", "C": "80%", "D": "100%"}, "answer": "C", "i": "q21m0hqc5ui5"}, {"q": "On premature exit, lump sum allowed is up to:", "options": {"A": "40%", "B": "60%", "C": "10%", "D": "20%"}, "answer": "D", "i": "q2gept3h4e5f"}, {"q": "If the corpus is up to Rs. 2.5 lakh on premature exit:", "options": {"A": "Full withdrawal is allowed", "B": "80% annuity is compulsory", "C": "The account is frozen", "D": "It transfers to PPF"}, "answer": "A", "i": "q1ug6v9vm2mj"}, {"q": "Annuity under NPS is purchased from:", "options": {"A": "The employer", "B": "RBI", "C": "PFRDA", "D": "Annuity Service Providers (life insurers)"}, "answer": "D", "i": "q1yr654pf1zl"}, {"q": "Which of these is an Annuity Service Provider?", "options": {"A": "LIC of India", "B": "A commercial bank", "C": "PFRDA", "D": "The CRA"}, "answer": "A", "i": "qlzq7gosg8"}, {"q": "Annuity income received is:", "options": {"A": "Taxed at flat 10%", "B": "Exempt up to Rs. 5 lakh", "C": "Tax-free", "D": "Taxable as income"}, "answer": "D", "i": "q1cqsjl7xc6r"}, {"q": "The 60% lump sum on superannuation exit is:", "options": {"A": "Taxed at 20%", "B": "Partially taxable", "C": "Fully taxable", "D": "Tax-exempt"}, "answer": "D", "i": "q2da30itrwqe"}, {"q": "Partial withdrawal from Tier I is allowed after:", "options": {"A": "5 years", "B": "10 years", "C": "1 year", "D": "3 years"}, "answer": "D", "i": "q1v5ekumun9l"}, {"q": "Maximum partial withdrawal permitted is:", "options": {"A": "50% of corpus", "B": "75% of corpus", "C": "10% of corpus", "D": "25% of own contributions"}, "answer": "D", "i": "qbielv629vm"}, {"q": "Partial withdrawals allowed during the entire tenure:", "options": {"A": "Only once", "B": "Twice", "C": "Unlimited", "D": "Maximum 4"}, "answer": "D", "i": "q27n5q7sa66d"}, {"q": "A valid reason for partial withdrawal is:", "options": {"A": "Car purchase", "B": "Business investment", "C": "Foreign vacation", "D": "Children's higher education"}, "answer": "D", "i": "q1m6dse59l6y"}, {"q": "Other valid reasons for partial withdrawal include:", "options": {"A": "House purchase/construction, medical treatment, children's marriage", "B": "Share trading", "C": "Gold purchase", "D": "Gifts"}, "answer": "A", "i": "q1911x8cpdlz"}, {"q": "Partial withdrawal amount is:", "options": {"A": "Taxed at 30%", "B": "Counted as salary", "C": "Taxable", "D": "Tax-exempt"}, "answer": "D", "i": "qqpmeuzm53o"}, {"q": "On death of the subscriber, the nominee gets:", "options": {"A": "Monthly pension only", "B": "Nothing", "C": "Only 25%", "D": "The entire corpus as lump sum"}, "answer": "D", "i": "qn9au2xv8gd"}, {"q": "A subscriber may defer exit beyond 60 up to age:", "options": {"A": "62", "B": "65", "C": "85", "D": "75"}, "answer": "C", "i": "q22158ze2g80"}, {"q": "Once an annuity is purchased, it:", "options": {"A": "Doubles in value", "B": "Converts to lump sum", "C": "Can be surrendered anytime", "D": "Generally cannot be surrendered"}, "answer": "D", "i": "q2dlkmzhbvyc"}, {"q": "A popular annuity option is:", "options": {"A": "Life annuity", "B": "Fixed deposit", "C": "PPF", "D": "NSC"}, "answer": "A", "i": "q1ijhk3c4fqt"}, {"q": "Joint-life annuity covers:", "options": {"A": "Children", "B": "Parents", "C": "Subscriber only", "D": "Subscriber and spouse"}, "answer": "D", "i": "q2o7hebng3i"}, {"q": "'Return of purchase price' annuity means:", "options": {"A": "No annuity is paid", "B": "Lump sum option", "C": "Higher monthly payout", "D": "Corpus returned to nominee after death"}, "answer": "D", "i": "q1fx1j63yo4u"}, {"q": "Annuity rates depend on:", "options": {"A": "The subscriber's choice of ASP and age", "B": "A PFRDA-fixed rate", "C": "Identical rates for all", "D": "The employer"}, "answer": "A", "i": "q18hdlzioapr"}, {"q": "Exit from NPS is initiated through:", "options": {"A": "The bank", "B": "A court", "C": "Directly with the ASP", "D": "The nodal office/CRA, online or offline"}, "answer": "D", "i": "qe8yov7rbfi"}, {"q": "Documents for exit include:", "options": {"A": "PRAN, KYC, bank details and cancelled cheque", "B": "Only PAN", "C": "Service book only", "D": "None"}, "answer": "A", "i": "q1hwwdni0nrn"}, {"q": "The lump sum on exit is paid:", "options": {"A": "As a cheque to the employer", "B": "In gold", "C": "In cash", "D": "To the subscriber's bank account"}, "answer": "D", "i": "q1oa21v0jx6t"}, {"q": "Annuity payouts can be:", "options": {"A": "Daily", "B": "Only monthly", "C": "Only yearly", "D": "Monthly/quarterly/half-yearly/yearly as chosen"}, "answer": "D", "i": "qm5n5x2rooh"}, {"q": "Purchase of annuity at exit is:", "options": {"A": "Exempt forever", "B": "Taxed at 10%", "C": "Taxed at purchase", "D": "Not taxed at purchase; payouts are taxed"}, "answer": "D", "i": "qfuilot7rvp"}, {"q": "Tier II balance on exit:", "options": {"A": "Is forfeited", "B": "Transfers to Tier I", "C": "Must be annuitized", "D": "Is fully withdrawable with no annuity needed"}, "answer": "D", "i": "q1xeylu2hel2"}, {"q": "The 80% annuitization on premature exit ensures:", "options": {"A": "Tax saving", "B": "Employer benefit", "C": "A penalty", "D": "Lifelong pension income despite early exit"}, "answer": "D", "i": "q2b5efkkwsbt"}, {"q": "NPS does NOT:", "options": {"A": "Auto-close the account at 60", "B": "Allow deferment", "C": "Pay annuity itself", "D": "Send reminders"}, "answer": "A", "i": "qo35qtybf6y"}, {"q": "Continuing NPS after 60 means:", "options": {"A": "Contributions and accumulation can continue", "B": "Forced annuity purchase", "C": "Account closure", "D": "No contributions allowed"}, "answer": "A", "i": "q1n3irx1eukp"}, {"q": "On voluntary retirement/resignation, exit follows:", "options": {"A": "Premature exit rules", "B": "No exit is allowed", "C": "Full lump sum rules", "D": "Superannuation rules"}, "answer": "A", "i": "q1ywjsv3oync"}, {"q": "The minimum 40% annuity applies on:", "options": {"A": "The total accumulated corpus", "B": "Only Tier II", "C": "Interest earned only", "D": "Only the employer share"}, "answer": "A", "i": "q1595ov8x8s4"}, {"q": "At exit the subscriber chooses:", "options": {"A": "Both the ASP and the annuity plan", "B": "Neither", "C": "Only the plan", "D": "Only the ASP"}, "answer": "A", "i": "q2ftrp539y05"}, {"q": "On death during service, the family receives:", "options": {"A": "The entire accumulated corpus", "B": "Only the employee's share", "C": "Nothing", "D": "Monthly family pension like the old scheme"}, "answer": "A", "i": "q5m5zok6qfp"}, {"q": "The eNPS exit facility allows:", "options": {"A": "Online initiation of exit", "B": "Only viewing the account", "C": "A new PRAN", "D": "Loans"}, "answer": "A", "i": "qfnsq5iuiqg"}, {"q": "Which annuity gives the highest monthly payout?", "options": {"A": "Life annuity without return of purchase price", "B": "With return of purchase price", "C": "Joint-life annuity", "D": "All pay equally"}, "answer": "A", "i": "q14tql465tgk"}, {"q": "After full withdrawal of the corpus, the PRAN is:", "options": {"A": "Closed", "B": "Converted to Tier II", "C": "Transferred to the nominee", "D": "Kept active"}, "answer": "A", "i": "q77ta7tw4ef"}]