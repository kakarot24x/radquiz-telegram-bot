[{"q":"The primary objective of cost accounting is to:","options":{"A":"Record financial transactions only","B":"Ascertain cost of products or services","C":"Audit statutory accounts","D":"Prepare the balance sheet"},"answer":"B"},{"q":"Cost accounting differs from financial accounting mainly because it:","options":{"A":"Follows the Companies Act strictly","B":"Reports only to shareholders","C":"Serves internal management needs","D":"Avoids all estimates"},"answer":"C"},{"q":"Which of the following is a fixed cost?","options":{"A":"Rent of the factory building","B":"Direct material consumed","C":"Power used per unit","D":"Sales commission"},"answer":"A"},{"q":"Variable cost per unit normally:","options":{"A":"Increases with output","B":"Decreases with output","C":"Rises with inflation only","D":"Remains constant"},"answer":"D"},{"q":"A semi-variable cost contains:","options":{"A":"Only a fixed element","B":"Only a variable element","C":"Both fixed and variable elements","D":"Only an opportunity element"},"answer":"C"},{"q":"Direct material used in a product is a:","options":{"A":"Direct cost","B":"Factory overhead","C":"Period cost","D":"Sunk cost"},"answer":"A"},{"q":"Salary of a factory supervisor is classified as:","options":{"A":"Direct labour","B":"Selling expense","C":"Administration cost","D":"Indirect cost"},"answer":"D"},{"q":"A cost controllable by a shop foreman is:","options":{"A":"Head office rent","B":"Material wastage in his shop","C":"Corporate tax","D":"Depreciation policy"},"answer":"B"},{"q":"Which cost is uncontrollable for a departmental manager?","options":{"A":"Overtime in his department","B":"Consumables used by him","C":"Apportioned head office expenses","D":"Idle time in his shop"},"answer":"C"},{"q":"A sunk cost is a cost that:","options":{"A":"Varies with output","B":"Is avoidable in future","C":"Equals opportunity cost","D":"Is already incurred and unrecoverable"},"answer":"D"},{"q":"Opportunity cost is:","options":{"A":"Benefit forgone by choosing one alternative over another","B":"Historical cost of an asset","C":"Total fixed cost","D":"Cost of idle capacity"},"answer":"A"},{"q":"Differential cost is the:","options":{"A":"Cost per unit at full capacity","B":"Standard cost variance","C":"Change in total cost between two alternatives","D":"Apportioned overhead"},"answer":"C"},{"q":"A cost centre is:","options":{"A":"A person liable for costs","B":"A location, person or item for which cost is ascertained","C":"A profit-making unit","D":"A sales territory only"},"answer":"B"},{"q":"In a railway workshop, the suitable cost unit for repair work is usually:","options":{"A":"Per kilometre","B":"Per passenger","C":"Per tonne-km","D":"Per job or per repaired item"},"answer":"D"},{"q":"Marginal cost is the:","options":{"A":"Extra cost of producing one more unit","B":"Average cost per unit","C":"Total fixed cost","D":"Budgeted cost"},"answer":"A"},{"q":"Prime cost comprises:","options":{"A":"All factory overheads","B":"Fixed costs only","C":"Direct material + direct labour + direct expenses","D":"Selling and distribution costs"},"answer":"C"},{"q":"Factory overheads exclude:","options":{"A":"Indirect material","B":"Direct wages","C":"Depreciation of plant","D":"Power and fuel"},"answer":"B"},{"q":"Selling and administrative expenses are treated as:","options":{"A":"Product costs","B":"Prime costs","C":"Direct costs","D":"Period costs"},"answer":"D"},{"q":"Product costs are:","options":{"A":"Carried with inventory until the product is sold","B":"Charged to the period incurred","C":"Always variable","D":"Never include fixed overhead"},"answer":"A"},{"q":"Costs eliminated by shutting a workshop section are called:","options":{"A":"Sunk costs","B":"Common costs","C":"Avoidable (escapable) costs","D":"Committed costs"},"answer":"C"},{"q":"Committed fixed costs arise from:","options":{"A":"Daily operating decisions","B":"Long-term capacity decisions like plant investment","C":"Variable output levels","D":"Sales promotions"},"answer":"B"},{"q":"An example of discretionary fixed cost is:","options":{"A":"Factory rent","B":"Direct material","C":"Property tax","D":"Research and development expenditure"},"answer":"D"},{"q":"A step cost:","options":{"A":"Stays fixed over a range then jumps to a new level","B":"Varies smoothly with output","C":"Is always a direct cost","D":"Equals semi-variable cost"},"answer":"A"},{"q":"Total fixed cost within the relevant range:","options":{"A":"Increases with output","B":"Decreases with output","C":"Remains constant","D":"Equals total variable cost"},"answer":"C"},{"q":"Fixed cost per unit:","options":{"A":"Remains constant","B":"Falls as output rises","C":"Rises as output rises","D":"Is always zero"},"answer":"B"},{"q":"Cost records primarily help management in:","options":{"A":"Filing tax returns","B":"Share valuation","C":"Dividend declaration","D":"Price fixation and cost control"},"answer":"D"},{"q":"Cost control aims at:","options":{"A":"Maintaining costs at predetermined standards","B":"Permanent lowering of unit cost","C":"Eliminating all fixed costs","D":"Always increasing output"},"answer":"A"},{"q":"Cost reduction differs from cost control because it seeks:","options":{"A":"Temporary savings","B":"Only labour cuts","C":"Real and permanent saving in unit cost","D":"Higher selling prices"},"answer":"C"},{"q":"Standard costing is mainly concerned with:","options":{"A":"Cash forecasts","B":"Control of costs through predetermined standards","C":"Capital budgeting","D":"Sales budgets only"},"answer":"B"},{"q":"A relevant cost for a decision is one that:","options":{"A":"Is already sunk","B":"Remains same in all cases","C":"Is always historical","D":"Differs between the alternatives considered"},"answer":"D"},{"q":"Sunk costs are irrelevant for decisions because they:","options":{"A":"Cannot be changed by any decision","B":"Are too large to matter","C":"Are always variable","D":"Relate to the future only"},"answer":"A"},{"q":"Out-of-pocket costs refer to:","options":{"A":"Notional costs","B":"Apportioned costs","C":"Costs requiring current cash outlay","D":"Imputed rent"},"answer":"C"},{"q":"Imputed cost is a:","options":{"A":"Cash cost","B":"Hypothetical cost not involving cash, like rent of owned premises","C":"Direct cost","D":"Period cost"},"answer":"B"},{"q":"Conversion cost comprises:","options":{"A":"Direct material plus direct labour","B":"All selling costs","C":"Prime cost plus profit","D":"Direct labour plus factory overhead"},"answer":"D"},{"q":"Shut-down costs are costs:","options":{"A":"Incurred even when the plant is temporarily closed","B":"Of closing the business forever","C":"Varying with output","D":"Borne by customers"},"answer":"A"},{"q":"A cost driver is:","options":{"A":"A type of fixed asset","B":"A costing clerk","C":"A factor causing a change in the cost of an activity","D":"The selling price"},"answer":"C"},{"q":"Allocation of overhead means:","options":{"A":"Spreading common costs on a basis","B":"Transferring to profit and loss","C":"Ignoring indirect costs","D":"Charging overhead wholly to one cost centre"},"answer":"D"},{"q":"Apportionment of overhead is used when:","options":{"A":"Overhead relates to a single department","B":"Overhead is common to several departments","C":"Cost is direct","D":"Cost is sunk"},"answer":"B"},{"q":"Absorption of overhead means:","options":{"A":"Charging overheads to cost units","B":"Writing off overheads","C":"Ignoring overheads","D":"Apportioning to departments"},"answer":"A"},{"q":"Works cost equals:","options":{"A":"Prime cost plus office overhead","B":"Cost of sales plus profit","C":"Prime cost plus factory overhead","D":"Direct material only"},"answer":"C"},{"q":"Cost of production is:","options":{"A":"Works cost only","B":"Prime cost only","C":"Cost of sales plus selling overhead","D":"Works cost plus administrative overhead"},"answer":"D"},{"q":"Cost of sales equals:","options":{"A":"Prime cost only","B":"Cost of production plus selling and distribution overhead","C":"Works cost only","D":"Sales minus profit"},"answer":"B"},{"q":"Normal loss in production is:","options":{"A":"Treated as part of cost of good units","B":"Charged to costing profit and loss","C":"Ignored completely","D":"Added to profit"},"answer":"A"},{"q":"Abnormal loss is:","options":{"A":"Absorbed in product cost","B":"Added to closing stock","C":"Written off to costing profit and loss account","D":"Treated as normal loss"},"answer":"C"},{"q":"Normal idle time wages are treated as:","options":{"A":"Direct labour","B":"Selling expense","C":"Capital expenditure","D":"Factory overhead"},"answer":"D"},{"q":"Overtime premium paid to rush a specific urgent order is charged to:","options":{"A":"Factory overhead","B":"That specific job","C":"Administration","D":"Costing profit and loss"},"answer":"B"},{"q":"Abnormal labour turnover cost is:","options":{"A":"Charged to costing profit and loss","B":"Added to direct wages","C":"Treated as prime cost","D":"Ignored in costing"},"answer":"A"},{"q":"Royalty paid per unit of production is a:","options":{"A":"Indirect expense","B":"Fixed overhead","C":"Direct expense","D":"Period cost"},"answer":"C"},{"q":"Hire charges of a crane used for one specific job are:","options":{"A":"Factory overhead","B":"Selling expense","C":"Sunk cost","D":"Direct expense"},"answer":"D"},{"q":"Cost behaviour refers to:","options":{"A":"The ethics of costing staff","B":"The way costs change with activity level","C":"The layout of the cost sheet","D":"Pricing behaviour"},"answer":"B"},{"q":"The relevant range is the:","options":{"A":"Full capacity of the plant","B":"Break-even point","C":"Range of activity over which cost behaviour assumptions hold","D":"Margin of safety"},"answer":"C"},{"q":"An electricity bill with a minimum charge plus a per-unit rate is a:","options":{"A":"Semi-variable cost","B":"Fixed cost","C":"Direct cost","D":"Step cost"},"answer":"A"},{"q":"Historical costing ascertains cost:","options":{"A":"Before production begins","B":"Using estimates only","C":"At standard rates","D":"After the costs are incurred"},"answer":"D"},{"q":"Standard cost is a:","options":{"A":"Actual cost recorded","B":"Predetermined cost under efficient operating conditions","C":"Sunk cost","D":"Marginal cost"},"answer":"B"},{"q":"Estimated cost differs from standard cost as it is:","options":{"A":"Scientifically set","B":"Always accurate","C":"Based on past experience without scientific analysis","D":"Used for control"},"answer":"C"},{"q":"Job costing is suitable for:","options":{"A":"Production to specific customer orders","B":"Continuous mass production","C":"Process industries","D":"Service firms only"},"answer":"A"},{"q":"Process costing is used where:","options":{"A":"Each job is unique","B":"Only services are sold","C":"Batch size is one","D":"Identical units pass through continuous processes"},"answer":"D"},{"q":"In batch costing, the cost unit is:","options":{"A":"A single article","B":"A batch of identical articles","C":"A process","D":"A labour hour"},"answer":"B"},{"q":"Contract costing is a variant of:","options":{"A":"Process costing","B":"Standard costing","C":"Job costing for large long-term work","D":"Marginal costing"},"answer":"C"},{"q":"Operating costing applies to:","options":{"A":"Service undertakings like transport","B":"Manufacturing only","C":"Construction contracts","D":"Retail shops only"},"answer":"A"},{"q":"Multiple costing is used when:","options":{"A":"One method fits everything","B":"Only one product exists","C":"Costs are zero","D":"Different methods suit different parts of manufacture"},"answer":"D"},{"q":"Uniform costing means:","options":{"A":"Identical costs for all products","B":"Same costing principles adopted by several firms in an industry","C":"A single cost centre","D":"Fixed selling price"},"answer":"B"},{"q":"Under marginal costing, fixed costs are:","options":{"A":"Apportioned to products","B":"Added to prime cost","C":"Treated as period costs","D":"Ignored in decisions"},"answer":"C"},{"q":"Absorption costing charges to products:","options":{"A":"Both variable and fixed manufacturing costs","B":"Only variable costs","C":"Only direct costs","D":"Only sunk costs"},"answer":"A"},{"q":"Contribution equals:","options":{"A":"Sales minus total cost","B":"Fixed cost minus profit","C":"Prime cost plus overhead","D":"Sales minus variable cost"},"answer":"D"},{"q":"At the break-even point:","options":{"A":"Profit is maximum","B":"Profit is zero","C":"Fixed costs are zero","D":"Sales are zero"},"answer":"B"},{"q":"P/V ratio is:","options":{"A":"Profit divided by sales","B":"Fixed cost divided by sales","C":"Contribution divided by sales","D":"Variable cost divided by sales"},"answer":"C"},{"q":"Margin of safety is:","options":{"A":"Fixed cost plus profit","B":"Contribution minus fixed cost","C":"Sales minus variable cost","D":"Actual sales minus break-even sales"},"answer":"D"},{"q":"A wider angle of incidence indicates:","options":{"A":"A higher rate of profit earning","B":"A lower profit rate","C":"Higher fixed cost","D":"Lower sales"},"answer":"A"},{"q":"An essential requirement for installing a costing system is:","options":{"A":"A uniform product only","B":"No management support","C":"Clear objectives and suitable cost units","D":"Manual records only"},"answer":"C"}]