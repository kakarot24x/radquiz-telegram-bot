[{"q": "The minimum qualifying service for a monthly pension is:", "options": {"A": "10 years", "B": "20 years", "C": "33 years", "D": "5 years"}, "answer": "A", "i": "qjl7ggpkgpq"}, {"q": "A servant with less than 10 years of service is entitled to:", "options": {"A": "Full pension", "B": "No benefit at all", "C": "Service gratuity", "D": "Double gratuity"}, "answer": "C", "i": "q1f8n9wtii66"}, {"q": "Qualifying service means:", "options": {"A": "Service on pensionable establishment paid from the Consolidated Fund", "B": "Any paid work anywhere", "C": "Honorary service", "D": "Private employment"}, "answer": "A", "i": "q20n9yd24j3m"}, {"q": "Service rendered before the age of 18 years:", "options": {"A": "Counts fully", "B": "Counts at half rate", "C": "Counts after confirmation", "D": "Does not count"}, "answer": "D", "i": "q1anfikrt75m"}, {"q": "The period spent as an apprentice:", "options": {"A": "Counts fully", "B": "Counts at half rate", "C": "Does not count", "D": "Counts after 5 years"}, "answer": "C", "i": "q19icd9i9hio"}, {"q": "Service as casual labour before regularization:", "options": {"A": "Counts fully from day one", "B": "Counts at double rate", "C": "Counts after 3 years", "D": "Does not count"}, "answer": "D", "i": "q1cd2pta7fkw"}, {"q": "The period of probation:", "options": {"A": "Counts as qualifying service", "B": "Never counts", "C": "Counts only if extended", "D": "Counts at half rate"}, "answer": "A", "i": "qp218wd3f8y"}, {"q": "A training period:", "options": {"A": "Counts when followed by appointment without break", "B": "Counts at half rate", "C": "Counts only for officers", "D": "Never counts"}, "answer": "A", "i": "q1fpmn63ayv4"}, {"q": "Extraordinary leave granted on medical grounds:", "options": {"A": "Counts as qualifying service", "B": "Never counts", "C": "Counts at half rate", "D": "Breaks service"}, "answer": "A", "i": "qqm43n5x19i"}, {"q": "Extraordinary leave on private grounds:", "options": {"A": "Adds bonus service", "B": "Always counts", "C": "Does not count", "D": "Counts at double rate"}, "answer": "C", "i": "q131ovcjvzbw"}, {"q": "Leave with pay, such as LAP and LHAP:", "options": {"A": "Never counts", "B": "Counts only for officers", "C": "Counts as qualifying service", "D": "Breaks continuity"}, "answer": "C", "i": "q120b9cs2h38"}, {"q": "The period of suspension:", "options": {"A": "Always counts", "B": "Never counts", "C": "Counts at half rate", "D": "Counts only if treated as duty on reinstatement"}, "answer": "D", "i": "q16wrdewtjea"}, {"q": "Suspension ending in full exoneration with full pay:", "options": {"A": "Counts as qualifying service", "B": "Is permanently forfeited", "C": "Counts at half rate", "D": "Reduces pension by half"}, "answer": "A", "i": "q16waih1dbjv"}, {"q": "Unauthorized absence treated as dies non:", "options": {"A": "Adds to service", "B": "Counts fully", "C": "Does not count", "D": "Counts at double rate"}, "answer": "C", "i": "qimyf7f12bf"}, {"q": "The period spent on deputation to another department:", "options": {"A": "Never counts", "B": "Breaks service", "C": "Counts as qualifying service", "D": "Counts only abroad"}, "answer": "C", "i": "q27xq6apl0s"}, {"q": "Service on foreign service terms:", "options": {"A": "Counts if foreign service contributions are paid", "B": "Never counts", "C": "Counts automatically", "D": "Forfeits past service"}, "answer": "A", "i": "q4y20limdb1"}, {"q": "Resignation from service:", "options": {"A": "Adds bonus service", "B": "Is treated as retirement", "C": "Has no effect on service", "D": "Forfeits past qualifying service"}, "answer": "D", "i": "q1xyrfeytywu"}, {"q": "Resignation to join another government post with proper permission:", "options": {"A": "Always forfeits service", "B": "Is not permitted", "C": "Preserves continuity of service", "D": "Needs a fresh start"}, "answer": "C", "i": "q2gb5twqxebq"}, {"q": "Dismissal or removal from service:", "options": {"A": "Has no effect", "B": "Reduces pension slightly", "C": "Is treated as retirement", "D": "Forfeits past service with no pension"}, "answer": "D", "i": "qkko8lqottl"}, {"q": "On compulsory retirement imposed as a penalty, the servant gets:", "options": {"A": "Pension or gratuity at not less than two-thirds of admissible", "B": "Full pension without reduction", "C": "No benefit at all", "D": "Double pension"}, "answer": "A", "i": "q1ahwdrzy6al"}, {"q": "Voluntary retirement can be sought after:", "options": {"A": "30 years", "B": "33 years", "C": "10 years", "D": "20 years"}, "answer": "D", "i": "ql3m3pihn6j"}, {"q": "The notice period for voluntary retirement is:", "options": {"A": "One week", "B": "One month", "C": "Three months", "D": "One year"}, "answer": "C", "i": "q1r81au0z9x5"}, {"q": "Joining time availed on transfer:", "options": {"A": "Counts as qualifying service", "B": "Never counts", "C": "Counts at half rate", "D": "Is treated as leave"}, "answer": "A", "i": "qxestpyfqy4"}, {"q": "Study leave:", "options": {"A": "Never counts", "B": "Breaks service", "C": "Counts at half rate", "D": "Counts as qualifying service"}, "answer": "D", "i": "q2d56l72hqpq"}, {"q": "Maternity leave:", "options": {"A": "Breaks continuity", "B": "Counts only once", "C": "Never counts", "D": "Counts as qualifying service"}, "answer": "D", "i": "qbbbi5d7fzc"}, {"q": "Periods of strike treated as dies non:", "options": {"A": "Do not count", "B": "Count fully", "C": "Count at double rate", "D": "Add bonus service"}, "answer": "A", "i": "q1jcils60lra"}, {"q": "Overstayal of sanctioned leave:", "options": {"A": "Always counts", "B": "Never counts under any condition", "C": "Counts only if regularized as leave", "D": "Counts at double rate"}, "answer": "C", "i": "qkkkdygnjxt"}, {"q": "Verification of qualifying service is done by:", "options": {"A": "The bank", "B": "The union", "C": "The servant himself", "D": "The Head of Office from the service book"}, "answer": "D", "i": "qud7dy9mhe9"}, {"q": "The primary record for service verification is:", "options": {"A": "The pay slip", "B": "The attendance register", "C": "The bank statement", "D": "The service book"}, "answer": "D", "i": "qsbycm7bbrn"}, {"q": "Periods spent under imprisonment:", "options": {"A": "Do not count", "B": "Count fully", "C": "Count at half rate", "D": "Add bonus service"}, "answer": "A", "i": "q730k2j6lk1"}, {"q": "Service during which the servant holds a lien on a post:", "options": {"A": "Never counts", "B": "Breaks service", "C": "Counts as qualifying service", "D": "Counts at half rate"}, "answer": "C", "i": "qiikooez979"}, {"q": "Former military service:", "options": {"A": "Never counts", "B": "May count under the prescribed conditions", "C": "Always counts automatically", "D": "Forfeits civil service"}, "answer": "B", "i": "q26shtjc747v"}, {"q": "Work-charged service:", "options": {"A": "Always counts", "B": "Counts at double rate", "C": "Counts after 3 years", "D": "Does not count unless converted"}, "answer": "D", "i": "q4k26asogi4"}, {"q": "Part-time service:", "options": {"A": "Does not count", "B": "Counts fully", "C": "Counts at half rate", "D": "Counts after 10 years"}, "answer": "A", "i": "q25whwk01j5k"}, {"q": "A servant with 9 years and 6 months of service gets:", "options": {"A": "Full pension", "B": "Half pension", "C": "Service gratuity only", "D": "Nothing"}, "answer": "C", "i": "q194sgetgzfp"}, {"q": "Interruption caused by resignation or dismissal:", "options": {"A": "Breaks continuity of service", "B": "Has no effect", "C": "Adds bonus service", "D": "Is always condoned"}, "answer": "A", "i": "q1p81dva2huo"}, {"q": "Other interruptions in service:", "options": {"A": "Are never condoned", "B": "May be condoned by the competent authority", "C": "Are treated as qualifying", "D": "Double the service"}, "answer": "B", "i": "q1w0njsc7wlu"}, {"q": "Re-employment after retirement:", "options": {"A": "Adds to earlier service", "B": "Doubles the pension", "C": "Does not add to the earlier qualifying service", "D": "Cancels the earlier pension"}, "answer": "C", "i": "qrnh1s55hkx"}, {"q": "On permanent absorption in a PSU:", "options": {"A": "Forfeits everything", "B": "Pro-rata pension may be admissible for past service", "C": "Service is doubled", "D": "Nothing is payable"}, "answer": "B", "i": "q2dkd9xa20b7"}, {"q": "The age of superannuation is:", "options": {"A": "55 years", "B": "58 years", "C": "62 years", "D": "60 years"}, "answer": "D", "i": "qha46zwwoqj"}, {"q": "On transfer to another government department:", "options": {"A": "Past service counts with the new department", "B": "Past service is forfeited", "C": "Service restarts", "D": "Pension is lost"}, "answer": "A", "i": "q17fvdom0dfz"}, {"q": "Suspension ending only in censure, with the period treated as duty:", "options": {"A": "Never counts", "B": "Always counts", "C": "Counts if treated as duty", "D": "Counts at half rate"}, "answer": "C", "i": "q1ho48d8mhx3"}, {"q": "Leave without pay:", "options": {"A": "Always counts", "B": "Does not count", "C": "Counts at double rate", "D": "Adds bonus service"}, "answer": "B", "i": "qxa95x3o6ft"}, {"q": "Periods during which no pay was drawn:", "options": {"A": "Always count", "B": "Count at half rate", "C": "Count after condonation", "D": "Do not count"}, "answer": "D", "i": "q13z8hh8qs8w"}, {"q": "Deputation while retaining a lien on the parent post:", "options": {"A": "Counts as qualifying service", "B": "Breaks service", "C": "Never counts", "D": "Counts at half rate"}, "answer": "A", "i": "q2ds5mscebrg"}, {"q": "Training abroad treated as duty:", "options": {"A": "Never counts", "B": "Counts as qualifying service", "C": "Breaks service", "D": "Counts at half rate"}, "answer": "B", "i": "q13n60vlxlik"}, {"q": "Verification of qualifying service must be completed:", "options": {"A": "After retirement", "B": "Never needed", "C": "Before retirement", "D": "After 5 years of retirement"}, "answer": "C", "i": "q21y295qbz0v"}, {"q": "Temporary service followed without break by permanent appointment:", "options": {"A": "Never counts", "B": "Counts only from confirmation", "C": "Counts at half rate", "D": "Counts from the start if continuous"}, "answer": "D", "i": "q28clbcvjdgp"}, {"q": "Service in a non-pensionable establishment:", "options": {"A": "Does not count", "B": "Counts fully", "C": "Counts at double rate", "D": "Counts after 5 years"}, "answer": "A", "i": "q47drcnkmgo"}, {"q": "For pension eligibility:", "options": {"A": "9 years is enough", "B": "Ten completed years are required", "C": "Ten years including EOL always", "D": "Any service over 5 years"}, "answer": "B", "i": "qgytmxa93u0"}]