[{"q":"The Pink Book contains?","options":{"A":"Train timings","B":"The sanctioned works programme of the railway","C":"Staff seniority","D":"Stores catalogue"},"answer":"B"},{"q":"Works programme proposals are vetted by finance for?","options":{"A":"Binding quality","B":"Grammar","C":"Financial appraisal","D":"Spelling"},"answer":"C"},{"q":"ROR stands for?","options":{"A":"Rate of Repair","B":"Railway Operating Ratio","C":"Rate of Return","D":"Return on Roads"},"answer":"C"},{"q":"ROR is used for?","options":{"A":"Train punctuality","B":"Staff promotions","C":"Ticket design","D":"Financial appraisal of projects"},"answer":"D"},{"q":"Detailed estimates are vetted by finance?","options":{"A":"Only for big cities","B":"After completion","C":"Before sanction","D":"Never"},"answer":"C"},{"q":"D and G charges mean?","options":{"A":"Damage and Goods charges","B":"Direction and General charges (departmental charges)","C":"Daily and General charges","D":"Depot and Godown charges"},"answer":"B"},{"q":"Departmental charges are added to works estimates towards?","options":{"A":"Train fares","B":"Staff bonuses","C":"Contractor profit","D":"Supervision and establishment costs"},"answer":"D"},{"q":"An abstract estimate is?","options":{"A":"A final account","B":"A preliminary rough-cost estimate","C":"A completion report","D":"A tender form"},"answer":"B"},{"q":"A revised estimate becomes necessary when?","options":{"A":"Costs exceed the sanctioned estimate beyond tolerance","B":"The engineer retires","C":"The season changes","D":"The contractor is happy"},"answer":"A"},{"q":"A supplementary estimate covers?","options":{"A":"Staff salaries","B":"Train fuel","C":"Routine maintenance","D":"Additional scope not in the original sanction"},"answer":"D"},{"q":"A completion report is?","options":{"A":"An attendance sheet","B":"A leave application","C":"A tender notice","D":"The final account of a completed work"},"answer":"D"},{"q":"In rate analysis of an estimate, what does finance verify?","options":{"A":"That rates are based on accepted schedules and market rates","B":"Only the contractor's profit margin","C":"The colour of the estimate book","D":"The seniority of the estimator"},"answer":"A"},{"q":"Survey estimates precede?","options":{"A":"Train running","B":"Sanction of new lines and gauge conversion works","C":"Ticket printing","D":"Staff recruitment"},"answer":"B"},{"q":"Deposit works are?","options":{"A":"Secret works","B":"Abandoned works","C":"Works done free of cost","D":"Works done for outside parties on deposit of cost"},"answer":"D"},{"q":"Finance vetting of deposit works ensures?","options":{"A":"Faster execution","B":"Less paperwork","C":"Free service","D":"Full cost recovery including departmental charges"},"answer":"D"},{"q":"Financial viability of a project means?","options":{"A":"It looks attractive","B":"Benefits justify the investment as shown by ROR","C":"It is near a city","D":"It uses new technology"},"answer":"B"},{"q":"An urgency certificate allows?","options":{"A":"Free travel","B":"Unlimited spending","C":"Skipping audit forever","D":"Starting work before formal sanction in emergencies"},"answer":"D"},{"q":"New works need?","options":{"A":"No sanction","B":"Inclusion in the Pink Book or sanctioned programme","C":"Only verbal orders","D":"Contractor approval"},"answer":"B"},{"q":"Finance association in land acquisition covers?","options":{"A":"Soil colour","B":"Fencing design","C":"Train speeds","D":"Compensation and funding aspects"},"answer":"D"},{"q":"The allocation head for a work is decided?","options":{"A":"By lottery","B":"By the press","C":"By the contractor","D":"With finance concurrence"},"answer":"D"},{"q":"Finance helps decide classification between?","options":{"A":"Trains and buses","B":"Plan heads and revenue vs capital","C":"Stations and yards","D":"Day and night"},"answer":"B"},{"q":"Cost-sharing works with outside agencies need?","options":{"A":"Verbal promises","B":"Secret deals","C":"No agreement","D":"Finance vetting of sharing terms"},"answer":"D"},{"q":"The authority to sanction an estimate depends on?","options":{"A":"The weather","B":"The cost of the work as per the SOP","C":"The contractor","D":"The district"},"answer":"B"},{"q":"Material-at-site accounts are checked by?","options":{"A":"The press","B":"Nobody","C":"The contractor","D":"Finance during works audit"},"answer":"D"},{"q":"Excess expenditure over the sanctioned estimate needs?","options":{"A":"Hiding it","B":"Contractor funding","C":"No action","D":"Revised sanction with finance concurrence"},"answer":"D"},{"q":"Savings on a sanctioned work?","options":{"A":"Can be spent freely","B":"Are reported; diversion needs re-appropriation","C":"Belong to the contractor","D":"Are hidden"},"answer":"B"},{"q":"In lumpsum contracts, finance vets?","options":{"A":"The site location","B":"The labour names","C":"The contractor's family","D":"Payment terms"},"answer":"D"},{"q":"Piece-work agreements need finance association?","options":{"A":"Only in cities","B":"Only for painting","C":"Never","D":"Above delegated limits"},"answer":"D"},{"q":"In departmental execution of works, finance checks?","options":{"A":"Train timings","B":"Labour and material accounting","C":"Staff uniforms","D":"Canteen menu"},"answer":"B"},{"q":"Track renewal works are charged?","options":{"A":"As per rules with finance advice on allocation","B":"Randomly","C":"To staff","D":"To passengers"},"answer":"A"},{"q":"Safety works are funded?","options":{"A":"By contractors","B":"By passengers","C":"From any head","D":"From earmarked funds with finance monitoring"},"answer":"D"},{"q":"Customer-funded sidings are treated as?","options":{"A":"Free works","B":"Deposit works with finance vetting","C":"Gifts","D":"Revenue works"},"answer":"B"},{"q":"Estimates for staff quarters are?","options":{"A":"Never sanctioned","B":"Done verbally","C":"Exempt from vetting","D":"Vetted like other works"},"answer":"D"},{"q":"Electrical works estimates need?","