[{"q": "Railway Budget Estimates are prepared for which period?", "options": {"A": "January to December", "B": "April to March financial year", "C": "July to June", "D": "Two financial years"}, "answer": "B", "i": "q25cc1x9pbdr"}, {"q": "Budget estimates are mainly based on:", "options": {"A": "Staff wishes", "B": "Political promises", "C": "Random growth rates", "D": "Actuals of past years and current trends"}, "answer": "D", "i": "q1r8z1ch3nan"}, {"q": "Estimates are built up starting from:", "options": {"A": "Station and depot level upward to the Board", "B": "Board downward only", "C": "Zones independently", "D": "Divisions only"}, "answer": "A", "i": "q7jf1n21rzj"}, {"q": "Divisional estimates are consolidated at:", "options": {"A": "Station level", "B": "Depot level", "C": "Zonal headquarters", "D": "Parliament"}, "answer": "C", "i": "q7kzrsqpan6"}, {"q": "New expenditure proposals in the estimates require:", "options": {"A": "No approval", "B": "Sanction of the competent authority", "C": "Staff consent", "D": "Court order"}, "answer": "B", "i": "qxm9rldoe3k"}, {"q": "Expenditure on a new service requires:", "options": {"A": "DRM sanction alone", "B": "Verbal orders", "C": "Audit pre-approval", "D": "Parliament approval with token provision"}, "answer": "D", "i": "q64jsxy7x01"}, {"q": "Provision for arrears in the estimates covers:", "options": {"A": "Past dues like pay revision arrears", "B": "Future profits", "C": "Fines imposed", "D": "Donations"}, "answer": "A", "i": "q240ud10py3f"}, {"q": "Establishment estimates are generally framed on:", "options": {"A": "Only filled posts", "B": "Retired staff count", "C": "Sanctioned strength at mean rates of pay", "D": "Daily wage rates"}, "answer": "C", "i": "q26m9uxsumyw"}, {"q": "Revenue earnings estimates depend mainly on:", "options": {"A": "Staff strength", "B": "Traffic trends and tariff policy", "C": "Number of stations", "D": "Fuel prices only"}, "answer": "B", "i": "qf4p8jpi1rt"}, {"q": "The Finance Branch's role in budget estimates is:", "options": {"A": "Ignoring them", "B": "Spending them", "C": "Approving works", "D": "Scrutiny, consolidation and vetting"}, "answer": "D", "i": "q1lslgrzvx26"}, {"q": "Works expenditure estimates originate from:", "options": {"A": "Divisional works programme proposals", "B": "Parliament directly", "C": "Suppliers", "D": "Banks"}, "answer": "A", "i": "q1mfsjnyx9qx"}, {"q": "Material and stores estimates consider:", "options": {"A": "Only prices", "B": "Only quantity", "C": "Consumption, stock in hand and lead time", "D": "Supplier preference"}, "answer": "C", "i": "qeuxbu4g9c4"}, {"q": "Fuel estimates are based on:", "options": {"A": "Fixed quota", "B": "Traffic output and consumption norms", "C": "Tender rates only", "D": "Last month's bill"}, "answer": "B", "i": "qg24hm74a5m"}, {"q": "Contingency provision in the estimates is meant for:", "options": {"A": "Salaries", "B": "Pensions", "C": "Loan repayment", "D": "Unforeseen minor expenditure"}, "answer": "D", "i": "qiuls9hr18"}, {"q": "Budget estimates must be:", "options": {"A": "Realistic, neither inflated nor understated", "B": "Always doubled", "C": "Always halved", "D": "Copied from last year"}, "answer": "A", "i": "q11llnwmrmuf"}, {"q": "A lump-sum provision in the estimates means:", "options": {"A": "Detailed breakup", "B": "Salary head", "C": "Unallocated reserve for emergent needs", "D": "Loan amount"}, "answer": "C", "i": "q17j7lcjnlyi"}, {"q": "Estimate committees at divisional level:", "options": {"A": "Sanction works", "B": "Review and rationalize the estimates", "C": "Collect fares", "D": "Audit accounts"}, "answer": "B", "i": "q10b91xb0q27"}, {"q": "Before submission to the Board, zonal estimates are:", "options": {"A": "Ignored", "B": "Published", "C": "Spent", "D": "Scrutinized by the zonal estimate committee"}, "answer": "D", "i": "q17n02rngsi5"}, {"q": "Estimates under suspense heads cover:", "options": {"A": "Advances recoverable and adjustable items", "B": "Salaries", "C": "Pensions", "D": "Grants"}, "answer": "A", "i": "q1rqqsk64g2h"}, {"q": "The timetable for submitting estimates is fixed by:", "options": {"A": "Parliament", "B": "Courts", "C": "Budget calendar issued by the Board", "D": "Zones"}, "answer": "C", "i": "q1y8qb2txhab"}, {"q": "Standing sanctions in the estimates refer to:", "options": {"A": "New proposals", "B": "Continuing sanctioned schemes", "C": "Cancelled works", "D": "Court decrees"}, "answer": "B", "i": "qaasqdmjeog"}, {"q": "Provision for dearness allowance is based on:", "options": {"A": "Fixed sum", "B": "Last year's bill", "C": "Staff demand", "D": "Sanctioned strength and expected DA rates"}, "answer": "D", "i": "qfwxf0esjgq"}, {"q": "Overtime provision is estimated from:", "options": {"A": "Past trends of overtime working", "B": "Staff wishes", "C": "Fixed ten percent", "D": "Zero provision"}, "answer": "A", "i": "q19dr06e7r59"}, {"q": "The estimates must distinguish between:", "options": {"A": "Cash and kind", "B": "Men and women", "C": "Voted and charged expenditure", "D": "Zones"}, "answer": "C", "i": "qidp602d3ny"}, {"q": "Charged expenditure in the estimates:", "options": {"A": "Needs Lok Sabha vote", "B": "Is not voted but shown for information", "C": "Is optional", "D": "Needs no provision"}, "answer": "B", "i": "q21jycbr5sg6"}, {"q": "Token provision is made for:", "options": {"A": "Salaries", "B": "Pensions", "C": "Fuel", "D": "New services awaiting Parliament approval"}, "answer": "D", "i": "q1hs9gnb5qxo"}, {"q": "Estimates for debt servicing include:", "options": {"A": "Interest and repayment obligations", "B": "New loans only", "C": "Staff advances", "D": "Nothing"}, "answer": "A", "i": "qwgh7v6wdjx"}, {"q": "Depreciation Reserve Fund provision is based on:", "options": {"A": "Random figure", "B": "Staff strength", "C": "Asset values and prescribed rates", "D": "Earnings"}, "answer": "C", "i": "qmx4rwocnqn"}, {"q": "Appropriation to the Development Fund depends on:", "options": {"A": "Wishes", "B": "Surplus availability and policy", "C": "Loans", "D": "Grants"}, "answer": "B", "i": "qih8ft52gy0"}, {"q": "Pension liability estimates use:", "options": {"A": "Current staff only", "B": "Random figures", "C": "Last month's data", "D": "Past trends of retirements"}, "answer": "D", "i": "q91xpqhxnc6"}, {"q": "Traffic earnings estimates are split into:", "options": {"A": "Coaching, goods and other earnings", "B": "Only goods", "C": "Only coaching", "D": "Only parcels"}, "answer": "A", "i": "q196lqln1nzv"}, {"q": "Ordinary working expenses estimates cover:", "options": {"A": "New lines", "B": "Gauge conversion", "C": "Day-to-day operations and maintenance", "D": "Dividends"}, "answer": "C", "i": "q1hfu74zou1a"}, {"q": "The budget calendar ensures:", "options": {"A": "Late submission", "B": "Timely, staged preparation of estimates", "C": "No estimates", "D": "Audit first"}, "answer": "B", "i": "q15nph8loq2p"}, {"q": "Estimates must provide for liabilities:", "options": {"A": "Never", "B": "Only if paid", "C": "After March", "D": "Likely to materialize within the year"}, "answer": "D", "i": "q266uo34r670"}, {"q": "Surrender of savings means:", "options": {"A": "Giving up unneeded provisions", "B": "Extra spending", "C": "New loans", "D": "Donations"}, "answer": "A", "i": "q5qbpjig2w7"}, {"q": "Provision for works in progress is based on:", "options": {"A": "Total cost", "B": "Sanctioned cost only", "C": "Expected progress and cash flow", "D": "Tender value"}, "answer": "C", "i": "q25v6x89t3n4"}, {"q": "Establishment charges on works are provided as:", "options": {"A": "Fixed salary", "B": "Percentage of works outlay", "C": "Lump sum", "D": "Not provided"}, "answer": "B", "i": "q17b8odmdxtc"}, {"q": "Estimates for medical facilities are based on:", "options": {"A": "Staff demand", "B": "Fixed per zone", "C": "Last year doubled", "D": "Past expenditure and sanctioned facilities"}, "answer": "D", "i": "qejcithso20"}, {"q": "The first stage of estimate preparation starts at:", "options": {"A": "Field units at ground level", "B": "Parliament", "C": "Board", "D": "Audit"}, "answer": "A", "i": "qlvepmisgvq"}, {"q": "Final budget estimates are approved by:", "options": {"A": "DRM", "B": "GM alone", "C": "Parliament through Demands for Grants", "D": "CAG"}, "answer": "C", "i": "qs9z6d0mdmk"}]