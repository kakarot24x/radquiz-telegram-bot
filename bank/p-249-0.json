[{"q": "The Pink Book contains:", "options": {"A": "Fare tables", "B": "Works, Machinery and Rolling Stock programme", "C": "Staff list", "D": "Audit paras"}, "answer": "B", "i": "q2u6bflrov8"}, {"q": "The White Paper on Railways presents:", "options": {"A": "Tenders", "B": "Staff rules", "C": "Timetables", "D": "Summary of railway working and finances"}, "answer": "D", "i": "q1o8u9xjs4fz"}, {"q": "The Explanatory Memorandum:", "options": {"A": "Explains variations between estimates", "B": "Lists trains", "C": "Gives fares", "D": "Sanctions works"}, "answer": "A", "i": "q2ak8knh4h3k"}, {"q": "Demands for Grants for Railways are:", "options": {"A": "10 in number", "B": "20 in number", "C": "16 demands for railways", "D": "Unlimited"}, "answer": "C", "i": "q27t3yamlqfy"}, {"q": "The Appropriation Bill:", "options": {"A": "Raises fares", "B": "Authorizes withdrawal from Consolidated Fund", "C": "Appoints staff", "D": "Fixes timetables"}, "answer": "B", "i": "qmlr59wujtl"}, {"q": "The Railway Budget was merged with the General Budget from:", "options": {"A": "2014-15", "B": "2015-16", "C": "2016-17", "D": "2017-18"}, "answer": "D", "i": "qwmj2jtk9u9"}, {"q": "The separate Railway Budget was introduced on the recommendation of:", "options": {"A": "Acworth Committee", "B": "CAG", "C": "Planning Commission", "D": "Parliament"}, "answer": "A", "i": "q1ymfg5dt518"}, {"q": "The merger of the Railway Budget was recommended by:", "options": {"A": "Acworth Committee", "B": "CAG", "C": "Bibek Debroy Committee", "D": "PAC"}, "answer": "C", "i": "q1fiubv44kd6"}, {"q": "After the merger, the Railway Budget is presented by:", "options": {"A": "Railway Minister separately", "B": "Finance Minister with the General Budget", "C": "CAG", "D": "Prime Minister"}, "answer": "B", "i": "q1jc51r747tf"}, {"q": "Vote on Account covers:", "options": {"A": "Full year", "B": "Audit only", "C": "Pensions only", "D": "Part of the year pending full budget"}, "answer": "D", "i": "qmo3k5q1926"}, {"q": "T