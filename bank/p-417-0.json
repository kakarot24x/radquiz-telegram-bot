[{"q": "What does UTS stand for in Indian Railways ticketing?", "options": {"A": "Universal Ticket Scheme", "B": "Unreserved Ticketing System", "C": "Urban Transit System", "D": "Unified Travel Service"}, "answer": "B", "i": "q1vihjloiion"}, {"q": "UTS journey tickets are normally valid for travel on", "options": {"A": "any day within a week", "B": "the return date only", "C": "the day of issue", "D": "24 hours from midnight"}, "answer": "C", "i": "q1lxalzr6fvr"}, {"q": "Paperless tickets on the UTS mobile app can be booked", "options": {"A": "from anywhere in India", "B": "only at booking counters", "C": "within the geo-fenced area near the station", "D": "only through SMS request"}, "answer": "C", "i": "qef9dbyxhzy"}, {"q": "A Monthly Season Ticket (MST) is valid for", "options": {"A": "one calendar month", "B": "30 days from purchase", "C": "28 days", "D": "45 days"}, "answer": "A", "i": "q9fwijui5yz"}, {"q": "Children below the age of five", "options": {"A": "travel free without a ticket", "B": "need a platform ticket", "C": "need a full ticket", "D": "need a half ticket"}, "answer": "A", "i": "q256ccc58y5x"}, {"q": "Children aged 5 to 12 are charged", "options": {"A": "half the adult fare", "B": "one-third of adult fare", "C": "one-fourth of adult fare", "D": "full adult fare"}, "answer": "A", "i": "q1v76fr8qg8e"}, {"q": "UTS tickets can be purchased from", "options": {"A": "the station master's office only", "B": "only reservation counters", "C": "TTEs on board", "D": "ATVMs"}, "answer": "D", "i": "q2clpv9405r3"}, {"q": "ATVM stands for", "options": {"A": "Automatic Ticket Verification Machine", "B": "Advanced Travel Verification Module", "C": "Automated Ticket Vending Machine", "D": "Assisted Travel Vending Module"}, "answer": "C", "i": "q1ywt2tn5ypl"}, {"q": "A Quarterly Season Ticket (QST) is valid for", "options": {"A": "100 days", "B": "60 days", "C": "three months", "D": "six months"}, "answer": "C", "i": "q1jsi9y3h9e2"}, {"q": "Season tickets are issued for travel between", "options": {"A": "a fixed pair of stations", "B": "any two stations", "C": "only suburban stations", "D": "all stations in a zone"}, "answer": "A", "i": "q21wskxhmaam"}, {"q": "A paperless UTS ticket is proved during checking by", "options": {"A": "a counter stamp", "B": "the booking shown on the passenger's mobile", "C": "a printed slip only", "D": "the guard's register"}, "answer": "B", "i": "q1iwztcai6qx"}, {"q": "Which of these is NOT sold through UTS?", "options": {"A": "season tickets", "B": "reserved berths", "C": "journey tickets", "D": "platform tickets"}, "answer": "B", "i": "q289zwvqfhf1"}, {"q": "Platform tickets are issued to", "options": {"A": "non-passengers entering the platform", "B": "TTEs", "C": "licensed vendors only", "D": "passengers"}, "answer": "A", "i": "q167tgk8yus1"}, {"q": "A UTS smart card can be recharged at", "options": {"A": "ATVMs and booking counters", "B": "only online", "C": "TTEs on trains", "D": "guards' vans"}, "answer": "A", "i": "q1ha0fkh4v0y"}, {"q": "Break of journey on an ordinary ticket is permitted when the distance exceeds", "options": {"A": "200 km", "B": "1500 km", "C": "100 km", "D": "500 km"}, "answer": "D", "i": "q1iykl5ewyhd"}, {"q": "A season ticket holder may travel", "options": {"A": "in AC classes on payment", "B": "without any ticket", "C": "in any class", "D": "only in the class for which it is issued"}, "answer": "D", "i": "q238hask27ux"}, {"q": "PRS stands for", "options": {"A": "Premium Reservation Scheme", "B": "Passenger Reservation System", "C": "Public Railway Service", "D": "Passenger Refund System"}, "answer": "B", "i": "q1l1ax34ps2r"}, {"q": "The Advance Reservation Period (ARP) is currently", "options": {"A": "120 days", "B": "30 days", "C": "90 days", "D": "60 days"}, "answer": "D", "i": "q4yz3olg71n"}, {"q": "Reservation at a PRS counter can be made for", "options": {"A": "only Rajdhani trains", "B": "only local trains", "C": "trains across the Indian Railways network", "D": "only that station's trains"}, "answer": "C", "i": "qgxrrqbt92a"}, {"q": "Which class carries the highest reservation charge?", "options": {"A": "AC 3-tier", "B": "AC first class", "C": "AC 2-tier", "D": "sleeper"}, "answer": "B", "i": "q163rxbt4gt0"}, {"q": "The reservation charge for sleeper class is", "options": {"A": "Rs. 60", "B": "Rs. 40", "C": "Rs. 10", "D": "Rs. 20"}, "answer": "D", "i": "q1hxincstrrv"}, {"q": "Tatkal bookings open", "options": {"A": "two days before travel", "B": "a week before travel", "C": "on the day of travel", "D": "one day before the date of journey"}, "answer": "D", "i": "q16ybew8djg3"}, {"q": "RAC stands for", "options": {"A": "Railway Accommodation Cell", "B": "Reserved And Confirmed", "C": "Random Allocation Code", "D": "Reservation Against Cancellation"}, "answer": "D", "i": "q149rsapa1lb"}, {"q": "A fully waitlisted e-ticket after chart preparation is", "options": {"A": "converted to RAC", "B": "valid for travel", "C": "automatically cancelled with fare refunded", "D": "upgraded free of charge"}, "answer": "C", "i": "q20n8ln2b0nd"}, {"q": "Reservation charts are normally prepared", "options": {"A": "30 minutes before departure", "B": "24 hours before departure", "C": "at departure time", "D": "about 4 hours before departure"}, "answer": "D", "i": "q243d1c6dbv3"}, {"q": "Photo ID proof is compulsory while travelling on", "options": {"A": "platform tickets", "B": "e-tickets", "C": "all tickets", "D": "season tickets"}, "answer": "B", "i": "qp7w5c553mr"}, {"q": "Which is accepted as ID proof for e-ticket travel?", "options": {"A": "library card", "B": "office memo", "C": "PAN card", "D": "credit card"}, "answer": "C", "i": "q10001aldaqd"}, {"q": "PNR stands for", "options": {"A": "Passenger Number Receipt", "B": "Passenger Name Record", "C": "Public Notification Register", "D": "Premium Network Route"}, "answer": "B", "i": "qqadxqd6qe3"}, {"q": "Reservation from a station other than the journey's start is allowed", "options": {"A": "only for Rajdhani trains", "B": "subject to quota availability", "C": "never", "D": "only in sleeper class"}, "answer": "B", "i": "q1gvxz8qua3i"}, {"q": "A duplicate reserved ticket can be issued", "options": {"A": "free at any counter", "B": "only for AC classes", "C": "on payment of prescribed charges before charting", "D": "never"}, "answer": "C", "i": "q1u3g09k1ez1"}, {"q": "The maximum passengers allowed per e-ticket PNR is", "options": {"A": "8", "B": "4", "C": "6", "D": "10"}, "answer": "C", "i": "q22o7g0c839e"}, {"q": "Senior citizen fare concession in reserved classes is at present", "options": {"A": "40 percent", "B": "50 percent", "C": "25 percent", "D": "withdrawn"}, "answer": "D", "i": "q1883l5ubvof"}, {"q": "The minimum cancellation charge per passenger is", "options": {"A": "Rs. 60", "B": "Rs. 30", "C": "Rs. 120", "D": "Rs. 100"}, "answer": "A", "i": "q20t6ky6mxz4"}, {"q": "A confirmed ticket can be cancelled up to", "options": {"A": "at departure", "B": "1 hour before departure", "C": "4 hours before scheduled departure", "D": "12 hours before departure"}, "answer": "C", "i": "q1houiqd5i2l"}, {"q": "RAC and waitlisted tickets can be cancelled up to", "options": {"A": "4 hours before departure", "B": "1 hour after departure", "C": "charting time", "D": "30 minutes before scheduled departure"}, "answer": "D", "i": "q2cret11fqrf"}, {"q": "Cancellation charge for a confirmed AC 3-tier ticket cancelled over 48 hours before departure is", "options": {"A": "Rs. 90", "B": "Rs. 180", "C": "Rs. 240", "D": "Rs. 120"}, "answer": "B", "i": "q1fuzgkhhjbn"}, {"q": "If cancelled between 72 hours and 24 hours before departure, the charge is", "options": {"A": "25% of fare", "B": "40% of fare", "C": "75% of fare", "D": "10% of fare"}, "answer": "A", "i": "q1hh1nehafjn"}, {"q": "If cancelled between 24 hours and 8 hours before departure, the charge is", "options": {"A": "50% of fare", "B": "25% of fare", "C": "75% of fare", "D": "100% of fare"}, "answer": "A", "i": "q1wj7y3373mo"}, {"q": "Unused RAC or waitlisted counter tickets qualify for refund if presented within", "options": {"A": "24 hours", "B": "7 days", "C": "1 hour of departure", "D": "3 hours after actual departure"}, "answer": "D", "i": "qd4noe5ijsb"}, {"q": "The IRCTC convenience fee on a cancelled e-ticket is", "options": {"A": "non-refundable", "B": "refunded fully", "C": "refunded by half", "D": "adjusted in rebooking"}, "answer": "A", "i": "q2bjtu83xxqv"}, {"q": "TDR is filed for an e-ticket when", "options": {"A": "ID is lost", "B": "refund is due but online cancellation is no longer possible", "C": "berth is confirmed", "D": "booking is made"}, "answer": "B", "i": "q2f1jd9ufwoy"}, {"q": "Refund for a cancelled e-ticket is credited to", "options": {"A": "a railway wallet", "B": "the station master", "C": "cash at any counter", "D": "the account or card used for booking"}, "answer": "D", "i": "q1enpyf6yr90"}, {"q": "If a train is cancelled by the railways, passengers get", "options": {"A": "credit note only", "B": "no refund", "C": "50% refund", "D": "full refund without cancellation charges"}, "answer": "D", "i": "q22fjwo59t56"}, {"q": "If a train runs over 3 hours late and the passenger does not travel", "options": {"A": "only 50% is refunded", "B": "full refund is admissible", "C": "refund needs a court order", "D": "no refund is due"}, "answer": "B", "i": "q1183qwnj47w"}, {"q": "A PRS counter ticket can be cancelled at", "options": {"A": "only the originating station", "B": "online only", "C": "any computerized reservation counter", "D": "only the issuing counter"}, "answer": "C", "i": "qhznu2mdpyd"}, {"q": "A passenger travelling in a lower class than booked can claim", "options": {"A": "the fare difference on a certificate from the TTE", "B": "full refund", "C": "nothing", "D": "a free upgrade later"}, "answer": "A", "i": "qk4p94xfgq9"}, {"q": "In a partially confirmed e-ticket, the fare of waitlisted passengers is", "options": {"A": "held for a year", "B": "refunded automatically", "C": "donated", "D": "forfeited"}, "answer": "B", "i": "q69rdtls627"}, {"q": "No refund is admissible on a confirmed ticket surrendered", "options": {"A": "24 hours before departure", "B": "5 hours before departure", "C": "48 hours before departure", "D": "after the train has departed"}, "answer": "D", "i": "q7a7uoj1r83"}, {"q": "E-tickets are booked through", "options": {"A": "the IRCTC website or app", "B": "station counters", "C": "travel agents only", "D": "TTEs"}, "answer": "A", "i": "q4lzsf9ikmd"}, {"q": "TDR stands for", "options": {"A": "Travel Document Record", "B": "Train Delay Report", "C": "Ticket Deposit Receipt", "D": "Ticket Duty Register"}, "answer": "C", "i": "q2anuawkqt7s"}, {"q": "An e-ticket cannot be cancelled at a railway reservation counter. This is", "options": {"A": "true only for Tatkal", "B": "false", "C": "true", "D": "true only for waitlisted"}, "answer": "C", "i": "qz9z92v3cr3"}, {"q": "Boarding point on an e-ticket can be changed up to", "options": {"A": "24 hours before departure", "B": "at charting", "C": "6 hours before departure", "D": "never"}, "answer": "A", "i": "q1e7765s3kca"}, {"q": "After chart preparation, an e-ticket can be cancelled", "options": {"A": "not at all", "B": "through the TTE", "C": "only through TDR", "D": "at any counter"}, "answer": "C", "i": "qw4s14hhiqh"}, {"q": "A waitlisted passenger holding a counter (paper) ticket", "options": {"A": "cannot board the train", "B": "gets an automatic refund", "C": "is fined", "D": "may board subject to the TTE's discretion"}, "answer": "D", "i": "q1tymqk9w2kz"}, {"q": "E-ticket fares include", "options": {"A": "catering always", "B": "insurance only", "C": "only base fare", "D": "base fare plus reservation and applicable surcharges"}, "answer": "D", "i": "qvt5froq535"}, {"q": "TDR claims are settled by crediting", "options": {"A": "station imprest", "B": "the original payment account", "C": "demand drafts", "D": "cash at counters"}, "answer": "B", "i": "q1gcvz0jrie6"}, {"q": "An e-ticket passenger must carry", "options": {"A": "a passport photo", "B": "the counter foil", "C": "only the SMS", "D": "an original prescribed photo ID"}, "answer": "D", "i": "qe9bmo9v2kb"}, {"q": "If the name on the e-ticket does not match the ID", "options": {"A": "the ticket is treated as invalid", "B": "the TTE endorses it", "C": "travel is still allowed", "D": "a Rs. 50 fine applies"}, "answer": "A", "i": "q25u9uujjfxn"}, {"q": "Tatkal e-tickets are", "options": {"A": "permitted only for AC", "B": "not permitted", "C": "permitted like counter Tatkal tickets", "D": "permitted only for sleeper"}, "answer": "C", "i": "qm54ngulgqm"}, {"q": "Cancellation of a confirmed e-ticket before charting is done", "options": {"A": "at any PRS counter", "B": "by email", "C": "through the TTE", "D": "online through IRCTC"}, "answer": "D", "i": "qzo2qk0vu56"}, {"q": "The PNR status of an e-ticket can be checked", "options": {"A": "only by the TTE", "B": "only at booking time", "C": "online and through SMS or helplines", "D": "only at stations"}, "answer": "C", "i": "q2c5wgofen6g"}, {"q": "E-tickets are issued as", "options": {"A": "printed card tickets", "B": "handwritten slips", "C": "electronic records with PNR", "D": "tokens"}, "answer": "C", "i": "q1gq7j45bxb1"}, {"q": "If an e-ticket remains fully waitlisted after charting, the passenger", "options": {"A": "may board anyway", "B": "pays the TTE", "C": "must not board and gets an automatic refund", "D": "travels in the guard's van"}, "answer": "C", "i": "q101tu9hghji"}, {"q": "Duplicate e-tickets", "options": {"A": "cost 50% of fare", "B": "need court orders", "C": "are not needed since PNR and ID suffice", "D": "are issued on payment"}, "answer": "C", "i": "q1cze5egq56m"}, {"q": "TTE stands for", "options": {"A": "Ticket Transfer Executive", "B": "Train Traffic Engineer", "C": "Transit Tax Evaluator", "D": "Travelling Ticket Examiner"}, "answer": "D", "i": "q17411fhiewx"}, {"q": "A passenger travelling without a ticket pays", "options": {"A": "ordinary fare plus an excess charge of Rs. 500", "B": "a fixed Rs. 1000 fine", "C": "only the fare", "D": "double the fare only"}, "answer": "A", "i": "qebsgszs5k3"}, {"q": "EFT stands for", "options": {"A": "Emergency Fare Token", "B": "Excess Fare Ticket", "C": "Extra Facility Tax", "D": "Electronic Fund Transfer"}, "answer": "B", "i": "q6vl4udxu8r"}, {"q": "An EFT is issued by", "options": {"A": "the station master", "B": "ticket checking staff on the train", "C": "the guard", "D": "booking clerks"}, "answer": "B", "i": "q23rd1r87nvi"}, {"q": "A sleeper ticket holder found travelling in AC 3-tier must pay", "options": {"A": "the full AC fare again", "B": "nothing extra", "C": "the fare difference with applicable excess charge", "D": "only the reservation charge"}, "answer": "C", "i": "q1mb8fjtz658"}, {"q": "Ticket sale revenue forms part of", "options": {"A": "sundry earnings", "B": "coaching (passenger) earnings", "C": "goods earnings", "D": "capital receipts"}, "answer": "B", "i": "qv1yewqu890"}, {"q": "Station cash earnings are remitted", "options": {"A": "daily", "B": "monthly", "C": "quarterly", "D": "weekly"}, "answer": "A", "i": "q2ejavcphwbb"}, {"q": "Excess fare collected by TTEs is accounted as", "options": {"A": "deposits", "B": "sundry earnings", "C": "suspense", "D": "coaching earnings"}, "answer": "D", "i": "q370cl48wj5"}, {"q": "Refund on an unused platform ticket is", "options": {"A": "admissible with charges", "B": "not admissible", "C": "half the price", "D": "admissible in full"}, "answer": "B", "i": "q29ku1fplrkt"}, {"q": "Station earnings are compiled in the", "options": {"A": "guard's journal", "B": "station balance sheet", "C": "signal register", "D": "engine log book"}, "answer": "B", "i": "q1fu5rhgdv1i"}, {"q": "Ticket checking staff submit", "options": {"A": "periodical ticket checking returns of earnings collected", "B": "no returns", "C": "engine diagrams", "D": "only verbal reports"}, "answer": "A", "i": "q1iyw2tw5als"}, {"q": "Computerized UTS and PRS mainly help traffic accounts by", "options": {"A": "speeding up trains", "B": "giving automatic fare calculation and auditable transaction records", "C": "printing colourful tickets", "D": "reducing staff"}, "answer": "B", "i": "qaw5ajx9vp"}, {"q": "A passenger with a valid ticket boarding the wrong train", "options": {"A": "is deboarded in all cases", "B": "may be charged the difference if the fare is higher", "C": "is always fined", "D": "travels free"}, "answer": "B", "i": "q576p6fai01"}, {"q": "Unclaimed refunds on tickets after the time limit go to", "options": {"A": "railway revenue", "B": "the TTE", "C": "the booking agent", "D": "the passenger"}, "answer": "A", "i": "qpbnnyfhyn1"}, {"q": "The reservation chart is the basis for", "options": {"A": "track maintenance", "B": "signal planning", "C": "engine rostering", "D": "on-board ticket checking and berth accounting"}, "answer": "D", "i": "q25nos3kwszr"}, {"q": "Season ticket holders are checked against", "options": {"A": "nothing", "B": "the guard's list", "C": "the reservation chart", "D": "the season ticket and an ID proof"}, "answer": "D", "i": "qppozfa82lz"}]