[{"q": "PNM on Indian Railways stands for:", "options": {"A": "Personnel Norms Manual", "B": "Productivity Negotiation Mission", "C": "Permanent Negotiating Machinery", "D": "Public Negotiation Mechanism"}, "answer": "C", "i": "qffmytt92ms"}, {"q": "The Permanent Negotiating Machinery was set up on Indian Railways in:", "options": {"A": "1966", "B": "1977", "C": "1947", "D": "1951"}, "answer": "D", "i": "q1ogs6yr4ro1"}, {"q": "How many tiers does the Permanent Negotiating Machinery have?", "options": {"A": "Two", "B": "Three", "C": "Four", "D": "Five"}, "answer": "B", "i": "q3xe9o6hb1d"}, {"q": "At the Railway Board level, PNM negotiations are held with:", "options": {"A": "Individual employees", "B": "AIRF and NFIR", "C": "State governments", "D": "Contractors"}, "answer": "B", "i": "q8skwux0b49"}, {"q": "AIRF stands for:", "options": {"A": "All India Roadways Federation", "B": "Associated Indian Railway Forum", "C": "All India Retiredmen's Federation", "D": "All India Railwaymen's Federation"}, "answer": "D", "i": "q10zntnsrfsi"}, {"q": "NFIR stands for:", "options": {"A": "New Federation of Indian Railmen", "B": "National Federation of Indian Railwaymen", "C": "Northern Federation of Indian Railways", "D": "National Forum of Indian Railways"}, "answer": "B", "i": "q1kgb4i2anqp"}, {"q": "At the zonal level, PNM meetings are held between the General Manager and:", "options": {"A": "Retired employees", "B": "Recognised unions of the zone", "C": "Members of Parliament", "D": "Divisional officers"}, "answer": "B", "i": "qxgm7kkhc9p"}, {"q": "At the divisional level, PNM meetings are held between the DRM and:", "options": {"A": "State labour department", "B": "Station masters only", "C": "Recognised unions of the division", "D": "Railway Board officials"}, "answer": "C", "i": "qakra0bp9ef"}, {"q": "The main objective of PNM is to:", "options": {"A": "Negotiate staff matters and prevent disputes", "B": "Award tenders", "C": "Inspect stations", "D": "Fix train fares"}, "answer": "A", "i": "q1ljqcya8p8e"}, {"q": "Which of the following is generally NOT taken up in PNM meetings?", "options": {"A": "Individual employee grievance cases", "B": "Policy matters affecting staff", "C": "Staff welfare measures", "D": "Service condition issues"}, "answer": "A", "i": "qpn5ci6gxvu"}, {"q": "Subjects for PNM discussion are normally submitted in the form of:", "options": {"A": "Agenda items in advance", "B": "Court petitions", "C": "Press releases", "D": "Verbal complaints"}, "answer": "A", "i": "q20f2e1kccdx"}, {"q": "Decisions reached in PNM meetings are recorded in:", "options": {"A": "Notice boards", "B": "Press notes", "C": "Minutes of the meeting", "D": "Personal diaries"}, "answer": "C", "i": "q1h2k5veyrvp"}, {"q": "PNM meetings are held:", "options": {"A": "Periodically at each tier", "B": "Once in ten years", "C": "Only at Board level", "D": "Only during strikes"}, "answer": "A", "i": "q29wkbhcb6xp"}, {"q": "The PNM machinery covers:", "options": {"A": "All railway servants including Group C and D", "B": "Only ministerial staff", "C": "Only running staff", "D": "Only officers"}, "answer": "A", "i": "qaqcc4gs53p"}, {"q": "Which matters are excluded from PNM purview?", "options": {"A": "Duty rosters", "B": "Welfare schemes", "C": "Matters under adjudication or individual cases", "D": "Canteen facilities"}, "answer": "C", "i": "q184ws17g4u9"}, {"q": "The staff side in Board-level PNM is represented by:", "options": {"A": "Retired officers", "B": "Contract workers", "C": "Elected MPs", "D": "Office bearers of AIRF and NFIR"}, "answer": "D", "i": "q27b65pm27wl"}, {"q": "The official side in Board-level PNM is led by:", "options": {"A": "State officials", "B": "Railway Board representatives", "C": "Federation leaders", "D": "Labour courts"}, "answer": "B", "i": "q1qc2yaaly6k"}, {"q": "PNM is best described as a machinery for:", "options": {"A": "Disciplinary action", "B": "Compulsory arbitration", "C": "Collective bargaining through negotiation", "D": "Judicial trial"}, "answer": "C", "i": "q13jt2b62kx3"}, {"q": "If a PNM item concerns only one zone, it is normally discussed at:", "options": {"A": "Labour court", "B": "Board level", "C": "Zonal level", "D": "Parliament"}, "answer": "C", "i": "q1ua7gp582g7"}, {"q": "Agreements reached under PNM are:", "options": {"A": "Sent to courts", "B": "Valid for one day", "C": "Advisory only", "D": "Implemented by the administration as agreed"}, "answer": "D", "i": "qxs5y5jxw99"}, {"q": "The PNM forum helps in maintaining:", "options": {"A": "Ticket checking", "B": "Catering contracts", "C": "Train punctuality directly", "D": "Industrial peace and harmonious relations"}, "answer": "D", "i": "q117nz4yoxja"}, {"q": "Which federation is the older of the two recognised federations?", "options": {"A": "Both formed together", "B": "Neither is recognised", "C": "NFIR", "D": "AIRF"}, "answer": "D", "i": "q2aun4d3oi9u"}, {"q": "PNM discussions at divisional level are chaired by:", "options": {"A": "The Railway Minister", "B": "The union president", "C": "The DRM", "D": "The GM"}, "answer": "C", "i": "q1c8z4hbvbwj"}, {"q": "Zonal-level PNM meetings are chaired by:", "options": {"A": "The Chief Minister", "B": "The DRM", "C": "The General Manager", "D": "The Board Chairman"}, "answer": "C", "i": "q1x622yz2lhb"}, {"q": "A PNM item that remains unresolved at divisional level may be:", "options": {"A": "Decided by the DRM alone", "B": "Dropped forever", "C": "Raised at the zonal level", "D": "Taken to the press"}, "answer": "C", "i": "q20c183wphk0"}, {"q": "The PNM machinery is an example of:", "options": {"A": "Unilateral decision-making", "B": "Workers' participation in management", "C": "Bipartite negotiating machinery", "D": "Tripartite adjudication"}, "answer": "C", "i": "q17g87etfgx4"}, {"q": "Which of these is a recognised federation for Board-level PNM?", "options": {"A": "A local staff club", "B": "A contractors' association", "C": "A passengers' association", "D": "AIRF"}, "answer": "D", "i": "qpf02xuok9h"}, {"q": "PNM agenda items generally relate to:", "options": {"A": "Land licensing", "B": "Train operations", "C": "Conditions of service and welfare of staff", "D": "Fare fixation"}, "answer": "C", "i": "q1mdlhapthyq"}, {"q": "Implementation of PNM decisions is monitored through:", "options": {"A": "Surprise raids", "B": "Follow-up action on minutes", "C": "Newspaper reports", "D": "Court orders"}, "answer": "B", "i": "qc4rr1kcnlz"}, {"q": "The spirit of PNM is best captured by:", "options": {"A": "Work stoppage", "B": "Confrontation", "C": "Dialogue and negotiated settlement", "D": "Litigation"}, "answer": "C", "i": "qzusfg0a4qw"}, {"q": "PNM items having all-India implications are taken up at the:", "options": {"A": "Divisional", "B": "Railway Board", "C": "Depot", "D": "Station"}, "answer": "B", "i": "q1rgzozczzkh"}, {"q": "Participation in PNM is restricted to:", "options": {"A": "NGOs", "B": "All registered unions", "C": "Only recognised federations and unions", "D": "Political parties"}, "answer": "C", "i": "q1e4zi9on134"}, {"q": "PNM may legitimately discuss:", "options": {"A": "Staff welfare matters including housing and medical facilities", "B": "Only officer matters", "C": "Train scheduling", "D": "Only salaries"}, "answer": "A", "i": "q2c2fkwtrmv5"}, {"q": "The headquarters of AIRF is located at:", "options": {"A": "New Delhi", "B": "Kolkata", "C": "Chennai", "D": "Mumbai"}, "answer": "A", "i": "qtel2s71fwz"}, {"q": "The headquarters of NFIR is located at:", "options": {"A": "Lucknow", "B": "New Delhi", "C": "Secunderabad", "D": "Patna"}, "answer": "B", "i": "q1bwp35gki4e"}, {"q": "The function of PNM is to:", "options": {"A": "Impose penalties", "B": "Consult and negotiate on staff matters", "C": "Run trains", "D": "Collect fares"}, "answer": "B", "i": "qs7w1c2yc0b"}, {"q": "Which item would be ruled out of PNM discussion?", "options": {"A": "Fresh policy issues", "B": "Matters already decided by a court or tribunal", "C": "Welfare demands", "D": "Safety concerns"}, "answer": "B", "i": "q23i3og00x02"}, {"q": "PNM applies to:", "options": {"A": "State police", "B": "Bank employees", "C": "All central government offices", "D": "Railway employees"}, "answer": "D", "i": "qbq6wekbpzq"}, {"q": "Responsibility for honouring PNM agreements rests with:", "options": {"A": "Both sides through recorded minutes", "B": "Only the staff side", "C": "Only the official side", "D": "The media"}, "answer": "A", "i": "q16lkj6mpo2e"}, {"q": "Zonal PNM typically deals with:", "options": {"A": "Zone-level service matters", "B": "Electoral rolls", "C": "Census work", "D": "Fixing train timings"}, "answer": "A", "i": "q2ddojpvfhxr"}, {"q": "Divisional PNM typically deals with:", "options": {"A": "Parliamentary questions", "B": "Court cases", "C": "Division-level staff issues", "D": "National budgets"}, "answer": "C", "i": "q11zyveicp6s"}, {"q": "The tier immediately above divisional PNM is:", "options": {"A": "The zonal tier", "B": "The Supreme Court", "C": "The Railway Minister directly", "D": "The Board tier"}, "answer": "A", "i": "q1ib3kl5g47v"}, {"q": "PNM items must be of a nature:", "options": {"A": "Political", "B": "Personal", "C": "Collective", "D": "Commercial"}, "answer": "C", "i": "q2c7ivyfw81k"}, {"q": "PNM works best when both sides engage in:", "options": {"A": "Good faith negotiation", "B": "Media pressure", "C": "Court stay", "D": "Strike threats"}, "answer": "A", "i": "q6xyxwgcpie"}, {"q": "PNM is intended to:", "options": {"A": "Complements statutory procedures", "B": "Overrides court orders", "C": "Cancels agreements", "D": "Replaces all rules"}, "answer": "A", "i": "q7e57gtvhe2"}, {"q": "Which of these can be a valid PNM subject?", "options": {"A": "Safety-related working conditions", "B": "Cricket matches", "C": "Film shooting", "D": "Fare tables"}, "answer": "A", "i": "q6pb28g5t4e"}, {"q": "Minutes of PNM meetings are:", "options": {"A": "Kept secret from staff side", "B": "Circulated to both sides", "C": "Destroyed immediately", "D": "Published in newspapers"}, "answer": "B", "i": "qkb1qr19aut"}, {"q": "In Indian labour history, railway PNM is regarded as:", "options": {"A": "A trade fair", "B": "A court", "C": "A pioneering bipartite model", "D": "A private company"}, "answer": "C", "i": "q2cguhrqrbvb"}, {"q": "PNM items must concern:", "options": {"A": "Any subject under the sun", "B": "Subjects within railway competence", "C": "Foreign policy", "D": "Defence matters"}, "answer": "B", "i": "q1xkeiq4nm9v"}, {"q": "The word 'Permanent' in PNM signifies:", "options": {"A": "One-time settlement", "B": "Continuous dialogue across tiers", "C": "Annual strike", "D": "Court battles"}, "answer": "B", "i": "q262ikc4m9c5"}, {"q": "AIRF is broadly aligned with which central trade union tradition?", "options": {"A": "INTUC", "B": "Hind Mazdoor Sabha tradition", "C": "A political party", "D": "A bank union"}, "answer": "B", "i": "qnoq4nhxdwb"}, {"q": "NFIR is broadly aligned with which central trade union tradition?", "options": {"A": "A sports body", "B": "A religious trust", "C": "HMS", "D": "INTUC tradition"}, "answer": "D", "i": "q121qima1w7z"}, {"q": "The official side at Board-level PNM is headed by:", "options": {"A": "Retired judges", "B": "MPs", "C": "Union leaders", "D": "Senior Railway Board officers"}, "answer": "D", "i": "qimkn2w8s5t"}, {"q": "PNM is a forum for:", "options": {"A": "Individual transfers", "B": "Collective staff interests", "C": "Train delays", "D": "Ticketless travel"}, "answer": "B", "i": "qt5pfs0n0w6"}, {"q": "A basic rule of PNM meetings is to:", "options": {"A": "Invite the press", "B": "Vote on resolutions", "C": "Discuss anything spontaneously", "D": "Stick to circulated agenda"}, "answer": "D", "i": "qyg49fkkxnl"}, {"q": "An effective PNM machinery:", "options": {"A": "Reduces industrial unrest", "B": "Fixes promotions", "C": "Runs hospitals", "D": "Increases strikes"}, "answer": "A", "i": "q17q4d01s2ul"}, {"q": "Before a PNM meeting, the agenda items are:", "options": {"A": "Ignored", "B": "Examined by administration beforehand", "C": "Sent to police", "D": "Published online"}, "answer": "B", "i": "q9mg80ehrub"}, {"q": "The beneficiaries of PNM settlements are:", "options": {"A": "Railway servants", "B": "Contractors", "C": "Vendors", "D": "Passengers"}, "answer": "A", "i": "qbldurfz53l"}, {"q": "PNM's success influenced the creation of later forums such as:", "options": {"A": "Cricket boards", "B": "Film censor boards", "C": "Exam boards", "D": "JCM and PREM"}, "answer": "D", "i": "q10a2bczh0vm"}, {"q": "The principal negotiating machinery for railway labour is:", "options": {"A": "PNM", "B": "Lok Adalat", "C": "Consumer forum", "D": "Press council"}, "answer": "A", "i": "q1xmv7ctrnnn"}]