[{"q":"PNM on Indian Railways stands for:","options":{"A":"Personnel Norms Manual","B":"Productivity Negotiation Mission","C":"Permanent Negotiating Machinery","D":"Public Negotiation Mechanism"},"answer":"C"},{"q":"The Permanent Negotiating Machinery was set up on Indian Railways in:","options":{"A":"1966","B":"1977","C":"1947","D":"1951"},"answer":"D"},{"q":"How many tiers does the Permanent Negotiating Machinery have?","options":{"A":"Two","B":"Three","C":"Four","D":"Five"},"answer":"B"},{"q":"At the Railway Board level, PNM negotiations are held with:","options":{"A":"Individual employees","B":"AIRF and NFIR","C":"State governments","D":"Contractors"},"answer":"B"},{"q":"AIRF stands for:","options":{"A":"All India Roadways Federation","B":"Associated Indian Railway Forum","C":"All India Retiredmen's Federation","D":"All India Railwaymen's Federation"},"answer":"D"},{"q":"NFIR stands for:","options":{"A":"New Federation of Indian Railmen","B":"National Federation of Indian Railwaymen","C":"Northern Federation of Indian Railways","D":"National Forum of Indian Railways"},"answer":"B"},{"q":"At the zonal level, PNM meetings are held between the General Manager and:","options":{"A":"Retired employees","B":"Recognised unions of the zone","C":"Members of Parliament","D":"Divisional officers"},"answer":"B"},{"q":"At the divisional level, PNM meetings are held between the DRM and:","options":{"A":"State labour department","B":"Station masters only","C":"Recognised unions of the division","D":"Railway Board officials"},"answer":"C"},{"q":"The main objective of PNM is to:","options":{"A":"Negotiate staff matters and prevent disputes","B":"Award tenders","C":"Inspect stations","D":"Fix train fares"},"answer":"A"},{"q":"Which of the following is generally NOT taken up in PNM meetings?","options":{"A":"Individual employee grievance cases","B":"Policy matters affecting staff","C":"Staff welfare measures","D":"Service condition issues"},"answer":"A"},{"q":"Subjects for PNM discussion are normally submitted in the form of:","options":{"A":"Agenda items in advance","B":"Court petitions","C":"Press releases","D":"Verbal complaints"},"answer":"A"},{"q":"Decisions reached in PNM meetings are recorded in:","options":{"A":"Notice boards","B":"Press notes","C":"Minutes of the meeting","D":"Personal diaries"},"answer":"C"},{"q":"PNM meetings are held:","options":{"A":"Periodically at each tier","B":"Once in ten years","C":"Only at Board level","D":"Only during strikes"},"answer":"A"},{"q":"The PNM machinery covers:","options":{"A":"All railway servants including Group C and D","B":"Only ministerial staff","C":"Only running staff","D":"Only officers"},"answer":"A"},{"q":"Which matters are excluded from PNM purview?","options":{"A":"Duty rosters","B":"Welfare schemes","C":"Matters under adjudication or individual cases","D":"Canteen facilities"},"answer":"C"},{"q":"The staff side in Board-level PNM is represented by:","options":{"A":"Retired officers","B":"Contract workers","C":"Elected MPs","D":"Office bearers of AIRF and NFIR"},"answer":"D"},{"q":"The official side in Board-level PNM is led by:","options":{"A":"State officials","B":"Railway Board representatives","C":"Federation leaders","D":"Labour courts"},"answer":"B"},{"q":"PNM is best described as a machinery for:","options":{"A":"Disciplinary action","B":"Compulsory arbitration","C":"Collective bargaining through negotiation","D":"Judicial trial"},"answer":"C"},{"q":"If a PNM item concerns only one zone, it is normally discussed at:","options":{"A":"Labour court","B":"Board level","C":"Zonal level","D":"Parliament"},"answer":"C"},{"q":"Agreements reached under PNM are:","options":{"A":"Sent to courts","B":"Valid for one day","C":"Advisory only","D":"Implemented by the administration as agreed"},"answer":"D"},{"q":"The PNM forum helps in maintaining:","options":{"A":"Ticket checking","B":"Catering contracts","C":"Train punctuality directly","D":"Industrial peace and harmonious relations"},"answer":"D"},{"q":"Which federation is the older of the two recognised federations?","options":{"A":"Both formed together","B":"Neither is recognised","C":"NFIR","D":"AIRF"},"answer":"D"},{"q":"PNM discussions at divisional level are chaired by:","options":{"A":"The Railway Minister","B":"The union president","C":"The DRM","D":"The GM"},"answer":"C"},{"q":"Zonal-level PNM meetings are chaired by:","options":{"A":"The Chief Minister","B":"The DRM","C":"The General Manager","D":"The Board Chairman"},"answer":"C"},{"q":"A PNM item that remains unresolved at divisional level may be:","options":{"A":"Decided by the DRM alone","B":"Dropped forever","C":"Raised at the zonal level","D":"Taken to the press"},"answer":"C"},{"q":"The PNM machinery is an example of:","options":{"A":"Unilateral decision-making","B":"Workers' participation in management","C":"Bipartite negotiating machinery","D":"Tripartite adjudication"},"answer":"C"},{"q":"Which of these is a recognised federation for Board-level PNM?","options":{"A":"A local staff club","B":"A contractors' association","C":"A passengers' association","D":"AIRF"},"answer":"D"},{"q":"PNM agenda items generally relate to:","options":{"A":"Land licensing","B":"Train operations","C":"Conditions of service and welfare of staff","D":"Fare fixation"},"answer":"C"},{"q":"Implementation of PNM decisions is monitored through:","options":{"A":"Surprise raids","B":"Follow-up action on minutes","C":"Newspaper reports","D":"Court orders"},"answer":"B"},{"q":"The spirit of PNM is best captured by:","options":{"A":"Work stoppage","B":"Confrontation","C":"Dialogue and negotiated settlement","D":"Litigation"},"answer":"C"},{"q":"PNM items having all-India implications are taken up at the:","options":{"A":"Divisional","B":"Railway Board","C":"Depot","D":"Station"},"answer":"B"},{"q":"Participation in PNM is restricted to:","options":{"A":"NGOs","B":"All registered unions","C":"Only recognised federations and unions","D":"Political parties"},"answer":"C"},{"q":"PNM may legitimately discuss:","options":{"A":"Staff welfare matters including housing and medical facilities","B":"Only officer matters","C":"Train scheduling","D":"Only salaries"},"answer":"A"},{"q":"The headquarters of AIRF is located at:","options":{"A":"New Delhi","B":"Kolkata","C":"Chennai","D":"Mumbai"},"answer":"A"},{"q":"The headquarters of NFIR is located at:","options":{"A":"Lucknow","B":"New Delhi","C":"Secunderabad","D":"Patna"},"answer":"B"},{"q":"The function of PNM is to:","options":{"A":"Impose penalties","B":"Consult and negotiate on staff matters","C":"Run trains","D":"Collect fares"},"answer":"B"},{"q":"Which item would be ruled out of PNM discussion?","options":{"A":"Fresh policy issues","B":"Matters already decided by a court or tribunal","C":"Welfare demands","D":"Safety concerns"},"answer":"B"},{"q":"PNM applies to:","options":{"A":"State police","B":"Bank employees","C":"All central government offices","D":"Railway employees"},"answer":"D"},{"q":"Responsibility for honouring PNM agreements rests with:","options":{"A":"Both sides through recorded minutes","B":"Only the staff side","C":"Only the official side","D":"The media"},"answer":"A"},{"q":"Zonal PNM typically deals with:","options":{"A":"Zone-level service matters","B":"Electoral rolls","C":"Census work","D":"Fixing train timings"},"answer":"A"},{"q":"Divisional PNM typically deals with:","options":{"A":"Parliamentary questions","B":"Court cases","C":"Division-level staff issues","D":"National budgets"},"answer":"C"},{"q":"The tier immediately above divisional PNM is:","options":{"A":"The zonal tier","B":"The Supreme Court","C":"The Railway Minister directly","D":"The Board tier"},"answer":"A"},{"q":"PNM items must be of a nature:","options":{"A":"Political","B":"Personal","C":"Collective","D":"Commercial"},"answer":"C"},{"q":"PNM works best when both sides engage in:","options":{"A":"Good faith negotiation","B":"Media pressure","C":"Court stay","D":"Strike threats"},"answer":"A"},{"q":"PNM is intended to:","options":{"A":"Complements statutory procedures","B":"Overrides court orders","C":"Cancels agreements","D":"Replaces all rules"},"answer":"A"},{"q":"Which of these can be a valid PNM subject?","options":{"A":"Safety-related working conditions","B":"Cricket matches","C":"Film shooting","D":"Fare tables"},"answer":"A"},{"q":"Minutes of PNM meetings are:","options":{"A":"Kept secret from staff side","B":"Circulated to both sides","C":"Destroyed immediately","D":"Published in newspapers"},"answer":"B"},{"q":"In Indian labour history, railway PNM is regarded as:","options":{"A":"A trade fair","B":"A court","C":"A pioneering bipartite model","D":"A private company"},"answer":"C"},{"q":"PNM items must concern:","options":{"A":"Any subject under the sun","B":"Subjects within railway competence","C":"Foreign policy","D":"Defence matters"},"answer":"B"},{"q":"The word 'Permanent' in PNM signifies:","options":{"A":"One-time settlement","B":"Continuous dialogue across tiers","C":"Annual strike","D":"Court battles"},"answer":"B"},{"q":"AIRF is broadly aligned with which central trade union tradition?","options":{"A":"INTUC","B":"Hind Mazdoor Sabha tradition","C":"A political party","D":"A bank union"},"answer":"B"},{"q":"NFIR is broadly aligned with which central trade union tradition?","options":{"A":"A sports body","B":"A religious trust","C":"HMS","D":"INTUC tradition"},"answer":"D"},{"q":"The official side at Board-level PNM is headed by:","options":{"A":"Retired judges","B":"MPs","C":"Union leaders","D":"Senior Railway Board officers"},"answer":"D"},{"q":"PNM is a forum for:","options":{"A":"Individual transfers","B":"Collective staff interests","C":"Train delays","D":"Ticketless travel"},"answer":"B"},{"q":"A basic rule of PNM meetings is to:","options":{"A":"Invite the press","B":"Vote on resolutions","C":"Discuss anything spontaneously","D":"Stick to circulated agenda"},"answer":"D"},{"q":"An effective PNM machinery:","options":{"A":"Reduces industrial unrest","B":"Fixes promotions","C":"Runs hospitals","D":"Increases strikes"},"answer":"A"},{"q":"Before a PNM meeting, the agenda items are:","options":{"A":"Ignored","B":"Examined by administration beforehand","C":"Sent to police","D":"Published online"},"answer":"B"},{"q":"The beneficiaries of PNM settlements are:","options":{"A":"Railway servants","B":"Contractors","C":"Vendors","D":"Passengers"},"answer":"A"},{"q":"PNM's success influenced the creation of later forums such as:","options":{"A":"Cricket boards","B":"Film censor boards","C":"Exam boards","D":"JCM and PREM"},"answer":"D"},{"q":"The principal negotiating machinery for railway labour is:","options":{"A":"PNM","B":"Lok Adalat","C":"Consumer forum","D":"Press council"},"answer":"A"}]